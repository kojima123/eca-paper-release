+"""ECA exploration advice for Tufa-style tool agents.
+
+This module is intentionally small and side-effect free. It does not execute
+environment actions and it does not depend on the ECA runtime object graph.
+The intended integration point is a Tufa/ToolAgent runtime state payload:
+compute this advice from ``current_frame.grid`` and expose the resulting JSON
+to the model as an exploration-prior, while leaving Tufa's solver and LLM in
+control of the actual action call.
+"""
+from __future__ import annotations
+
+from collections import Counter, deque
+from dataclasses import dataclass, field
+import hashlib
+import math
+from typing import Any, Iterable, Mapping, Sequence
+
+import numpy as np
+
+
+SCHEMA_VERSION = "arcgym.tufa_eca_exploration_advisor.v1"
+_UI_SENTINEL = -104729
+_ACTION_ALIASES = {
+    "ACTION1": "UP",
+    "UP": "UP",
+    "U": "UP",
+    "ACTION2": "DOWN",
+    "DOWN": "DOWN",
+    "D": "DOWN",
+    "ACTION3": "LEFT",
+    "LEFT": "LEFT",
+    "L": "LEFT",
+    "ACTION4": "RIGHT",
+    "RIGHT": "RIGHT",
+    "R": "RIGHT",
+    "ACTION5": "SPACE",
+    "SPACE": "SPACE",
+    "SPACEBAR": "SPACE",
+    "PRESS": "SPACE",
+    "ACTION6": "MOUSE",
+    "MOUSE": "MOUSE",
+    "CLICK": "MOUSE",
+    "ACTION7": "ESCAPE",
+    "ESC": "ESCAPE",
+    "ESCAPE": "ESCAPE",
+    "RESET": "RESET",
+}
+
+
+@dataclass(frozen=True)
+class ComponentCandidate:
+    """One visible component that is worth considering as a click target."""
+
+    component_id: str
+    color: int
+    size: int
+    row: int
+    col: int
+    bbox: dict[str, int]
+    score: float
+    reason: str
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "component_id": self.component_id,
+            "color": int(self.color),
+            "size": int(self.size),
+            "row": int(self.row),
+            "col": int(self.col),
+            "bbox": dict(self.bbox),
+            "score": round(float(self.score), 6),
+            "reason": self.reason,
+        }
+
+
+@dataclass
+class TufaEcaExplorationAdvisor:
+    """Stateful helper for a Tufa run.
+
+    Tufa can keep one instance per game. ``analyze`` returns current-frame
+    advice; ``observe_transition`` updates the known-state set and produces a
+    novel-state effect score for the most recent action.
+    """
+
+    known_state_hashes: set[str] = field(default_factory=set)
+    death_action_keys: set[str] = field(default_factory=set)
+    no_effect_action_keys: set[str] = field(default_factory=set)
+
+    def analyze(
+        self,
+        frame: Any,
+        *,
+        history: Iterable[Any] | None = None,
+        valid_actions: Iterable[Any] | None = None,
+        previous_frame: Any | None = None,
+        max_clicks: int = 12,
+    ) -> dict[str, Any]:
+        advice = analyze_frame(
+            frame,
+            history=history,
+            valid_actions=valid_actions,
+            previous_frame=previous_frame,
+            known_state_hashes=self.known_state_hashes,
+            max_clicks=max_clicks,
+        )
+        state_hash = str(advice.get("state_hash", "") or "")
+        if state_hash:
+            self.known_state_hashes.add(state_hash)
+        return advice
+
+    def observe_transition(
+        self,
+        *,
+        action: Any,
+        before_frame: Any,
+        after_frame: Any,
+        terminal_reason: str | None = None,
+    ) -> dict[str, Any]:
+        result = score_transition_effect(
+            before_frame,
+            after_frame,
+            known_state_hashes=self.known_state_hashes,
+            terminal_reason=terminal_reason,
+        )
+        after_hash = str(result.get("after_hash", "") or "")
+        if after_hash:
+            self.known_state_hashes.add(after_hash)
+        action_key = _action_key(action)
+        if action_key:
+            if result.get("death"):
+                self.death_action_keys.add(action_key)
+            elif not result.get("state_changed") and not result.get("novel_state"):
+                self.no_effect_action_keys.add(action_key)
+        result["action_key"] = action_key
+        return result
+
+
+def analyze_frame(
+    frame: Any,
+    *,
+    history: Iterable[Any] | None = None,
+    valid_actions: Iterable[Any] | None = None,
+    previous_frame: Any | None = None,
+    known_state_hashes: Iterable[str] | None = None,
+    max_clicks: int = 12,
+) -> dict[str, Any]:
+    """Return JSON-friendly ECA exploration advice for a visible frame.
+
+    The advice is deliberately descriptive: Tufa should still choose whether
+    and when to call ``action(...)``.
+    """
+
+    grid = _as_label_grid(frame)
+    if grid.size <= 0 or grid.ndim != 2:
+        return _empty_advice()
+
+    height, width = (int(grid.shape[0]), int(grid.shape[1]))
+    background = _background_value(grid)
+    ui_mask = _ui_status_mask(grid, background=background)
+    click_mask = _click_reserved_mask(grid, ui_mask=ui_mask)
+    masked_hash = masked_state_hash(grid, ui_mask=ui_mask)
+
+    history_hashes = _history_hashes(history)
+    if known_state_hashes is not None:
+        history_hashes.update(str(value) for value in known_state_hashes if str(value))
+    is_novel_state = masked_hash not in history_hashes
+
+    previous = previous_frame
+    if previous is None:
+        previous = _previous_frame_from_history(history)
+    previous_hash = ""
+    changed_cell_count = 0
+    changed_cell_ratio = 0.0
+    if previous is not None:
+        previous_grid = _as_label_grid(previous)
+        if previous_grid.size > 0 and previous_grid.ndim == 2:
+            previous_hash = masked_state_hash(previous_grid)
+            changed_cell_count, changed_cell_ratio = _changed_cells(previous_grid, grid)
+
+    valid = normalize_valid_actions(valid_actions)
+    if not valid:
+        valid = ["UP", "DOWN", "LEFT", "RIGHT", "SPACE", "MOUSE"]
+
+    components = extract_component_candidates(
+        grid,
+        background=background,
+        click_mask=click_mask,
+        max_candidates=max(4, int(max_clicks) * 2),
+    )
+    suggestions = _build_action_suggestions(
+        components,
+        valid_actions=valid,
+        max_clicks=max_clicks,
+    )
+
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "state_hash": masked_hash,
+        "previous_state_hash": previous_hash,
+        "is_novel_state": bool(is_novel_state),
+        "known_state_count": len(history_hashes),
+        "height": height,
+        "width": width,
+        "background": int(background),
+        "ui_masked_cell_count": int(ui_mask.sum()),
+        "click_reserved_cell_count": int(click_mask.sum()),
+        "changed_cell_count": int(changed_cell_count),
+        "changed_cell_ratio": round(float(changed_cell_ratio), 6),
+        "valid_actions": valid,
+        "component_count": len(components),
+        "component_candidates": [component.to_dict() for component in components],
+        "suggested_actions": suggestions,
+        "integration_contract": {
+            "executes_actions": False,
+            "payload_style": "tufa_tool_action",
+            "mouse_payload": {"action": "MOUSE", "row": "int", "col": "int"},
+        },
+    }
+
+
+def score_transition_effect(
+    before_frame: Any,
+    after_frame: Any,
+    *,
+    known_state_hashes: Iterable[str] | None = None,
+    terminal_reason: str | None = None,
+) -> dict[str, Any]:
+    """Score an action by novel-state arrival rather than raw pixel change."""
+
+    before = _as_label_grid(before_frame)
+    after = _as_label_grid(after_frame)
+    before_hash = masked_state_hash(before) if before.size else ""
+    after_hash = masked_state_hash(after) if after.size else ""
+    known = {str(value) for value in known_state_hashes or [] if str(value)}
+    terminal = str(terminal_reason or "").strip().lower()
+    death = terminal in {"game_over", "death", "dead", "terminal_game_over"}
+    changed_count, changed_ratio = _changed_cells(before, after)
+    state_changed = before_hash != after_hash
+    novel_state = bool(after_hash and after_hash not in known and after_hash != before_hash)
+
+    if death:
+        effect_score = -1.0
+        reason = "death_attribution"
+    elif novel_state:
+        effect_score = 1.0 + min(0.35, math.log1p(max(0, changed_count)) / 20.0)
+        reason = "novel_state_reached"
+    elif state_changed:
+        effect_score = 0.25 + min(0.15, changed_ratio)
+        reason = "known_state_changed"
+    else:
+        effect_score = -0.2
+        reason = "no_visible_effect_after_ui_mask"
+
+    return {
+        "schema_version": SCHEMA_VERSION,
+        "before_hash": before_hash,
+        "after_hash": after_hash,
+        "state_changed": bool(state_changed),
+        "novel_state": bool(novel_state),
+        "death": bool(death),
+        "changed_cell_count": int(changed_count),
+        "changed_cell_ratio": round(float(changed_ratio), 6),
+        "effect_score": round(float(effect_score), 6),
+        "reason": reason,
+    }
+
+
+def masked_state_hash(frame: Any, *, ui_mask: np.ndarray | None = None) -> str:
+    """Hash the visible state after masking likely HUD/status cells."""
+
+    grid = _as_label_grid(frame)
+    if grid.size <= 0 or grid.ndim != 2:
+        return ""
+    if ui_mask is None:
+        ui_mask = _ui_status_mask(grid, background=_background_value(grid))
+    masked = np.array(grid, dtype=np.int64, copy=True)
+    if ui_mask.shape == masked.shape:
+        masked[ui_mask] = _UI_SENTINEL
+    contiguous = np.ascontiguousarray(masked)
+    hasher = hashlib.sha1()
+    hasher.update(str(tuple(contiguous.shape)).encode("ascii"))
+    hasher.update(contiguous.tobytes())
+    return hasher.hexdigest()
+
+
+def extract_component_candidates(
+    frame: Any,
+    *,
+    background: int | None = None,
+    click_mask: np.ndarray | None = None,
+    max_candidates: int = 24,
+) -> list[ComponentCandidate]:
+    """Rank connected components as concrete click candidates."""
+
+    grid = _as_label_grid(frame)
+    if grid.size <= 0 or grid.ndim != 2:
+        return []
+    height, width = grid.shape[:2]
+    bg = _background_value(grid) if background is None else int(background)
+    if click_mask is None or click_mask.shape != grid.shape:
+        click_mask = _click_reserved_mask(grid, ui_mask=_ui_status_mask(grid, background=bg))
+    usable = ~click_mask
+    total_usable = max(1, int(usable.sum()))
+    counts = Counter(int(value) for value in grid[usable].flatten().tolist())
+
+    candidates: list[ComponentCandidate] = []
+    for value, color_count in sorted(counts.items(), key=lambda item: (item[1], item[0])):
+        if int(value) == bg:
+            continue
+        mask = (grid == int(value)) & usable
+        for component in _components(mask, limit=16):
+            if not component:
+                continue
+            size = len(component)
+            if size > max(12, int(total_usable * 0.20)):
+                continue
+            rows = [point[0] for point in component]
+            cols = [point[1] for point in component]
+            row_min, row_max = min(rows), max(rows)
+            col_min, col_max = min(cols), max(cols)
+            bbox_h = row_max - row_min + 1
+            bbox_w = col_max - col_min + 1
+            if bbox_h <= 1 and bbox_w <= 1 and total_usable > 128:
+                # Single pixels are often noise; keep them only on tiny boards.
+                continue
+            center_row = int(round(sum(rows) / float(size)))
+            center_col = int(round(sum(cols) / float(size)))
+            rarity = 1.0 - min(1.0, float(color_count) / float(total_usable))
+            target_size = 1.0 - min(1.0, abs(math.log2(max(1, size)) - 4.0) / 6.0)
+            fill_ratio = float(size) / float(max(1, bbox_h * bbox_w))
+            center_bias = 1.0 - (
+                abs(center_row - (height - 1) / 2.0) / max(1.0, height)
+                + abs(center_col - (width - 1) / 2.0) / max(1.0, width)
+            )
+            score = (
+                0.42 * rarity
+                + 0.24 * target_size
+                + 0.20 * fill_ratio
+                + 0.14 * max(0.0, center_bias)
+            )
+            reason = "rare_compact_component"
+            if fill_ratio >= 0.80 and size >= 4:
+                reason = "rare_rectangular_component"
+                score += 0.05
+            component_id = f"c{int(value)}_r{row_min}-{row_max}_c{col_min}-{col_max}_n{size}"
+            candidates.append(
+                ComponentCandidate(
+                    component_id=component_id,
+                    color=int(value),
+                    size=int(size),
+                    row=center_row,
+                    col=center_col,
+                    bbox={
+                        "row_min": int(row_min),
+                        "row_max": int(row_max),
+                        "col_min": int(col_min),
+                        "col_max": int(col_max),
+                    },
+                    score=float(score),
+                    reason=reason,
+                )
+            )
+
+    candidates.sort(key=lambda item: (-item.score, item.size, item.row, item.col, item.component_id))
+    return candidates[: max(1, int(max_candidates))]
+
+
+def normalize_valid_actions(valid_actions: Iterable[Any] | None) -> list[str]:
+    """Normalize ARC/Tufa action spellings into Tufa model action names."""
+
+    names: list[str] = []
+    for raw in valid_actions or []:
+        if raw is None:
+            continue
+        candidates: list[Any] = [raw]
+        name_attr = getattr(raw, "name", None)
+        value_attr = getattr(raw, "value", None)
+        if name_attr is not None:
+            candidates.append(name_attr)
+        if value_attr is not None:
+            candidates.append(value_attr)
+        for candidate in candidates:
+            normalized = _normalize_action_name(candidate)
+            if normalized and normalized not in names:
+                names.append(normalized)
+                break
+    return names
+
+
+def render_prompt_snippet(advice: Mapping[str, Any], *, max_actions: int = 8) -> str:
+    """Render compact text suitable for a Tufa system/user prompt addendum."""
+
+    if not advice:
+        return "ECA advice: unavailable"
+    state_hash = str(advice.get("state_hash", "") or "")[:10]
+    changed = advice.get("changed_cell_count", 0)
+    novel = bool(advice.get("is_novel_state", False))
+    parts = [
+        f"ECA masked_state={state_hash}",
+        f"novel={str(novel).lower()}",
+        f"changed_cells={changed}",
+    ]
+    actions = []
+    for item in list(advice.get("suggested_actions", []) or [])[: max(0, int(max_actions))]:
+        if not isinstance(item, Mapping):
+            continue
+        action = str(item.get("action", "") or "")
+        if action == "MOUSE":
+            actions.append(
+                f"MOUSE(row={int(item.get('row', 0) or 0)}, col={int(item.get('col', 0) or 0)}, score={item.get('score', 0)})"
+            )
+        elif action:
+            actions.append(f"{action}(score={item.get('score', 0)})")
+    if actions:
+        parts.append("suggested=" + "; ".join(actions))
+    return " | ".join(parts)
+
+
+def _build_action_suggestions(
+    components: Sequence[ComponentCandidate],
+    *,
+    valid_actions: Sequence[str],
+    max_clicks: int,
+) -> list[dict[str, Any]]:
+    suggestions: list[dict[str, Any]] = []
+    valid = set(valid_actions)
+    if "MOUSE" in valid:
+        for component in components[: max(0, int(max_clicks))]:
+            suggestions.append(
+                {
+                    "action": "MOUSE",
+                    "row": int(component.row),
+                    "col": int(component.col),
+                    "score": round(float(component.score), 6),
+                    "reason": component.reason,
+                    "component_id": component.component_id,
+                    "component_size": int(component.size),
+                    "color": int(component.color),
+                    "safe_to_autorun": False,
+                }
+            )
+    for action in ("SPACE", "UP", "DOWN", "LEFT", "RIGHT"):
+        if action in valid:
+            suggestions.append(
+                {
+                    "action": action,
+                    "score": 0.18 if action == "SPACE" else 0.12,
+                    "reason": "low_cost_directional_probe",
+                    "safe_to_autorun": False,
+                }
+            )
+    return suggestions
+
+
+def _as_label_grid(frame: Any) -> np.ndarray:
+    raw = _unwrap_frame_grid(frame)
+    if raw is None:
+        return np.zeros((0, 0), dtype=np.int64)
+    try:
+        arr = np.asarray(raw)
+    except ValueError:
+        arr = np.asarray(_rectangular_rows(raw), dtype=np.int64)
+    if arr.size <= 0:
+        return np.zeros((0, 0), dtype=np.int64)
+    if arr.dtype == object:
+        rows = _rectangular_rows(raw)
+        if rows:
+            arr = np.asarray(rows, dtype=np.int64)
+    if arr.ndim == 1:
+        if arr.dtype == object:
+            rows = _rectangular_rows(raw)
+            return np.asarray(rows, dtype=np.int64) if rows else np.zeros((0, 0), dtype=np.int64)
+        arr = arr.reshape((1, int(arr.shape[0])))
+    if arr.ndim == 2:
+        return arr.astype(np.int64, copy=False)
+    return _label_pixel_grid(arr)
+
+
+def _unwrap_frame_grid(frame: Any) -> Any:
+    if frame is None:
+        return None
+    if isinstance(frame, Mapping):
+        if "grid" in frame:
+            return frame.get("grid")
+        if "board" in frame:
+            return frame.get("board")
+        if "frame" in frame:
+            return _unwrap_frame_grid(frame.get("frame"))
+    grid = getattr(frame, "grid", None)
+    if grid is not None:
+        return grid
+    data = getattr(frame, "data", None)
+    if data is not None:
+        return data
+    return frame
+
+
+def _rectangular_rows(raw: Any) -> list[list[int]]:
+    if not isinstance(raw, (list, tuple)):
+        return []
+    rows: list[list[int]] = []
+    max_width = 0
+    for row in raw:
+        if not isinstance(row, (list, tuple, np.ndarray)):
+            continue
+        cells: list[int] = []
+        for cell in list(row):
+            try:
+                cells.append(int(cell))
+            except (TypeError, ValueError):
+                cells.append(0)
+        max_width = max(max_width, len(cells))
+        rows.append(cells)
+    if not rows or max_width <= 0:
+        return []
+    return [row + [0] * (max_width - len(row)) for row in rows]
+
+
+def _label_pixel_grid(arr: np.ndarray) -> np.ndarray:
+    if arr.ndim < 3:
+        return arr.astype(np.int64, copy=False)
+    height, width = arr.shape[:2]
+    flat = arr.reshape((height * width, int(np.prod(arr.shape[2:]))))
+    labels = np.zeros((height * width,), dtype=np.int64)
+    mapping: dict[tuple[Any, ...], int] = {}
+    next_label = 0
+    for index, row in enumerate(flat.tolist()):
+        key = tuple(row)
+        label = mapping.get(key)
+        if label is None:
+            label = next_label
+            mapping[key] = label
+            next_label += 1
+        labels[index] = label
+    return labels.reshape((height, width))
+
+
+def _background_value(grid: np.ndarray) -> int:
+    if grid.size <= 0:
+        return 0
+    counts = Counter(int(value) for value in grid.flatten().tolist())
+    return int(counts.most_common(1)[0][0]) if counts else 0
+
+
+def _ui_status_mask(grid: np.ndarray, *, background: int) -> np.ndarray:
+    height, width = grid.shape[:2]
+    mask = np.zeros((height, width), dtype=bool)
+    if height <= 0 or width <= 0:
+        return mask
+    row_indices = sorted({0, 1, height - 2, height - 1} & set(range(height)))
+    col_indices = sorted({0, 1, width - 2, width - 1} & set(range(width)))
+    for row in row_indices:
+        if _status_like_line(grid[row, :], background=background):
+            mask[row, :] = True
+    for col in col_indices:
+        if _status_like_line(grid[:, col], background=background):
+            mask[:, col] = True
+    return mask
+
+
+def _status_like_line(line: np.ndarray, *, background: int) -> bool:
+    values = [int(value) for value in np.asarray(line).flatten().tolist()]
+    size = len(values)
+    if size < 4:
+        return False
+    counts = Counter(values)
+    dominant = counts.most_common(1)[0][1] if counts else 0
+    non_bg = size - int(counts.get(int(background), 0))
+    unique = len(counts)
+    if non_bg <= 0:
+        # Empty edge rows/columns often become step counters or level pips
+        # later. Masking them keeps HUD appearance/disappearance from creating
+        # artificial novel states.
+        return True
+    dominant_ratio = float(dominant) / float(max(1, size))
+    sparse_pips = non_bg <= max(4, int(round(size * 0.28)))
+    low_palette_edge = unique <= 5 and dominant_ratio >= 0.45
+    short_run_status = _longest_non_bg_run(values, background=background) <= max(4, int(size * 0.20))
+    return bool((sparse_pips and short_run_status) or low_palette_edge)
+
+
+def _longest_non_bg_run(values: Sequence[int], *, background: int) -> int:
+    best = 0
+    current = 0
+    for value in values:
+        if int(value) == int(background):
+            current = 0
+            continue
+        current += 1
+        best = max(best, current)
+    return best
+
+
+def _click_reserved_mask(grid: np.ndarray, *, ui_mask: np.ndarray) -> np.ndarray:
+    mask = np.array(ui_mask, dtype=bool, copy=True)
+    height, width = grid.shape[:2]
+    if height <= 0 or width <= 0:
+        return mask
+    # Avoid HUD edges and exact borders. The model can still override this
+    # advice if it has direct evidence that an edge object is clickable.
+    mask[0, :] = True
+    mask[height - 1, :] = True
+    mask[:, 0] = True
+    mask[:, width - 1] = True
+    return mask
+
+
+def _components(mask: np.ndarray, *, limit: int) -> list[list[tuple[int, int]]]:
+    height, width = mask.shape[:2]
+    seen = np.zeros((height, width), dtype=bool)
+    out: list[list[tuple[int, int]]] = []
+    for row in range(height):
+        for col in range(width):
+            if seen[row, col] or not bool(mask[row, col]):
+                continue
+            queue: deque[tuple[int, int]] = deque([(row, col)])
+            seen[row, col] = True
+            component: list[tuple[int, int]] = []
+            while queue:
+                current_row, current_col = queue.popleft()
+                component.append((current_row, current_col))
+                for next_row, next_col in (
+                    (current_row - 1, current_col),
+                    (current_row + 1, current_col),
+                    (current_row, current_col - 1),
+                    (current_row, current_col + 1),
+                ):
+                    if next_row < 0 or next_col < 0 or next_row >= height or next_col >= width:
+                        continue
+                    if seen[next_row, next_col] or not bool(mask[next_row, next_col]):
+                        continue
+                    seen[next_row, next_col] = True
+                    queue.append((next_row, next_col))
+            out.append(component)
+            if len(out) >= max(1, int(limit)):
+                return out
+    return out
+
+
+def _history_hashes(history: Iterable[Any] | None) -> set[str]:
+    out: set[str] = set()
+    for entry in history or []:
+        frame = _frame_from_history_entry(entry)
+        if frame is None:
+            continue
+        value = masked_state_hash(frame)
+        if value:
+            out.add(value)
+    return out
+
+
+def _previous_frame_from_history(history: Iterable[Any] | None) -> Any | None:
+    entries = list(history or [])
+    if len(entries) < 2:
+        return None
+    return _frame_from_history_entry(entries[-2])
+
+
+def _frame_from_history_entry(entry: Any) -> Any | None:
+    if entry is None:
+        return None
+    if isinstance(entry, Mapping):
+        return entry.get("frame") or entry.get("after_frame") or entry.get("current_frame")
+    return getattr(entry, "frame", None)
+
+
+def _changed_cells(before: np.ndarray, after: np.ndarray) -> tuple[int, float]:
+    before_grid = _as_label_grid(before)
+    after_grid = _as_label_grid(after)
+    if before_grid.size <= 0 or after_grid.size <= 0 or before_grid.shape != after_grid.shape:
+        return 0, 0.0
+    mask = _ui_status_mask(after_grid, background=_background_value(after_grid))
+    lhs = np.array(before_grid, dtype=np.int64, copy=True)
+    rhs = np.array(after_grid, dtype=np.int64, copy=True)
+    if mask.shape == lhs.shape:
+        lhs[mask] = _UI_SENTINEL
+        rhs[mask] = _UI_SENTINEL
+    changed = int(np.count_nonzero(lhs != rhs))
+    return changed, float(changed) / float(max(1, lhs.size))
+
+
+def _normalize_action_name(value: Any) -> str:
+    if isinstance(value, str):
+        text = value.strip().upper()
+        if not text:
+            return ""
+        return _ACTION_ALIASES.get(text, text)
+    try:
+        number = int(value)
+    except (TypeError, ValueError):
+        return ""
+    return _ACTION_ALIASES.get(f"ACTION{number}", "")
+
+
+def _action_key(action: Any) -> str:
+    if action is None:
+        return ""
+    if isinstance(action, Mapping):
+        name = _normalize_action_name(action.get("action") or action.get("name"))
+        row = action.get("row")
+        col = action.get("col")
+        if name == "MOUSE" and row is not None and col is not None:
+            try:
+                return f"MOUSE:{int(row)}:{int(col)}"
+            except (TypeError, ValueError):
+                return "MOUSE"
+        return name
+    return _normalize_action_name(action)
+
+
+def _empty_advice() -> dict[str, Any]:
+    return {
