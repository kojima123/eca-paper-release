+def _eca_lite_certified_family(
+    solver_result: dict[str, Any] | None,
+    enabled_families: list[str] | None,
+) -> str:
+    """Return the single family left authorized by toolbox arbitration."""
+
+    if not isinstance(solver_result, dict):
+        return ""
+    enabled = set(enabled_families or [])
+    authorized: list[str] = []
+    for plan in solver_result.get("plans", []):
+        if not isinstance(plan, dict):
+            continue
+        family = str(plan.get("family", "") or "")
+        if enabled and family not in enabled:
+            continue
+        if bool(plan.get("authorized", plan.get("certified", False))):
+            authorized.append(family)
+    unique = list(dict.fromkeys(authorized))
+    return unique[0] if len(unique) == 1 else ""
+
+
+def _eca_lite_attach_model_payload(
+    eca_advice: dict[str, Any] | None,
+    solver_plans: dict[str, Any],
+    *,
+    expose: bool,
+) -> tuple[dict[str, Any] | None, bool]:
+    """Attach only a uniquely authorized payload and remove stale advice."""
+
+    authorized = [
+        plan
+        for plan in solver_plans.get("plans", [])
+        if isinstance(plan, dict)
+        and bool(plan.get("authorized", plan.get("certified", False)))
+    ]
+    attach = bool(expose and len(authorized) == 1)
+    if attach:
+        if isinstance(eca_advice, dict):
+            eca_advice["solver_plans"] = solver_plans
+        else:
+            eca_advice = {"suggested_actions": [], "solver_plans": solver_plans}
+    elif isinstance(eca_advice, dict):
+        eca_advice.pop("solver_plans", None)
+    return eca_advice, attach
+
