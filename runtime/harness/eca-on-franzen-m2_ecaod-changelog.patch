+    _judged = _rep["exact"] + _rep["mismatched"]
+    _ok = (_rep["board_checks"] > 0 and _rep["false_deaths"] == 0 and _rep["deaths_missed"] == 0
+           and _rep["errors"] == 0 and _rep["changing_checks"] >= __MINCH__
+           and 100 * _rep["mismatched"] <= __MISMATCH_PCT__ * _judged)
+    _o["exact"] = bool(_ok)
+    _use = _st if _ok else None
+    if __BEST__:
+        if _ok:
+            _o["planned_with"] = "current"
