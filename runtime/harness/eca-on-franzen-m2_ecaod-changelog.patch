+# --- vendored: arcgym/eca/primitive_synthesis.py `_valued_components` (source sha256 86c8c57c85b04893...) ------------
+def _valued_components(frame: np.ndarray) -> list[dict[str, int]]:
+    arr = np.asarray(frame)
+    if arr.ndim != 2 or arr.size <= 0:
+        return []
+    seen = np.zeros(arr.shape, dtype=bool)
+    height, width = arr.shape
+    components: list[dict[str, int]] = []
+    for y in range(height):
+        for x in range(width):
+            if seen[y, x]:
+                continue
+            value = int(arr[y, x])
+            stack = [(y, x)]
+            seen[y, x] = True
+            xs: list[int] = []
+            ys: list[int] = []
+            while stack:
+                cy, cx = stack.pop()
+                xs.append(cx)
+                ys.append(cy)
+                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    ny, nx = cy + dy, cx + dx
+                    if 0 <= ny < height and 0 <= nx < width and not seen[ny, nx] and int(arr[ny, nx]) == value:
+                        seen[ny, nx] = True
+                        stack.append((ny, nx))
+            area = len(xs)
+            min_x = min(xs)
+            max_x = max(xs)
+            min_y = min(ys)
+            max_y = max(ys)
+            components.append(
+                {
+                    "value": value,
+                    "area": area,
+                    "min_x": min_x,
+                    "max_x": max_x,
+                    "min_y": min_y,
+                    "max_y": max_y,
+                    "width": max_x - min_x + 1,
+                    "height": max_y - min_y + 1,
+                    "cx": int(round(float(sum(xs)) / float(area))),
+                    "cy": int(round(float(sum(ys)) / float(area))),
+                }
+            )
+    return components
+
+
+# --- vendored: arcgym/eca/button_click_prior.py `status_bar_cells` (source sha256 7bc59725366ad1c5...) ---------------
+def status_bar_cells(frame: np.ndarray, valued_components: Callable[[np.ndarray], Any]) -> frozenset:
+    """Cells of thin edge-touching strips (height 1 or width 1 that touch a
+    frame border) -- the HUD / status bar to mask. Colour-agnostic."""
+    frame = np.asarray(frame)
+    h, w = frame.shape
+    cells: set = set()
+    for c in valued_components(frame):
+        min_x, min_y = int(c["min_x"]), int(c["min_y"])
+        max_x, max_y = int(c["max_x"]), int(c["max_y"])
+        touches = (min_x == 0 or min_y == 0 or max_x == w - 1 or max_y == h - 1)
+        thin = (max_y - min_y == 0) or (max_x - min_x == 0)
+        if touches and thin:
+            for y in range(min_y, max_y + 1):
+                for x in range(min_x, max_x + 1):
+                    if int(frame[y, x]) == int(c["value"]):
+                        cells.add((x, y))
+    return frozenset(cells)
