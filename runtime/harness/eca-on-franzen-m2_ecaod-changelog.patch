+def _eca_lite_has_exact_prediction(
+    expected_change: dict[str, Any],
+    family: str,
+) -> bool:
+    family_exact = expected_change.get(f"{family}_exact")
+    if isinstance(family_exact, dict):
+        return True
+    runtime_exact = expected_change.get("runtime_mechanic_exact")
+    return bool(
+        isinstance(runtime_exact, dict)
+        and runtime_exact.get("verifier") == "runtime_mechanic_transition_v1"
+        and str(runtime_exact.get("toolbox_family", "")) == str(family)
