+# --- vendored: arcgym/eca/primitive_synthesis.py `_valued_components` (source sha256 86c8c57c85b04893...) ------------
+def _valued_components(frame: np.ndarray) -> list[dict[str, int]]:
+    arr = np.asarray(frame)
+    if arr.ndim != 2 or arr.size <= 0:
+        return []
+    seen = np.zeros(arr.shape, dtype=bool)
+    height, width = arr.shape
+    components: list[dict[str, int]] = []
+    for y in range(height):
+        for x in range(width):
+            if seen[y, x]:
+                continue
+            value = int(arr[y, x])
+            stack = [(y, x)]
+            seen[y, x] = True
+            xs: list[int] = []
+            ys: list[int] = []
+            while stack:
+                cy, cx = stack.pop()
+                xs.append(cx)
+                ys.append(cy)
+                for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    ny, nx = cy + dy, cx + dx
+                    if 0 <= ny < height and 0 <= nx < width and not seen[ny, nx] and int(arr[ny, nx]) == value:
+                        seen[ny, nx] = True
+                        stack.append((ny, nx))
+            area = len(xs)
+            min_x = min(xs)
+            max_x = max(xs)
+            min_y = min(ys)
+            max_y = max(ys)
+            components.append(
+                {
+                    "value": value,
+                    "area": area,
+                    "min_x": min_x,
+                    "max_x": max_x,
+                    "min_y": min_y,
+                    "max_y": max_y,
+                    "width": max_x - min_x + 1,
+                    "height": max_y - min_y + 1,
+                    "cx": int(round(float(sum(xs)) / float(area))),
+                    "cy": int(round(float(sum(ys)) / float(area))),
+                }
+            )
+    return components
+
