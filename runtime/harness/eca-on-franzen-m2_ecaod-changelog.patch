@@ -0,0 +1,762 @@
+"""Model-checked planning for the python tool (FRZ-SIMPLAN, kojimatech 2026-10-05; docs/frz_simplan_2026-10-05.md).
+
+The model writes its belief about the level as code - `step(board, action) -> board` and optionally
+`goal(board) -> bool` - and four helpers turn that belief into something it can test and use:
+
+  board_of(frame)                 a frame (or a board) as a tuple of `.ascii` row strings, the representation step() uses
+  verify_model(step, goal=None)   replays step() over every transition recorded on the current level and reports the
+                                  first cells it predicted wrong (and, with a goal, where goal() disagrees with the
+                                  recorded level completions)
+  find_plan(step, goal, ...)      searches the model (BFS, or best-first with a heuristic) for an action list that makes
+                                  goal() true, inside the snippet's time limit
+  run_plan(actions, step=None)    executes such a list one action at a time and stops at the first transition step()
+                                  did not predict, at a death, or at a level completion
+
+Nothing here acts on its own: run_plan calls the snippet's ordinary `action()`, so every harness guard still applies,
+and the only guard state it touches is the snippet's stale-state flag, cleared after a prediction is verified exact.
+This source is injected into the sandbox child (inspect.getsource) and installed only when the host sends
+`model_check_enabled`, so without ECA_FRZ_SIMPLAN no snippet can see any of it. Standard library only; every module
+level name starts with `mc_` / `_mc_` / `MC_` so nothing collides with the bootstrap's own names.
+"""
+
+import heapq as _mc_heapq
+import re as _mc_re
+import time as _mc_time
+from collections import deque as _mc_deque
+
+MC_GAME_OVER = "GAME_OVER"
+_MC_UNPLANNABLE = ("RESET", "UNDO", "ACTION7", "L1_EXPLORER")
+_MC_MOUSE_RE = _mc_re.compile(r"^\s*MOUSE\s*\(\s*row\s*=\s*(-?\d+)\s*,\s*col\s*=\s*(-?\d+)\s*\)\s*$", _mc_re.I)
+_MC_CELL_LIMIT = 12
+
+
+def mc_board_of(value):
+    """A frame view (anything with `.ascii`), a board, or an ascii string -> tuple of row strings."""
+    if value is None:
+        return None
+    text = getattr(value, "ascii", None)
+    if isinstance(text, str):
+        return tuple(text.rstrip("\n").split("\n"))
+    board = mc_normalize_board(value)
+    if board == MC_GAME_OVER:
+        raise TypeError("board_of() needs a frame or a board, not GAME_OVER")
+    return board
+
+
+def mc_normalize_board(value):
+    """What step() may return -> tuple of row strings, MC_GAME_OVER, or None (abstain)."""
+    if value is None:
+        return None
+    if isinstance(value, str):
+        if value.strip().upper() in ("GAME_OVER", "DEATH", "DEAD"):
+            return MC_GAME_OVER
+        return tuple(value.rstrip("\n").split("\n"))
+    if isinstance(value, (list, tuple)):
+        rows = []
+        for row in value:
+            if isinstance(row, str):
+                rows.append(row)
+            elif isinstance(row, (list, tuple)):
+                rows.append("".join(str(c) for c in row))
+            else:
+                raise TypeError("each board row must be a string or a list of one-character strings")
+        return tuple(rows)
+    raise TypeError("step() must return a board (rows of characters), None to abstain, or 'GAME_OVER'")
+
+
+def mc_action_text(action):
+    """'UP' / 'MOUSE(row=3, col=5)' / {'action': 'MOUSE', 'row': 3, 'col': 5} / ('MOUSE', 3, 5) -> canonical text,
+    the same spelling the harness records in `history[i].action`."""
+    if isinstance(action, dict):
+        name = str(action.get("action", "")).strip().upper()
+        if name == "MOUSE":
+            return "MOUSE(row=%d, col=%d)" % (int(action["row"]), int(action["col"]))
+        return name
+    if isinstance(action, (list, tuple)) and action and str(action[0]).strip().upper() == "MOUSE":
+        return "MOUSE(row=%d, col=%d)" % (int(action[1]), int(action[2]))
+    text = str(action).strip()
+    match = _MC_MOUSE_RE.match(text)
+    if match:
+        return "MOUSE(row=%d, col=%d)" % (int(match.group(1)), int(match.group(2)))
+    return text.upper()
+
+
+def mc_action_payload(text):
+    """Canonical action text -> the argument `action()` takes."""
+    match = _MC_MOUSE_RE.match(text)
+    if match:
+        return {"action": "MOUSE", "row": int(match.group(1)), "col": int(match.group(2))}
+    return text
+
+
+def mc_diff_cells(predicted, actual, border=0):
+    """[(row, col, predicted, actual), ...] for the cells that differ, ignoring `border` cells at each edge.
+    None when the two boards do not have the same shape."""
+    if len(predicted) != len(actual) or any(len(p) != len(a) for p, a in zip(predicted, actual)):
+        return None
+    cells = []
+    for r in range(border, len(actual) - border):
+        p_row, a_row = predicted[r], actual[r]
+        if p_row == a_row:
+            continue
+        for c in range(border, len(a_row) - border):
+            if p_row[c] != a_row[c]:
+                cells.append((r, c, p_row[c], a_row[c]))
+    return cells
+
+
+def _mc_only_outer(cells, rows, cols, width=4):
+    return bool(cells) and all(r < width or c < width or r >= rows - width or c >= cols - width
+                               for r, c, _p, _a in cells)
+
+
+def mc_diff_summary(cells, limit=6):
+    """Modeler coverage (kojimatech 10-31): the box a diff lies in and its commonest (predicted -> actual) pairs."""
+    if not cells:
+        return {}
+    rows = [c[0] for c in cells]
+    cols = [c[1] for c in cells]
+    pairs = {}
+    for _r, _c, p, a in cells:
+        pairs[(p, a)] = pairs.get((p, a), 0) + 1
+    top = sorted(pairs.items(), key=lambda kv: (-kv[1], str(kv[0])))[:limit]
+    return {"rows": [min(rows), max(rows)], "cols": [min(cols), max(cols)],
+            "pairs": [[p, a, n] for (p, a), n in top]}
+
+
+def mc_window(before, predicted, actual, cells, margin=1, cap=12):
+    """Modeler free-first (kojimatech 10-31): the counterexample window - before / predicted / actual rows over the
+    differing cells' box plus `margin`, at most cap x cap (anchored at the box's top-left)."""
+    if not cells or not actual:
+        return {}
+    rows = [c[0] for c in cells]
+    cols = [c[1] for c in cells]
+    r0, c0 = max(0, min(rows) - margin), max(0, min(cols) - margin)
+    r1 = min(len(actual) - 1, max(rows) + margin, r0 + cap - 1)
+    c1 = min(len(actual[0]) - 1, max(cols) + margin, c0 + cap - 1)
+
+    def crop(b):
+        out = []
+        for r in range(r0, r1 + 1):
+            row = b[r] if b is not None and r < len(b) else ""
+            out.append("".join(row[c0:c1 + 1]) if row else "?" * (c1 - c0 + 1))
+        return out
+    return {"rows": [r0, r1], "cols": [c0, c1], "before": crop(before), "predicted": crop(predicted),
+            "actual": crop(actual)}
+
+
+def mc_window_lines(w, label="before | predicted | actual"):
+    """The window as text lines (the sandbox print and the opener share this form)."""
+    if not w:
+        return []
+    lines = ["rows %d-%d / cols %d-%d (%s):" % (w["rows"][0], w["rows"][1], w["cols"][0], w["cols"][1], label)]
+    for b, p, a in zip(w.get("before") or [], w.get("predicted") or [], w.get("actual") or []):
+        lines.append("  %s | %s | %s" % (b, p, a))
+    return lines
+
+
+def _mc_box(cells):
+    rows = [r for r, _c in cells]
+    cols = [c for _r, c in cells]
+    return [min(rows), max(rows)], [min(cols), max(cols)]
+
+
+def mc_cover(records, board, valid_actions, border=0):
+    """Modeler coverage (kojimatech 10-31): what a level's record covers. Actions tried (clicks pooled as MOUSE),
+    the keyboard actions never tried, the cells that changed in any ordinary recorded transition (outside `border`)
+    with their box, and the non-background cells outside that box that never changed. `cells` is the changed set."""
+    tried, changed, pairs = {}, set(), {}
+    for _i, before, action, after, outcome in records:
+        name = "MOUSE" if action.upper().startswith("MOUSE") else action
+        tried[name] = tried.get(name, 0) + 1
+        if outcome == "board":
+            cells = mc_diff_cells(before, after, border)
+            if cells:
+                changed.update((r, c) for r, c, _p, _a in cells)
+                for _r, _c, p, a in cells:
+                    pairs[(p, a)] = pairs.get((p, a), 0) + 1
+    keyboard = []
+    for a in (valid_actions or []):
+        text = str(a)
+        if text.upper() not in _MC_UNPLANNABLE and text not in keyboard:
+            keyboard.append(text)
+    untried = [a for a in keyboard if a not in tried]
+    out = {"transitions": len(records), "tried": tried, "untried": untried, "changed_cells": len(changed),
+           "cells": sorted(changed),
+           "pairs": [[p, a, n] for (p, a), n in sorted(pairs.items(), key=lambda kv: (-kv[1], str(kv[0])))]}
+    if changed:
+        out["rows"], out["cols"] = _mc_box(changed)
+    if board:
+        counts = {}
+        for r in range(border, len(board) - border):
+            for ch in board[r][border:len(board[r]) - border]:
+                counts[ch] = counts.get(ch, 0) + 1
+        bg = max(counts, key=lambda k: (counts[k], k)) if counts else None
+        out["background"] = bg
+        outside = 0
+        for r in range(border, len(board) - border):
+            row = board[r]
+            for c in range(border, len(row) - border):
+                if row[c] == bg or (r, c) in changed:
+                    continue
+                if changed and out["rows"][0] <= r <= out["rows"][1] and out["cols"][0] <= c <= out["cols"][1]:
+                    continue
+                outside += 1
+        out["unchanged_outside_box"] = outside
+    return out
+
+
+def mc_records(transitions, levels):
+    """The recorded transitions on `levels` (None = all) as (index, before_board, action_text, after_board, outcome)
+    with outcome 'board' (an ordinary transition), 'game_over' (the action ended the attempt) or 'level_up' (the action
+    completed the level; the after-frame already shows the next level, so only goal() can be checked there). RESET /
+    UNDO / automatic entries are skipped."""
+    out = []
+    for index, t in enumerate(transitions or []):
+        action = str(getattr(t, "action", "") or "").strip()
+        before, after = getattr(t, "before_frame", None), getattr(t, "after_frame", None)
+        result = getattr(t, "result", None) or {}
+        if not action or before is None or after is None:
+            continue
+        if action.upper() in _MC_UNPLANNABLE or result.get("automatic"):
+            continue
+        if levels is not None and getattr(before, "level", None) not in levels:
+            continue
+        if result.get("game_over"):
+            outcome = "game_over"
+        elif result.get("level_completed") or result.get("run_complete") or result.get("done") \
+                or getattr(after, "level", None) != getattr(before, "level", None):
+            outcome = "level_up"
+        else:
+            outcome = "board"
+        out.append((index, mc_board_of(before), mc_action_text(action), mc_board_of(after), outcome))
+    return out
+
+
+def _mc_call(fn, *args):
+    try:
+        return fn(*args), None
+    except Exception as exc:  # the model's own code: report it, never let it crash the helper
+        return None, "%s: %s" % (type(exc).__name__, exc)
+
+
+def mc_verify(step, records, goal=None, border=0, show=3, deadline=None):
+    """Replay step() over `records` (see verify_model in mc_install for what the report means)."""
+    n = {"board_checks": 0, "exact": 0, "mismatched": 0, "abstained": 0, "errors": 0, "false_deaths": 0,
+         "deaths_recorded": 0, "deaths_predicted": 0, "deaths_missed": 0, "deaths_abstained": 0,
+         "changing_checks": 0, "exact_changing": 0}
+    examples, goal_examples = [], []
+    first_error = None
+    g = {"level_ups": 0, "goal_true_at_level_up": 0, "goal_false_at_level_up": 0, "goal_true_without_level_up": 0}
+    stopped = None
+    for index, before, action, after, outcome in records:
+        if deadline is not None and _mc_time.monotonic() > deadline:
+            stopped = "time_limit"
+            break
+        if goal is not None and outcome == "board":
+            hit, gerr = _mc_call(goal, after)
+            if gerr is None and hit:
+                g["goal_true_without_level_up"] += 1
+                if len(goal_examples) < show:
+                    goal_examples.append({"transition": index, "action": action,
+                                          "issue": "goal() is true on the recorded board after this action, but the "
+                                                   "level did not complete"})
+        raw, err = _mc_call(step, before, action)
+        if err is None:
+            try:
+                predicted = mc_normalize_board(raw)
+            except TypeError as exc:
+                err = str(exc)
+        if err is not None:
+            n["errors"] += 1
+            first_error = first_error or "transition %d (%s): %s" % (index, action, err)
+            continue
+        if outcome == "level_up":
+            if goal is None:
+                continue
+            g["level_ups"] += 1
+            hit, gerr = (None, "step() gave no board") if predicted in (None, MC_GAME_OVER) else _mc_call(goal, predicted)
+            if gerr is None and hit:
+                g["goal_true_at_level_up"] += 1
+            else:
+                g["goal_false_at_level_up"] += 1
+                if len(goal_examples) < show:
+                    goal_examples.append({"transition": index, "action": action,
+                                          "issue": "this action completed the level, but goal(step(before, action)) "
+                                                   "is %s" % (gerr if gerr else "false")})
+            continue
+        if outcome == "game_over":
+            n["deaths_recorded"] += 1
+            if predicted == MC_GAME_OVER:
+                n["deaths_predicted"] += 1
+            elif predicted is None:
+                n["deaths_abstained"] += 1
+            else:
+                n["deaths_missed"] += 1
+                if len(examples) < show:
+                    examples.append({"transition": index, "action": action,
+                                     "issue": "this action ended the attempt (GAME OVER); step() predicted a board"})
+            continue
+        n["board_checks"] += 1
+        if predicted is None:
+            n["abstained"] += 1
+            continue
+        if predicted == MC_GAME_OVER:
+            n["false_deaths"] += 1
+            if len(examples) < show:
+                examples.append({"transition": index, "action": action,
+                                 "issue": "step() predicted GAME OVER, the attempt went on"})
+            continue
+        # a transition that changed the board (outside the border) is the evidence that tests a rule; a step that
+        # predicts "nothing changes" is exact on every no-op, so the report also counts the changing ones it got right
+        changing = bool(mc_diff_cells(before, after, border))
+        if changing:
+            n["changing_checks"] += 1
+        cells = mc_diff_cells(predicted, after, border)
+        if cells == []:
+            n["exact"] += 1
+            if changing:
+                n["exact_changing"] += 1
+            continue
+        n["mismatched"] += 1
+        if len(examples) >= show:
+            continue
+        if cells is None:
+            examples.append({"transition": index, "action": action,
+                             "issue": "predicted board is %dx%d, actual %dx%d" % (
+                                 len(predicted), len(predicted[0]) if predicted else 0,
+                                 len(after), len(after[0]) if after else 0)})
+            continue
+        example = {"transition": index, "action": action, "differing_cells": len(cells),
+                   "cells_row_col_predicted_actual": [list(c) for c in cells[:_MC_CELL_LIMIT]],
+                   "window": mc_window(before, predicted, after, cells)}
+        if _mc_only_outer(cells, len(after), len(after[0]) if after else 0):
+            example["note"] = "every differing cell is in the outer 4 rows/columns (a HUD bar?); border=4 ignores them"
+        examples.append(example)
+    rep = {"transitions": len(records), **n}
+    if stopped:
+        rep["stopped"] = stopped
+    if examples:
+        rep["first_mismatches"] = examples
+    if first_error:
+        rep["first_error"] = first_error
+    if goal is not None:
+        if goal_examples:
+            g["first_goal_issues"] = goal_examples
+        rep["goal"] = g
+    wrong = n["mismatched"] + n["false_deaths"] + n["deaths_missed"] + n["errors"]
+    judged = n["exact"] + n["mismatched"] + n["false_deaths"] + n["deaths_predicted"] + n["deaths_missed"]
+    if not records:
+        rep["verdict"] = "no transition recorded on this level yet"
+    elif wrong == 0 and judged == 0:
+        rep["verdict"] = "step() abstained on every recorded transition"
+    elif wrong == 0:
+        rep["verdict"] = "consistent with all %d judged transitions (%d of them changed the board; %d abstained)" % (
+            judged, n["exact_changing"], n["abstained"] + n["deaths_abstained"])
+    else:
+        rep["verdict"] = ("contradicted: %d board mismatches, %d false deaths, %d missed deaths, %d errors"
+                          % (n["mismatched"], n["false_deaths"], n["deaths_missed"], n["errors"]))
+    return rep
+
+
+def mc_plan(step, goal, start, actions, heuristic=None, astar=False, key=None, max_nodes=100000, deadline=None,
+            max_depth=None, reach_border=None):
+    """Search the model from `start` (see find_plan in mc_install for the result's fields). With reach_border=k the
+    result also carries `reach`: the cells (outside k border cells) that change in any reachable state."""
+    t0 = _mc_time.monotonic()
+    key = key or (lambda board: board)
+    reach = set() if reach_border is not None else None
+    res = {"found": False, "actions": [], "length": 0, "expanded": 0, "states": 1, "stopped": None,
+           "step_errors": 0, "goal_errors": 0, "abstained": 0, "deaths_pruned": 0}
+    if not actions:
+        res.update(stopped="no actions to search: pass actions=[...] (clicks as 'MOUSE(row=r, col=c)')", seconds=0.0)
+        return res
+    hit, err = _mc_call(goal, start)
+    if err is None and hit:
+        res.update(found=True, stopped="goal already true on the start board", seconds=0.0)
+        return res
+    start_key = key(start)
+    parents = {start_key: None}
+    counter = 0
+    best = None
+    if heuristic is not None:
+        h0, herr = _mc_call(heuristic, start)
+        h0 = float(h0) if herr is None and h0 is not None else 0.0
+        best = (h0, start_key)
+        frontier = [(h0, counter, 0, start, start_key)]
+    else:
+        frontier = _mc_deque([(0, start, start_key)])
+    first_error = None
+
+    def _path(k):
+        out = []
+        while parents[k] is not None:
+            k, a = parents[k]
+            out.append(a)
+        out.reverse()
+        return out
+
+    while frontier:
+        if heuristic is not None:
+            _f, _c, depth, board, bkey = _mc_heapq.heappop(frontier)
+        else:
+            depth, board, bkey = frontier.popleft()
+        if max_depth is not None and depth >= max_depth:
+            res["stopped"] = res["stopped"] or "depth_limit"
+            continue
+        res["expanded"] += 1
+        for action in actions:
+            raw, err = _mc_call(step, board, action)
+            if err is None:
+                try:
+                    nxt = mc_normalize_board(raw)
+                except TypeError as exc:
+                    err = str(exc)
+            if err is not None:
+                res["step_errors"] += 1
+                first_error = first_error or "step(board, %r): %s" % (action, err)
+                continue
+            if nxt is None:
+                res["abstained"] += 1
+                continue
+            if nxt == MC_GAME_OVER:
+                res["deaths_pruned"] += 1
+                continue
+            nkey = key(nxt)
+            if nkey in parents:
+                continue
+            parents[nkey] = (bkey, action)
+            if reach is not None:
+                _rc = mc_diff_cells(board, nxt, reach_border)
+                if _rc:
+                    reach.update((r, c) for r, c, _p, _a in _rc)
+            hit, gerr = _mc_call(goal, nxt)
+            if gerr is not None:
+                res["goal_errors"] += 1
+                first_error = first_error or "goal(board): %s" % gerr
+            elif hit:
+                path = _path(nkey)
+                res.update(found=True, actions=path, length=len(path), stopped="goal",
+                           states=len(parents), seconds=round(_mc_time.monotonic() - t0, 2))
+                if reach is not None:
+                    res["reach"] = _mc_reach_summary(reach)
+                if first_error:
+                    res["first_error"] = first_error
+                return res
+            if heuristic is not None:
+                h, herr = _mc_call(heuristic, nxt)
+                h = float(h) if herr is None and h is not None else float("inf")
+                if best is None or h < best[0]:
+                    best = (h, nkey)
+                counter += 1
+                _mc_heapq.heappush(frontier, (h + (depth + 1 if astar else 0), counter, depth + 1, nxt, nkey))
+            else:
+                frontier.append((depth + 1, nxt, nkey))
+        if len(parents) >= max_nodes:
+            res["stopped"] = "node_limit"
+            break
+        if deadline is not None and _mc_time.monotonic() > deadline:
+            res["stopped"] = "time_limit"
+            break
+    res["states"] = len(parents)
+    res["stopped"] = res["stopped"] or "exhausted: no state reachable under this model satisfies goal"
+    res["seconds"] = round(_mc_time.monotonic() - t0, 2)
+    if reach is not None:
+        res["reach"] = _mc_reach_summary(reach)
+    if best is not None and best[1] != start_key:
+        path = _path(best[1])
+        res["closest_by_heuristic"] = {"heuristic": best[0], "actions": path[:60], "length": len(path)}
+    if first_error:
+        res["first_error"] = first_error
+    return res
+
+
+def _mc_reach_summary(reach):
+    out = {"cells": len(reach)}
+    if reach:
+        out["rows"], out["cols"] = _mc_box(reach)
+    return out
+
+
+_MC_LAST_BORDER = [0]  # SIMPLAN-2 (2026-10-17): the border of the model's last verify_model / find_plan call
+
+
+def mc_install(runtime_globals, action_fn, stale_state, terminal_state, log, timeout_seconds, options=None):
+    """Install board_of / verify_model / find_plan / run_plan into a snippet's globals. `log` collects one compact
+    record per call for the host's telemetry; `stale_state` / `terminal_state` are the snippet's own guard lists."""
+    started = _mc_time.monotonic()
+    # SIMPLAN-2b (2026-10-17): every snippet is a fresh process, so the host hands over the border of the last
+    # verify_model / find_plan call and whether this level's modelling budget is used
+    _opts = dict(options or {})
+    _MC_LAST_BORDER[0] = int(_opts.get("border") or 0)
+    _locked = str(_opts.get("locked") or "")
+
+    def _refuse(fn):
+        log.append({"fn": fn, "level": _current_level(), "refused": "budget"})
+        raise RuntimeError(fn + " is switched off on this level: " + _locked + ". Play with action() now; "
+                           "verify_model and find_plan come back on the next level, run_plan still runs.")
+
+    def _deadline(seconds, reserve):
+        left = timeout_seconds - (_mc_time.monotonic() - started) - reserve
+        cap = left if seconds is None else min(float(seconds), left)
+        return _mc_time.monotonic() + max(0.5, cap)
+
+    def _current_level():
+        return getattr(runtime_globals.get("current_frame"), "level", None)
+
+    def board_of(frame=None):
+        """board_of(frame=current_frame) -> the board as a tuple of `.ascii` row strings (row r, column c is
+        board[r][c]); step(board, action) receives and returns boards in this form."""
+        return mc_board_of(runtime_globals.get("current_frame") if frame is None else frame)
+
+    def verify_model(step, goal=None, border=0, levels=None, show=3):
+        """Replay step(board, action) over every transition recorded on the current level (levels=[...] or 'all'
+        for others) and compare each prediction with what happened. step returns the next board, None to abstain,
+        or 'GAME_OVER' to predict that the action ends the attempt. Returns counts (exact / mismatched / abstained /
+        errors / deaths) and the first mismatches cell by cell as [row, col, predicted, actual]; border=k ignores k
+        cells at every edge (e.g. a HUD bar). With goal(board), also checks that goal is false on every recorded
+        board that did not complete the level and true on step(before, action) for the actions that did."""
+        if _locked:
+            _refuse("verify_model")
+        if levels is None:
+            wanted = {_current_level()}
+        elif levels == "all":
+            wanted = None
+        else:
+            wanted = set(levels) if isinstance(levels, (list, tuple, set)) else {levels}
+        records = mc_records(runtime_globals.get("transitions"), wanted)
+        _MC_LAST_BORDER[0] = int(border)
+        rep = mc_verify(step, records, goal=goal, border=int(border), show=int(show), deadline=_deadline(None, 4.0))
+        log.append({"fn": "verify_model", "level": _current_level(), "transitions": rep["transitions"],
+                    "board_checks": rep["board_checks"], "exact": rep["exact"], "mismatched": rep["mismatched"],
+                    "abstained": rep["abstained"], "errors": rep["errors"], "deaths_recorded": rep["deaths_recorded"],
+                    "deaths_predicted": rep["deaths_predicted"], "changing_checks": rep["changing_checks"],
+                    "exact_changing": rep["exact_changing"], "goal": goal is not None, "border": int(border)})
+        return rep
+
+    def find_plan(step, goal, actions=None, start=None, heuristic=None, astar=False, border=0, max_nodes=100000,
+                  seconds=None, max_depth=None, reach=False):
+        """Search your model for actions that make goal(board) true: BFS (shortest plan) by default, best-first on
+        heuristic(board) (lower is better; astar=True adds the path length). actions defaults to the keyboard
+        actions in valid_actions; give clicks explicitly, e.g. ['UP', 'MOUSE(row=3, col=5)']. border=k treats two
+        boards that differ only in the outer k cells as one state. Stops at max_nodes states or the time left in
+        this snippet (seconds caps it). Returns found, actions, length, states, seconds, stopped and error counts;
+        with a heuristic and no solution, closest_by_heuristic."""
+        if _locked:
+            _refuse("find_plan")
+        if actions is None:
+            actions = [a for a in (runtime_globals.get("valid_actions") or [])
+                       if str(a).upper() not in _MC_UNPLANNABLE and str(a).upper() != "MOUSE"]
+        acts = []
+        for a in actions:
+            text = mc_action_text(a)
+            if text and text not in acts and text not in _MC_UNPLANNABLE:
+                acts.append(text)
+        board = mc_board_of(runtime_globals.get("current_frame") if start is None else start)
+        width = int(border)
+        _MC_LAST_BORDER[0] = width
+        key = (lambda b, w=width: tuple(row[w:len(row) - w] for row in b[w:len(b) - w])) if width > 0 else None
+        res = mc_plan(step, goal, board, acts, heuristic=heuristic, astar=bool(astar), key=key,
+                      max_nodes=int(max_nodes), deadline=_deadline(seconds, 5.0), max_depth=max_depth,
+                      reach_border=(width if reach else None))
+        log.append({"fn": "find_plan", "level": _current_level(), "found": res["found"], "length": res["length"],
+                    "states": res["states"], "stopped": str(res["stopped"])[:40], "seconds": res.get("seconds"),
+                    "n_actions": len(acts), "heuristic": heuristic is not None, "border": width})
+        return res
+
+    def level_cover(border=0):
+        """Modeler coverage (kojimatech 10-31): what this level's record covers - actions tried and untried, the
+        cells that have changed (with their box) and the non-background cells outside it that never changed."""
+        records = mc_records(runtime_globals.get("transitions"), {_current_level()})
+        return mc_cover(records, mc_board_of(runtime_globals.get("current_frame")),
+                        runtime_globals.get("valid_actions") or [], border=int(border))
+
+    def goal_candidates(step, border=0, max_boards=600):
+        """Modeler best (kojimatech 10-31): goal candidates inferred from this game's level-ups. For every level-up
+        recorded so far, step(before, action) gives the completing board; a candidate "count(colour) == c" holds
+        when that count is the same on every predicted completing board and never on any other recorded board (the
+        last max_boards). Each entry: expr, char, count, level_ups, others, fn (a goal(board) callable)."""
+        records = mc_records(runtime_globals.get("transitions"), None)
+        ups = [(b, a) for _i, b, a, _af, o in records if o == "level_up"]
+        others = []
+        for _i, b, _a, af, o in records:
+            others.append(b)
+            if o == "board":
+                others.append(af)
+        others = others[-int(max_boards):]
+        preds = []
+        for b, a in ups:
+            v, err = _mc_call(step, b, a)
+            if err is not None:
+                continue
+            try:
+                p = mc_normalize_board(v)
+            except TypeError:
+                p = None
+            if p is not None and p != MC_GAME_OVER:
+                preds.append(p)
+        if not preds:
+            return []
+        w = int(border)
+
+        def count(board, ch):
+            return sum(row[w:len(row) - w].count(ch) for row in board[w:len(board) - w])
+        chars, freq = set(), {}
+        for p in preds + [b for b, _a in ups]:   # a colour the completion removes is absent from the completing board
+            for row in p[w:len(p) - w]:
+                chars.update(row[w:len(row) - w])
+        for row in preds[0][w:len(preds[0]) - w]:
+            for ch in row[w:len(row) - w]:
+                freq[ch] = freq.get(ch, 0) + 1
+        background = max(freq, key=lambda k: (freq[k], k)) if freq else None
+        out = []
+        for ch in sorted(chars):
+            cs = {count(p, ch) for p in preds}
+            if len(cs) != 1:
+                continue
+            c = cs.pop()
+            if any(count(b, ch) == c for b in others):
+                continue
+            out.append({"expr": "count(%r) == %d" % (ch, c), "char": ch, "count": c, "level_ups": len(preds),
+                        "others": len(others), "background": ch == background,
+                        "fn": (lambda board, ch=ch, c=c, w=w: count(board, ch) == c)})
+        out.sort(key=lambda d: (d["background"], d["count"] != 0, d["char"]))
+        return out
+
+    def harness_click_candidates(limit=24, border=0):
+        """Modeler free-first (kojimatech 10-31): click candidates the harness can supply when a click-only game
+        has no click_candidates(): the distinct cells clicked on this level (latest first), then the centres of the
+        current frame's segmentation objects (largest object = background, skipped; outer `border` skipped)."""
+        records = mc_records(runtime_globals.get("transitions"), {_current_level()})
+        clicked = []
+        for _i, _b, action, _a, _o in reversed(records):
+            if action.upper().startswith("MOUSE") and action not in clicked:
+                clicked.append(action)
+        board = mc_board_of(runtime_globals.get("current_frame"))
+        rows, cols = len(board), (len(board[0]) if board else 0)
+        centres = []
+        try:
+            seg = getattr(runtime_globals.get("current_frame"), "segmentation", None)
+            nodes = list(seg.get("nodes") or []) if isinstance(seg, dict) else []
+        except Exception:
+            nodes = []
+        nodes.sort(key=lambda n: -int(n.get("pixels") or 0))
+        for node in nodes[1:]:
+            pts = node.get("boundary") or []
+            if not pts:
+                continue
+            rr = [int(p[0]) for p in pts]
+            cc = [int(p[1]) for p in pts]
+            r, c = (min(rr) + max(rr)) // 2, (min(cc) + max(cc)) // 2
+            if not (border <= r < rows - border and border <= c < cols - border):
+                continue
+            text = "MOUSE(row=%d, col=%d)" % (r, c)
+            if text not in clicked and text not in centres:
+                centres.append(text)
+        cands = (clicked + centres)[:int(limit)]
+        return {"candidates": cands, "clicked": len(clicked), "centres": len(centres), "candidates_n": len(cands)}
+
+    def run_plan(actions, step=None, border=None, stop_new=None):
+        """Execute actions one at a time with the real action(). With step, each result is compared with what
+        step(board, action) predicted and the run stops at the first difference (outside border cells); it also
+        stops at a GAME OVER and at a level completion. Returns executed, outcome ('plan_done', 'level_completed',
+        'game_over', 'mismatch', 'refused', 'step_error') and, for a mismatch, the differing cells. border=None uses
+        the border of your last verify_model / find_plan call; a difference confined to the outer 4 rows/columns
+        (a HUD bar) is reported in hud_only_steps and does not stop the run. stop_new=pairs (the (before, after)
+        cell values recorded on this level, e.g. from level_cover()['pairs']) stops the run, with outcome
+        'new_ground', right after the first action whose predicted change contains a value pair not in that set
+        (modeler coverage, 10-31): the action is executed and checked, then the run stops."""
