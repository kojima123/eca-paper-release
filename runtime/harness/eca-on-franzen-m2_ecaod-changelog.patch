+def _literal_source(name, value):
+    """`name = <repr>` when the live value round-trips as a Python literal; None otherwise."""
+    try:
+        text = repr(value)
+        if ast.literal_eval(text) != value:
+            return None
+    except Exception:
+        return None
+    return name + ' = ' + text
