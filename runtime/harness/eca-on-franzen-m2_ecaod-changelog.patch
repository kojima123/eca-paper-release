+def _think_budget_wants_continuation(result: "_ChatCompletionResult") -> bool:
+    """True for a reply cut at the cap while still thinking: finish_reason=length, reasoning present and not a
+    repetition loop, no content, no tool call. A reply cut inside its content or tool call keeps the harness's
+    existing handling (the call is dropped and the CUT OFF nudge follows)."""
+    if str(getattr(result, "finish_reason", "") or "").strip() != "length":
+        return False
+    message = getattr(result, "message", None) or {}
+    if message.get("tool_calls"):
+        return False
+    if _normalize_message_content(message.get("content", "")):
+        return False
+    reasoning = _extract_reasoning_text(message)
+    return bool(reasoning) and not _is_degenerate_text(reasoning)
