index 0000000..eb1970b
--- /dev/null
+++ b/ARC3-Inference/inference/framework/solver_library.py
@@ -0,0 +1,50 @@
+"""Solved-level library (kojimatech 11-03, ECA_FRZ_LIBRARY=1, default off).
+
+Levels the model or the solver completed in earlier runs, harvested from those runs' histories, replayed and shortened on the
+local engine (tools/library_harvest.py in the research repo). Each entry holds the level's start-board hash, the actions, and the
+board hash after every action. The solver replays an entry only when the level's current board is that start board, checks the
+board after every action, and stops at the first difference: the stored solution is evidence that held in another run, not a
+rule, so it acts only while the board says this is the same level."""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+_DEFAULT = Path(__file__).resolve().parents[1] / "data" / "solver_library.json"
+_CACHE: dict[str, Any] = {}
+
+
+def enabled() -> bool:
+    return os.environ.get("ECA_FRZ_LIBRARY", "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def board_hash(grid) -> str:
+    """The same hash the harvest stores: the last frame as int16 bytes, sha1, 16 hex digits."""
+    return hashlib.sha1(np.asarray(grid, dtype=np.int16).tobytes()).hexdigest()[:16]
+
+
+def load() -> dict:
+    path = os.environ.get("ECA_FRZ_LIBRARY_PATH", "").strip() or str(_DEFAULT)
+    try:
+        key = (path, os.path.getmtime(path))
+    except OSError:
+        key = (path, None)
+    if _CACHE.get("key") != key:
+        try:
+            data = json.load(open(path, encoding="utf-8"))
+        except Exception:
+            data = {"games": {}}
+        _CACHE.update(key=key, data=data)
+    return _CACHE["data"]
+
+
+def entry(game_id: str, level: int) -> dict | None:
+    for e in load().get("games", {}).get(str(game_id), []):
+        if int(e.get("level", -1)) == int(level):
+            return e
+    return None
