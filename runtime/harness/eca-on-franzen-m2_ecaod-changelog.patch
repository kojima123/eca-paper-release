+def _pinned_levels_block(history_entries: list[Any]) -> str:
+    """The record of cleared levels as plain facts, built from the runtime history: for level L, the actions of the
+    attempt that cleared it (entries at level L after the last RESET, plus the entry whose frame is level L+1)."""
+    entries = list(history_entries or [])
+    rows: list[tuple[int, str]] = []
+    for i, entry in enumerate(entries):
+        frame = getattr(entry, "frame", None)
+        if frame is None or i == 0:
+            continue
+        prev = getattr(entries[i - 1], "frame", None)
+        if prev is None:
+            continue
+        lv_prev, lv_now = int(getattr(prev, "level", 0) or 0), int(getattr(frame, "level", 0) or 0)
+        if lv_now <= lv_prev:
+            continue
+        acts: list[str] = []
+        j = i
+        while j >= 1:
+            e_j, f_j = entries[j], getattr(entries[j], "frame", None)
+            a_j = str(getattr(e_j, "action", "") or "")
+            if j != i and (f_j is None or int(getattr(f_j, "level", 0) or 0) != lv_prev):
+                break
+            if a_j.upper().startswith("RESET"):
+                break
+            acts.append(a_j)
+            j -= 1
+        acts.reverse()
+        if not acts:
+            continue
+        acts = acts[-_PIN_MAX_ACTIONS:]
+        coded: list[str] = []
+        k = 0
+        while k < len(acts):
+            m = k
+            while m + 1 < len(acts) and acts[m + 1] == acts[k]:
+                m += 1
+            coded.append(acts[k] if m == k else f"{acts[k]} x{m - k + 1}")
+            k = m + 1
+        rows.append((lv_prev, ", ".join(coded)))
+    if not rows:
+        return ""
+    lines = [
+        "",
+        "Record of levels already cleared in this game (from the harness history; facts, not advice). Each line is the "
+        "action sequence of the attempt that cleared the level (its last actions; `x3` = three times in a row):",
+    ]
+    lines.extend(f"- Level {lv}: {seq}" for lv, seq in rows)
+    text = "\n".join(lines)
+    return text if len(text) <= _PIN_MAX_CHARS else text[: _PIN_MAX_CHARS - 3] + "..."
+
