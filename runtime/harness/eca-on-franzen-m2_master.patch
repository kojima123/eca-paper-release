+"""Model-checked planning for the python tool (FRZ-SIMPLAN, kojimatech 2026-10-05; docs/frz_simplan_2026-10-05.md).
+
+The model writes its belief about the level as code - `step(board, action) -> board` and optionally
+`goal(board) -> bool` - and four helpers turn that belief into something it can test and use:
+
+  board_of(frame)                 a frame (or a board) as a tuple of `.ascii` row strings, the representation step() uses
+  verify_model(step, goal=None)   replays step() over every transition recorded on the current level and reports the
+                                  first cells it predicted wrong (and, with a goal, where goal() disagrees with the
+                                  recorded level completions)
+  find_plan(step, goal, ...)      searches the model (BFS, or best-first with a heuristic) for an action list that makes
+                                  goal() true, inside the snippet's time limit
+  run_plan(actions, step=None)    executes such a list one action at a time and stops at the first transition step()
+                                  did not predict, at a death, or at a level completion
+
+Nothing here acts on its own: run_plan calls the snippet's ordinary `action()`, so every harness guard still applies,
+and the only guard state it touches is the snippet's stale-state flag, cleared after a prediction is verified exact.
+This source is injected into the sandbox child (inspect.getsource) and installed only when the host sends
+`model_check_enabled`, so without ECA_FRZ_SIMPLAN no snippet can see any of it. Standard library only; every module
+level name starts with `mc_` / `_mc_` / `MC_` so nothing collides with the bootstrap's own names.
+"""
+
+import heapq as _mc_heapq
+import re as _mc_re
+import time as _mc_time
+from collections import deque as _mc_deque
+
+MC_GAME_OVER = "GAME_OVER"
+_MC_UNPLANNABLE = ("RESET", "UNDO", "ACTION7", "L1_EXPLORER")
+_MC_MOUSE_RE = _mc_re.compile(r"^\s*MOUSE\s*\(\s*row\s*=\s*(-?\d+)\s*,\s*col\s*=\s*(-?\d+)\s*\)\s*$", _mc_re.I)
+_MC_CELL_LIMIT = 12
+
+
+def mc_board_of(value):
+    """A frame view (anything with `.ascii`), a board, or an ascii string -> tuple of row strings."""
+    if value is None:
+        return None
+    text = getattr(value, "ascii", None)
+    if isinstance(text, str):
+        return tuple(text.rstrip("\n").split("\n"))
+    board = mc_normalize_board(value)
+    if board == MC_GAME_OVER:
+        raise TypeError("board_of() needs a frame or a board, not GAME_OVER")
+    return board
+
+
+def mc_normalize_board(value):
+    """What step() may return -> tuple of row strings, MC_GAME_OVER, or None (abstain)."""
+    if value is None:
+        return None
+    if isinstance(value, str):
+        if value.strip().upper() in ("GAME_OVER", "DEATH", "DEAD"):
+            return MC_GAME_OVER
+        return tuple(value.rstrip("\n").split("\n"))
+    if isinstance(value, (list, tuple)):
+        rows = []
+        for row in value:
+            if isinstance(row, str):
+                rows.append(row)
+            elif isinstance(row, (list, tuple)):
+                rows.append("".join(str(c) for c in row))
+            else:
+                raise TypeError("each board row must be a string or a list of one-character strings")
+        return tuple(rows)
+    raise TypeError("step() must return a board (rows of characters), None to abstain, or 'GAME_OVER'")
+
+
+def mc_action_text(action):
+    """'UP' / 'MOUSE(row=3, col=5)' / {'action': 'MOUSE', 'row': 3, 'col': 5} / ('MOUSE', 3, 5) -> canonical text,
+    the same spelling the harness records in `history[i].action`."""
+    if isinstance(action, dict):
+        name = str(action.get("action", "")).strip().upper()
+        if name == "MOUSE":
+            return "MOUSE(row=%d, col=%d)" % (int(action["row"]), int(action["col"]))
+        return name
+    if isinstance(action, (list, tuple)) and action and str(action[0]).strip().upper() == "MOUSE":
+        return "MOUSE(row=%d, col=%d)" % (int(action[1]), int(action[2]))
+    text = str(action).strip()
+    match = _MC_MOUSE_RE.match(text)
+    if match:
+        return "MOUSE(row=%d, col=%d)" % (int(match.group(1)), int(match.group(2)))
+    return text.upper()
+
+
+def mc_action_payload(text):
+    """Canonical action text -> the argument `action()` takes."""
+    match = _MC_MOUSE_RE.match(text)
+    if match:
+        return {"action": "MOUSE", "row": int(match.group(1)), "col": int(match.group(2))}
+    return text
+
+
+def mc_diff_cells(predicted, actual, border=0):
+    """[(row, col, predicted, actual), ...] for the cells that differ, ignoring `border` cells at each edge.
+    None when the two boards do not have the same shape."""
+    if len(predicted) != len(actual) or any(len(p) != len(a) for p, a in zip(predicted, actual)):
+        return None
+    cells = []
+    for r in range(border, len(actual) - border):
+        p_row, a_row = predicted[r], actual[r]
+        if p_row == a_row:
+            continue
+        for c in range(border, len(a_row) - border):
+            if p_row[c] != a_row[c]:
+                cells.append((r, c, p_row[c], a_row[c]))
+    return cells
+
+
+def _mc_only_outer(cells, rows, cols, width=4):
+    return bool(cells) and all(r < width or c < width or r >= rows - width or c >= cols - width
+                               for r, c, _p, _a in cells)
+
+
+def mc_records(transitions, levels):
+    """The recorded transitions on `levels` (None = all) as (index, before_board, action_text, after_board, outcome)
+    with outcome 'board' (an ordinary transition), 'game_over' (the action ended the attempt) or 'level_up' (the action
+    completed the level; the after-frame already shows the next level, so only goal() can be checked there). RESET /
+    UNDO / automatic entries are skipped."""
+    out = []
+    for index, t in enumerate(transitions or []):
+        action = str(getattr(t, "action", "") or "").strip()
+        before, after = getattr(t, "before_frame", None), getattr(t, "after_frame", None)
+        result = getattr(t, "result", None) or {}
+        if not action or before is None or after is None:
+            continue
+        if action.upper() in _MC_UNPLANNABLE or result.get("automatic"):
+            continue
+        if levels is not None and getattr(before, "level", None) not in levels:
+            continue
+        if result.get("game_over"):
+            outcome = "game_over"
+        elif result.get("level_completed") or result.get("run_complete") or result.get("done") \
+                or getattr(after, "level", None) != getattr(before, "level", None):
+            outcome = "level_up"
+        else:
+            outcome = "board"
+        out.append((index, mc_board_of(before), mc_action_text(action), mc_board_of(after), outcome))
+    return out
+
+
+def _mc_call(fn, *args):
+    try:
+        return fn(*args), None
+    except Exception as exc:  # the model's own code: report it, never let it crash the helper
+        return None, "%s: %s" % (type(exc).__name__, exc)
+
+
+def mc_verify(step, records, goal=None, border=0, show=3, deadline=None):
+    """Replay step() over `records` (see verify_model in mc_install for what the report means)."""
+    n = {"board_checks": 0, "exact": 0, "mismatched": 0, "abstained": 0, "errors": 0, "false_deaths": 0,
+         "deaths_recorded": 0, "deaths_predicted": 0, "deaths_missed": 0, "deaths_abstained": 0,
+         "changing_checks": 0, "exact_changing": 0}
+    examples, goal_examples = [], []
+    first_error = None
+    g = {"level_ups": 0, "goal_true_at_level_up": 0, "goal_false_at_level_up": 0, "goal_true_without_level_up": 0}
