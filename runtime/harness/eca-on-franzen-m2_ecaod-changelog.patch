+def _eca_lite_transition_score_owned(
+    transition: dict[str, Any] | None,
+    active_lease: dict[str, Any] | None,
+) -> bool:
+    """Require source, old-level lease, and exact first-action ownership."""
+
+    if not transition or not active_lease:
+        return False
+    owner = str(transition.get("source_family", "") or "")
+    return bool(
+        int(transition.get("score_delta", 0) or 0) > 0
+        and owner
+        and transition.get("planned_action_match")
+        and str(active_lease.get("family", "") or "") == owner
+        and int(active_lease.get("level", -1))
+        == int(transition.get("level_before", -2))
+    )
+
