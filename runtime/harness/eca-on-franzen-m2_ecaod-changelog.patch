+def _expect_streak_n() -> int:
+    """Consecutive refuted expectations on one level before the next opener gets one line (default 3; 0 disables)."""
+    return int(_env_number("ECA_FRZ_EXPECT_STREAK", 3, int))
+
+
+_EXPECT_KEYS = ("changes", "cells", "level_up", "game_over")
+
+
+def _expect_cells(raw) -> tuple[list[tuple[int, int]], str | None]:
+    cells: list[tuple[int, int]] = []
+    if isinstance(raw, dict) or not isinstance(raw, (list, tuple)):
+        return [], "cells must be a list of [row, col]"
+    for item in raw:
+        try:
+            r, c = int(item[0]), int(item[1])
+        except (TypeError, ValueError, IndexError, KeyError):
+            return [], "cells must be a list of [row, col]"
+        cells.append((r, c))
+    return cells, None
+
+
+def _expectation_one(exp: dict, before, after, payloads: list) -> dict:
+    """One expectation dict against the transition before -> after; payloads = the executed actions it spans."""
+    refuted: list[str] = []
+    ignored: list[str] = []
+    checked: list[str] = []
+    unknown = [str(k) for k in exp if k not in _EXPECT_KEYS]
+    if unknown:
+        ignored.append("unknown keys " + ", ".join(unknown))
+    if "changes" in exp:
+        checked.append("changes")
+        want = bool(exp["changes"])
+        actual = _interior_gameplay_changed(before, after)
+        if want != actual:
+            refuted.append(
+                "changes: expected "
+                + ("a change inside the board area" if want else "no change inside the board area")
+                + " but "
+                + ("the board area changed" if actual else "nothing changed inside the board area")
+            )
+    if "cells" in exp:
+        checked.append("cells")
+        cells, err = _expect_cells(exp["cells"])
+        if err:
+            ignored.append(err)
+        else:
+            unchanged: list[tuple[int, int]] = []
+            outside = 0
+            for r, c in cells:
+                try:
+                    if before[r][c] == after[r][c]:
+                        unchanged.append((r, c))
+                except (IndexError, TypeError):
+                    outside += 1
+            if unchanged:
+                shown = ", ".join(f"({r},{c})" for r, c in unchanged[:6]) + (" ..." if len(unchanged) > 6 else "")
+                refuted.append(f"cells: {len(unchanged)} of {len(cells)} expected cells did not change: {shown}")
+            if outside:
+                ignored.append(f"{outside} cells outside the board")
+    for key, field_name in (("level_up", "level_completed"), ("game_over", "game_over")):
+        if key in exp:
+            checked.append(key)
+            want = bool(exp[key])
+            actual = any(bool(item.get(field_name)) for item in payloads)
+            if want != actual:
+                refuted.append(f"{key}: expected {str(want).lower()} but observed {str(actual).lower()}")
+    return {"held": not refuted, "checked": checked, "refuted": refuted, "ignored": ignored}
+
+
+def _expectation_verdict(expect, grids: list, payloads: list) -> dict:
+    """grids[0] = the board before the first executed action, grids[i] = the board after executed action i."""
+    if isinstance(expect, dict):
+        one = _expectation_one(expect, grids[0], grids[-1], payloads)
+        return {"scope": "call", "held": one["held"], "items": [one]}
+    if isinstance(expect, list) and expect and all(isinstance(e, dict) for e in expect):
+        if len(expect) != len(payloads):
+            return {"scope": "per_action", "held": None,
+                    "invalid": f"one dict per executed action was expected: {len(expect)} given, {len(payloads)} executed"}
+        items = [_expectation_one(e, grids[i], grids[i + 1], [payloads[i]]) for i, e in enumerate(expect)]
+        return {"scope": "per_action", "held": all(it["held"] for it in items), "items": items}
+    return {"scope": "invalid", "held": None, "invalid": "expect must be a dict or a list of dicts"}
+
+
+def _expectation_line(verdict: dict) -> str:
+    if verdict.get("held") is None:
+        return f"EXPECTATION IGNORED: {verdict.get('invalid', 'invalid')}"
+    items = verdict.get("items") or []
+    if verdict.get("scope") == "per_action" and len(items) > 1:
+        parts = [
+            f"{i}/{len(items)} " + ("HELD" if it["held"] else "REFUTED: " + " | ".join(it["refuted"]))
+            for i, it in enumerate(items, 1)
+        ]
+        line = "EXPECTATION " + "; ".join(parts)
+    else:
+        it = items[0]
+        line = ("EXPECTATION HELD (" + ", ".join(it["checked"]) + ")") if it["held"] \
+            else "EXPECTATION REFUTED: " + " | ".join(it["refuted"])
+    ignored = [x for it in items for x in it.get("ignored", [])]
+    if ignored:
+        line += " [ignored: " + ", ".join(dict.fromkeys(ignored)) + "]"
+    return line
+
