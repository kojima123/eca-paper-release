+_NOWAIT_DEFAULT_WORDS = ("Wait", " Wait", "wait", " wait", "Hmm", " Hmm", "hmm", " hmm",
+                         "Alternatively", " Alternatively", " alternatively")
+_NOWAIT_CACHE: dict[str, dict[str, float]] = {}
+_NOWAIT_REPORT: dict[str, dict[str, list[int]]] = {}
+
+
+def _nowait_enabled() -> bool:
+    """Reflection-word suppression (kojimatech 10-31; docs/nowait_registration_2026-10-31.md; NoWait, arXiv
+    2506.08343). ECA_FRZ_NOWAIT=1: every chat request carries a logit_bias of -100 on the reflection words that
+    encode as ONE token ("Wait", "Hmm", "Alternatively" and their space / lower-case forms; ECA_FRZ_NOWAIT_WORDS, a
+    JSON list, overrides the list). Words that need several tokens are left alone, so no prefix of another word is
+    touched. Nothing in the prompt changes. Default off."""
+    return _get_env_bool("ECA_FRZ_NOWAIT", False)
+
+
+def _nowait_words() -> tuple[str, ...]:
+    raw = os.environ.get("ECA_FRZ_NOWAIT_WORDS", "").strip()
+    if not raw:
+        return _NOWAIT_DEFAULT_WORDS
+    words = json.loads(raw)
+    if not isinstance(words, list) or not all(isinstance(w, str) and w for w in words):
+        raise ValueError("ECA_FRZ_NOWAIT_WORDS must be a JSON list of non-empty strings")
+    return tuple(words)
+
+
+def _nowait_logit_bias(base_url: str, model: str, headers: dict[str, str] | None = None,
+                       timeout: float = 10.0) -> dict[str, float]:
+    """The bias map {token id: -100} for the single-token words, from the server's /tokenize (cached per server)."""
+    key = base_url.rstrip("/") + "|" + str(model)
+    if key in _NOWAIT_CACHE:
+        return _NOWAIT_CACHE[key]
+    bias: dict[str, float] = {}
+    report: dict[str, list[int]] = {}
+    for word in _nowait_words():
+        r = requests.post(base_url.rstrip("/") + "/tokenize",
+                          json={"model": model, "prompt": word, "add_special_tokens": False},
+                          headers=headers or {}, timeout=timeout)
+        r.raise_for_status()
+        tokens = [int(t) for t in (r.json().get("tokens") or [])]
+        report[word] = tokens
+        if len(tokens) == 1:
+            bias[str(tokens[0])] = -100.0
+    _NOWAIT_CACHE[key] = bias
+    _NOWAIT_REPORT[key] = report
+    log.warning("nowait logit bias: %d single-token words of %d: %s", len(bias), len(report),
+                {w: t for w, t in report.items()})
+    return bias
+
