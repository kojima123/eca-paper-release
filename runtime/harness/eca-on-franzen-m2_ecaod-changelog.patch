+# --- SIMPLAN-2b methods (kojimatech 2026-10-17, docs/simplan2_2026-10-17.md section 9) --------------------------
+def _ta_simplan2_level_now(self) -> bool:
+    b = self._simplan2_budget
+    if b.get("level") is not None and b.get("level") != self._simplan2_current_level:
+        self._simplan2_budget = {"level": None}  # a new level: no task, no lock
+    return self._simplan2_budget.get("level") is not None
+
+
+def _ta_simplan2_options(self) -> dict[str, Any]:
+    self._simplan2_level_now()
+    return {"border": int(self._simplan2_border), "locked": str(self._simplan2_budget.get("locked") or "")}
+
+
+def _ta_simplan2_opener(self, note: str | None) -> str | None:
+    import time as _t
+    active = self._simplan2_level_now()
+    if note and self._simplan2_task_level is not None and self._simplan2_task_level == self._simplan2_current_level:
+        if not active:
+            self._simplan2_budget = {"level": self._simplan2_task_level, "started": self._simplan2_active_now(), "verify": 0,
+                                     "found": False, "locked": ""}
+        elif self._simplan2_budget.get("locked"):
+            note = None  # the repeat of the task on a level whose budget is used would contradict the budget line
+    why = _simplan2_budget_step(self._simplan2_budget, [], self._simplan2_active_now(), _simplan2_verify_cap(),
+                                _simplan2_seconds_cap())
+    if why:
+        self._simplan2_lock_recorded(why)
+    budget_note, self._simplan2_budget_note = self._simplan2_budget_note, None
+    if budget_note:
+        note = budget_note if not note else str(note) + "\n" + budget_note
+    return note
+
+
+def _ta_simplan2_lock_recorded(self, why: str, state_path: Path | None = None) -> None:
+    self._simplan2_budget_note = _SIMPLAN2_BUDGET_TEXT.format(why=why)
+    self._simplan_stats["budget_locks"] = self._simplan_stats.get("budget_locks", 0) + 1
+    path = state_path or getattr(self, "_simplan2_state_path", None)
+    if path is not None:
+        _simplan_record(path, [{"fn": "budget_lock", "level": self._simplan2_budget.get("level"), "why": why}],
+                        self._simplan_stats, bool(self._save_request_logs))
+
+
+def _ta_simplan2_after_snippet(self, state_path: Path, entries: list[dict[str, Any]]) -> None:
+    import time as _t
+    self._simplan2_state_path = state_path
+    for e in entries:
+        if e.get("fn") in ("verify_model", "find_plan") and not e.get("refused") and "border" in e:
+            try:
+                self._simplan2_border = int(e.get("border") or 0)
+            except (TypeError, ValueError):
+                pass
+    if self._simplan2_level_now():
+        why = _simplan2_budget_step(self._simplan2_budget, entries, self._simplan2_active_now(), _simplan2_verify_cap(),
+                                    _simplan2_seconds_cap())
+        if why:
+            self._simplan2_lock_recorded(why, state_path)
+
+
+def _ta_simplan2_active_now(self) -> float:
+    import time as _t
+    t0 = getattr(self, "_simplan2_turn_t0", None)
+    return float(getattr(self, "_simplan2_active_seconds", 0.0)) + (_t.monotonic() - t0 if t0 is not None else 0.0)
+
+
+_TA_ANALYZE_BEFORE_SIMPLAN2B = ToolAgent.analyze
+
+
+def _ta_analyze_timed(self, *args, **kwargs):
+    """SIMPLAN-2b: time each analyzer turn (only when ECA_FRZ_SIMPLAN2 is on; otherwise the original call)."""
+    if not _simplan2_enabled():
+        return _TA_ANALYZE_BEFORE_SIMPLAN2B(self, *args, **kwargs)
+    import time as _t
+    self._simplan2_turn_t0 = _t.monotonic()
+    try:
+        return _TA_ANALYZE_BEFORE_SIMPLAN2B(self, *args, **kwargs)
+    finally:
+        self._simplan2_active_seconds = float(getattr(self, "_simplan2_active_seconds", 0.0)) + (
+            _t.monotonic() - self._simplan2_turn_t0)
+        self._simplan2_turn_t0 = None
+
+
+ToolAgent._simplan2_active_now = _ta_simplan2_active_now
+ToolAgent.analyze = _ta_analyze_timed
+ToolAgent._simplan2_level_now = _ta_simplan2_level_now
+ToolAgent._simplan2_options = _ta_simplan2_options
+ToolAgent._simplan2_opener = _ta_simplan2_opener
+ToolAgent._simplan2_lock_recorded = _ta_simplan2_lock_recorded
+ToolAgent._simplan2_after_snippet = _ta_simplan2_after_snippet
