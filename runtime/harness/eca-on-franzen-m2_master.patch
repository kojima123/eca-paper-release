+                if self.mode == "drop" or dst in self.unreachable:
+                    return None
+                if not self._fresh(src):
+                    self.stats["reset_requests"] += 1
+                    return None
+                traj = self.first.get(dst)
+                if traj is None or not traj[0] or any(k not in graph for k in traj[1]):
+                    self.stats["no_trajectory"] += 1
+                    self.unreachable.add(dst)
+                    self.stats["unreachable"] += 1
+                    return None
+                acts, keys = traj
+                prev = src
+                for a, k in zip(acts, keys):
+                    if graph[prev]["edges"].get(a) != k:
+                        graph[prev]["edges"][a] = k
+                        self.stats["overwritten"] += 1
+                    prev = k
+                self.stats["traj_walks"] += 1
+                self.inflight = dict(dst=dst, path=list(acts), i=0, kind="traj")
+                return list(acts)
+            path = original(graph, src, dst)
+            if path:
+                self.stats["walks"] += 1
+                self.inflight = dict(dst=dst, path=list(path), i=0, kind="bfs")
+            return path
+        return bfs_path
+
+
+# --- vendored: flyexec_explore_run.py `bfs_path` ----------------------------------------------------------------------
+def _bfs_path(graph, src, dst):
+    prev = {src: None}
+    q = collections.deque([src])
+    while q:
+        u = q.popleft()
+        if u == dst:
+            path = []
+            while prev[u] is not None:
+                pu, a = prev[u]
+                path.append(a)
+                u = pu
+            return list(reversed(path))
+        for a, v in graph.get(u, {}).get("edges", {}).items():
+            if v not in prev and v in graph:
+                prev[v] = (u, a)
+                q.append(v)
+    return None
+
+
+# --- vendored: flyexec_carrydead_instr.py `pick_target` (mode dfs only) ----------------------------------------------
+def _pick_target_dfs(graph, depth, order, k, mode):
+    if graph.get(k, {}).get("untried"):
+        return k
+    best = None
+    for cand in order:
+        if graph[cand]["untried"] and (best is None or depth[cand] > depth[best]):
+            best = cand
+    return best
+
+
+# --- vendored: arcgym/heldout/_explorer.py `_nearest_rule`, `_relation`, `_habit_order` -------------------------------
+def _nearest_rule(control):
+    def pick(graph, depth, order, k, mode):
+        if graph.get(k, {}).get("untried"):
+            return k
+        seen, q = {k}, collections.deque([k])
+        while q:
+            u = q.popleft()
+            for _a, v in graph[u]["edges"].items():
+                if v in seen or v not in graph:
+                    continue
+                seen.add(v)
+                if graph[v]["untried"]:
+                    return v
+                q.append(v)
+            if len(seen) > 5000:            # the scan bound REACH8B registered; it never fired there
+                break
+        return control(graph, depth, order, k, mode)
+    return pick
+
+
+def _relation(previous, candidate) -> str:
+    if tuple(candidate) == tuple(previous):
+        return "repeat"
+    if previous[0] in _OPPOSITE_ARROW and candidate[0] == _OPPOSITE_ARROW[previous[0]]:
+        return "reverse"
+    return "other"
+
+
+def _habit_order(actions, previous):
+    if previous is None or len(actions) < 2:
+        return actions
+    return [a for _, a in sorted(enumerate(actions), key=lambda ia: (HABIT_RANK[_relation(previous, ia[1])], ia[0]))]
+
+
+class Level1Explorer:
+    """FL on one play. See the module docstring for `step` / `reset` and the stop rules."""
+
+    def __init__(self, step: Callable[[int, int | None, int | None], Any], reset: Callable[[], Any], *,
+                 budget: int = 4000, time_cap: float = 1800.0, should_stop: Callable[[], bool] | None = None,
+                 stop_at_level_up: bool = True, on_action: Callable[[tuple, Any], None] | None = None,
+                 submit_first: bool = False):
+        self._step_fn, self._reset_fn = step, reset
+        self.budget, self.time_cap = int(budget), float(time_cap)
+        self._should_stop = should_stop
+        self.stop_at_level_up = bool(stop_at_level_up)
+        self._on_action = on_action
+        self.spent = 0
+        self.observation = None
+        self.hud: frozenset = frozenset()
+        self.dead: dict = {}
+        self.level_ups: list = []
+        self.order = ClickOrder("rank", gate=2, seed=20261001, interleave=4, interleave_level1_only=True,
+                                submit_first=submit_first)
+        self.repair = TravelRepair("traj")
+        self.bfs_path = self.repair.bfs(_bfs_path)
+        self.play: dict = {}
+        self.st: dict = {}
+        self.stats: dict = {}
+        self.start_levels = 0
+
+    # -- the instrument's base functions (flyexec_explore_run.py / flyexec_carrydead_instr.py) ------------------------
+    def set_hud(self, obs) -> frozenset:
+        fr = obs.frame
+        try:
+            self.hud = status_bar_cells(np.asarray(fr[-1], dtype=np.int16), _valued_components) if len(fr) else frozenset()
+        except Exception:
+            self.hud = frozenset()
+        return self.hud
+
+    def key_of(self, obs):
+        fr = obs.frame
+        last = np.asarray(fr[-1], dtype=np.int16) if len(fr) else np.zeros((0,), np.int16)
+        if last.ndim == 2 and self.hud:
+            last = last.copy()
+            for (x, y) in self.hud:
+                if 0 <= y < last.shape[0] and 0 <= x < last.shape[1]:
+                    last[y, x] = -1
+        return (int(obs.levels_completed), hashlib.sha256(last.tobytes() + bytes(str(last.shape), "ascii")).hexdigest()[:20])
+
+    def _actions_for_raw(self, obs):
+        """carrydead_instr.actions_for with REACH_MODE=components, DEADSITE=order, CARRY=0."""
+        avail = [int(a) for a in obs.available_actions]
+        acts = [(a, None, None) for a in (1, 2, 3, 4, 5) if a in avail]
+        if 6 in avail and len(obs.frame):
+            fr = np.asarray(obs.frame[-1])
+            hud = self.hud
+            sites = []
+            try:
+                comps = _valued_components(fr)
+            except Exception:
+                comps = []
+            rows = []
+            for comp in comps:
+                try:
+                    cx, cy, area = int(comp["cx"]), int(comp["cy"]), int(comp.get("area", 0))
+                except Exception:
+                    continue
+                if (cx, cy) in hud:
+                    continue
+                rows.append((area, cx, cy))
+            rows.sort()
+            seen = set()
+            for _, cx, cy in rows:
+                if (cx, cy) in seen:
+                    continue
+                seen.add((cx, cy))
+                sites.append((cx, cy))
+            if sites:
+                ranked = list(enumerate(sites))
+                ranked.sort(key=lambda ip: (self.dead.get(ip[1], 0), ip[0]))
+                sites = [p for _, p in ranked]
+            acts.extend((6, x, y) for (x, y) in sites)
+        return acts
+
+    def actions_for(self, obs):
+        """The habit wrapper explore_within_budget(habit=True) installs."""
+        return _habit_order(self._actions_for_raw(obs), self.play["last"])
+
+    # -- the hooks the FL composition installs (heldout Context + explore_within_budget + _explore_fv) ---------------
+    def _charge_check(self) -> None:
+        if self.spent >= self.budget:
+            raise StopExplorer("budget")
+        if self._should_stop is not None and self._should_stop():
+            raise StopExplorer("stopped")
+
+    def do(self, action):
+        """explore_within_budget.do -> Context.step -> _explore_fv.do -> the engine step."""
+        self._charge_check()
+        k0 = self.key_of(self.observation)
+        a = tuple(action)
+        o = self._step_fn(a[0], a[1], a[2])
+        if o is not None:
+            if int(o.levels_completed) > (self.level_ups[-1][0] if self.level_ups else self.start_levels):
+                self.level_ups.append([int(o.levels_completed), self.spent + 1])
+            k1 = self.key_of(o)
+            game_over = str(o.state).endswith("GAME_OVER")
+            levelled = int(o.levels_completed) > self.st["maxlv"]
+            self.order.note(a, o, self.spent + 1, levelled)
+            self.repair.note(a, k0, k1, game_over, levelled)
+            if not game_over:
+                self.order.note_arrival(k1)
+            if levelled:
+                self.st["maxlv"] = int(o.levels_completed)
+        self.spent += 1
+        if o is None:
+            raise RuntimeError("the environment returned None at action %d" % self.spent)
+        self.observation = o
+        if self._on_action is not None:
+            self._on_action(a, o)
+        levels = int(o.levels_completed)
+        self.play["max_levels"] = max(self.play["max_levels"], levels)
+        if levels != self.play["levels"]:
+            self.play["levels"], self.play["last"] = levels, None
+        else:
+            self.play["last"] = a
+        if self.stop_at_level_up and levels > self.start_levels:
+            raise StopExplorer("level_up")
+        return o
+
+    def reset_env(self):
+        """explore_within_budget.reset -> _explore_fv.reset -> Context.reset -> the engine RESET."""
+        self._charge_check()
+        o = self._reset_fn()
+        self.spent += 1
+        if o is not None:
+            self.observation = o
+            self.repair.note_reset(self.key_of(o))
+            self.order.note_arrival(self.key_of(o))
+        if self._on_action is not None:
+            self._on_action((0, None, None), o)
+        self.play["last"] = None
+        if o is not None:
+            self.play["levels"] = int(o.levels_completed)
+        return o
+
+    def _make_pick(self):
+        control = _pick_target_dfs
+        near = _nearest_rule(control)
+
+        def level1(graph, depth, order, k, mode):
+            if self.play["max_levels"] == 0 and self.spent - self.play["start"] >= LEVEL1_NEAREST_AFTER:
+                return near(graph, depth, order, k, mode)
+            return control(graph, depth, order, k, mode)
+        return self.order.wrap(level1)
+
+    # -- the play --------------------------------------------------------------------------------------------------
+    def run(self, obs0) -> dict:
+        """Play from `obs0` until a stop rule fires; returns a report (never raises StopExplorer)."""
+        self.observation = obs0
+        self.start_levels = int(obs0.levels_completed)
+        self.st = dict(maxlv=int(obs0.levels_completed))
+        self.set_hud(obs0)                                   # _explore_fv: the mask the explorer will set
+        self.repair.note_reset(self.key_of(obs0))
+        self.order.note_arrival(self.key_of(obs0))
+        self.play = dict(start=self.spent, levels=int(obs0.levels_completed), max_levels=int(obs0.levels_completed),
+                         last=None)
+        pick = self._make_pick()
+        t0 = time.time()
+        stop = "BUDGET"
+        try:
+            stop = self._explore(obs0, pick, t0)
+        except StopExplorer as exc:
+            stop = exc.reason
+        return dict(stop=stop, actions=self.spent, level_ups=list(self.level_ups),
+                    levels=int(self.observation.levels_completed) if self.observation is not None else None,
+                    secs=round(time.time() - t0, 3), click_order=dict(self.order.stats),
+                    gate_open_at=self.order.gate_open_at, gate_closed_at=self.order.gate_closed_at,
+                    travel_repair=dict(self.repair.stats), **self.stats)
+
+    def _explore(self, obs0, pick_target, t0) -> str:
+        """flyexec_carrydead_instr.explore with env0/obs0 given (since_reset starts at 1) and spent0 = 0."""
+        obs = obs0
+        self.set_hud(obs)
+        steps = resets = mismatches = expansions = travel = 0
+        reopens = retries = 0
+        retry_left: dict = {}
+        self.dead.clear()
+        lv = int(obs.levels_completed)
+        since_reset = 1
+        graph, depth, order = {}, {}, []
+        level_start = self.key_of(obs)
+        actions_for = self.actions_for
+
+        def node(k, o, d):
+            nonlocal reopens
+            terminal = str(o.state).endswith("GAME_OVER") or str(o.state).endswith("WIN")
+            if k not in graph:
+                graph[k] = dict(untried=([] if terminal else actions_for(o)), edges={}, born_terminal=terminal)
+                depth[k] = d
+                order.append(k)
+            elif graph[k].get("born_terminal") and not terminal:
+                graph[k]["untried"] = [a for a in actions_for(o) if a not in graph[k]["edges"]]
+                graph[k]["born_terminal"] = False
+                reopens += 1
+            return graph[k]
+
+        def record():
+            self.stats.update(resets=resets, mismatches=mismatches, expansions=expansions, travel=travel,
+                              reopens=reopens, retries=retries, states=len(graph))
+
+        node(level_start, obs, 0)
+        stop = "BUDGET"
+        try:
+            while steps < LOOP_BUDGET and time.time() - t0 < self.time_cap:
+                st = str(obs.state)
+                if st.endswith("WIN"):
+                    stop = "WIN"
+                    break
+                if st.endswith("GAME_OVER"):
+                    obs = self.reset_env()
+                    steps += 1
+                    resets += 1
+                    since_reset = 0
+                    k0 = self.key_of(obs)
+                    if k0 != level_start:
+                        mismatches += 1
+                        level_start = k0
+                        node(k0, obs, 0)
+                    continue
+                k = self.key_of(obs)
+                node(k, obs, depth.get(k, 10 ** 6))
+                target = pick_target(graph, depth, order, k, "dfs")
+                if target is None:
+                    stop = "EXHAUSTED"
+                    break
+                if target != k:
+                    path = self.bfs_path(graph, k, target)
+                    if path is None:
+                        if since_reset == 0:
+                            a = graph[k]["untried"].pop(0) if graph[k]["untried"] else actions_for(obs)[0]
+                            obs = self.do(a)
+                            steps += 1
+                            since_reset += 1
+                            expansions += 1
+                            graph[k]["edges"][a] = self.key_of(obs)
+                            node(self.key_of(obs), obs, depth[k] + 1)
+                            if RETRY_MAX and str(obs.state).endswith("GAME_OVER"):
+                                left = retry_left.get((k, a), RETRY_MAX)
+                                if left > 0:
+                                    retry_left[(k, a)] = left - 1
+                                    graph[k]["untried"].append(a)
+                                    retries += 1
+                            continue
+                        obs = self.reset_env()
+                        steps += 1
+                        resets += 1
+                        since_reset = 0
+                        k = self.key_of(obs)
+                        if k != level_start:
+                            mismatches += 1
+                            level_start = k
+                            node(k, obs, 0)
+                        path = self.bfs_path(graph, k, target)
+                        if path is None:
+                            graph[target]["untried"] = []
+                            continue
+                    ok = True
+                    for a in path:
+                        expected = graph[self.key_of(obs)]["edges"].get(a)
+                        obs = self.do(a)
+                        steps += 1
+                        travel += 1
+                        since_reset += 1
+                        if self.key_of(obs) != expected:
+                            mismatches += 1
+                            ok = False
+                            break
+                        if str(obs.state).endswith("GAME_OVER") or int(obs.levels_completed) > lv:
+                            break
+                    if not ok or str(obs.state).endswith("GAME_OVER") or int(obs.levels_completed) > lv:
+                        if int(obs.levels_completed) <= lv:
+                            continue
+                if int(obs.levels_completed) <= lv:
+                    k = self.key_of(obs)
+                    if k != target:
+                        continue
+                    a = graph[k]["untried"].pop(0)
+                    obs = self.do(a)
+                    steps += 1
+                    since_reset += 1
+                    expansions += 1
+                    k2 = self.key_of(obs)
+                    graph[k]["edges"][a] = k2
+                    node(k2, obs, depth[k] + 1)
+                    if a[1] is not None:
+                        _site = (a[1], a[2])
+                        if k2 == k:
+                            self.dead[_site] = self.dead.get(_site, 0) + 1
+                        else:
+                            self.dead[_site] = 0
+                    if RETRY_MAX and str(obs.state).endswith("GAME_OVER"):
+                        left = retry_left.get((k, a), RETRY_MAX)
+                        if left > 0:
+                            retry_left[(k, a)] = left - 1
+                            graph[k]["untried"].append(a)
+                            retries += 1
+                if int(obs.levels_completed) > lv:
+                    lv = int(obs.levels_completed)
+                    since_reset = 0
+                    graph, depth, order = {}, {}, []
+                    level_start = self.key_of(obs)
+                    node(level_start, obs, 0)
+            else:
+                stop = "BUDGET" if steps >= LOOP_BUDGET else "TIME"
+        finally:
+            record()
+        return stop
