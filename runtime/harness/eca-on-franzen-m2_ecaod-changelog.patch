+def restore_constants(sources, namespace):
+    """Retained variables (kojimatech 10-31): rebind each `name = <literal>` source in the namespace before the
+    snippet runs. Only literal_eval is used, so nothing is executed; a name that collides with a provided global or
+    builtin is refused. Returns the kept sources by name and the rejections."""
+    kept, rejected = {}, []
+    builtins_ = namespace.get('__builtins__')
+    provided = set(namespace) | set(builtins_ if isinstance(builtins_, dict) else vars(builtins_) if builtins_ else {})
+    for source in sources:
+        name = '<unknown>'
+        try:
+            tree = ast.parse(str(source), '<retained>', 'exec')
+            node = tree.body[0] if tree.body else None
+            if (len(tree.body) != 1 or not isinstance(node, ast.Assign) or len(node.targets) != 1
+                    or not isinstance(node.targets[0], ast.Name)):
+                raise ValueError('only `name = <literal>` sources are retained')
+            name = node.targets[0].id
+            if name in provided:
+                raise ValueError('name conflicts with a provided global or builtin')
+            namespace[name] = ast.literal_eval(node.value)
+            kept[name] = str(source)
+        except Exception as exc:
+            rejected.append(_rejection(name, str(exc)[:180]))
+    return kept, rejected
+
+
+def collect_constants(code_text, previous, namespace, provided, max_chars=CONSTANT_MAX_CHARS):
+    """After the snippet ran: a name first bound by a top-level `name = <literal>` assignment is tracked, and its
+    live value is carried to the next call while it is still a plain literal value under max_chars. A tracked name
+    rebound by a computed top-level assignment in this snippet, deleted, no longer literal, or past the cap is
+    dropped with a reason. Names starting with '_' are never tracked."""
+    try:
+        tree = ast.parse(code_text, '<python_tool>')
+    except SyntaxError:
+        tree = ast.Module(body=[], type_ignores=[])
+    declared, computed = {}, set()
+    for node in tree.body:
+        if isinstance(node, ast.Assign) and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name):
+            name = node.targets[0].id
+            try:
+                ast.literal_eval(node.value)
+            except Exception:
+                computed.add(name)
+                declared.pop(name, None)
+            else:
+                declared[name] = True
+                computed.discard(name)
+    kept, rejected = {}, []
+    for name in dict.fromkeys([*previous, *declared]):
+        if name.startswith('_'):
+            continue
+        if name in provided:
+            rejected.append(_rejection(name, 'name conflicts with a provided global or builtin'))
+            continue
+        if name in computed:
+            rejected.append(_rejection(name, 'rebound to a computed value in this call; pass it as an argument or assign a literal'))
+            continue
+        if name not in namespace:
+            rejected.append(_rejection(name, 'was deleted or the assignment was not reached'))
+            continue
+        source = _literal_source(name, namespace[name])
+        if source is None:
+            rejected.append(_rejection(name, 'is no longer a plain literal value'))
+            continue
+        if len(source) > max_chars:
+            rejected.append(_rejection(name, 'exceeds %d characters' % max_chars))
+            continue
+        kept[name] = source
+    return kept, rejected
