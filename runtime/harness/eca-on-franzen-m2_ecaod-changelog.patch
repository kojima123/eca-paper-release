+    def _modeler_after_snippet(self, sandbox_result: dict[str, Any], before: dict[str, Any] | None) -> None:
+        """Fold one snippet's checked-action counts into the level and game counters; note whether the snippet
+        acted or changed the kept operating model (the host step runs on either)."""
+        try:
+            st = sandbox_result.get("modeler") or {}
+            m = self._modeler
+            for k, v in st.items():
+                self._modeler_stats[k] = self._modeler_stats.get(k, 0) + int(v or 0)
+            m["probes_used"] = int(m.get("probes_used") or 0) + int(st.get("probes") or 0)
+            if self._modeler_host_call:
+                return
+            executed = int(st.get("executed") or 0) or sum(
+                1 for a in (sandbox_result.get("action_results") or []) if isinstance(a, dict) and a.get("executed"))
+            if executed > 0:
+                m["idle_calls"] = 0
+                m["noact_turns"] = 0
+            else:
+                m["noact_turns"] = int(m.get("noact_turns") or 0) + 1
+            if int(st.get("executed") or 0) > 0:
+                pass
+            elif int(st.get("refused") or 0) > 0:
+                m["idle_calls"] = int(m.get("idle_calls") or 0) + 1
+            if not m.get("relief") and int(m.get("idle_calls") or 0) >= _modeler_relief_turns():
+                m["relief"] = True
+                self._modeler_stats["relief"] = self._modeler_stats.get("relief", 0) + 1
+            kept = getattr(self, "_kept_functions", None) or {}
+            keep = (bool(m.get("changed")) and _modeler_gate_enabled() and not m.get("gate_open")) \
