+class ClickOrder:
+    def __init__(self, mode: str = "rank", gate: int | None = None, seed: int = 0, interleave: int | None = None,
+                 interleave_level1_only: bool = False, submit_first: bool = False):
+        if mode not in MODES:
+            raise ValueError("mode must be one of %s" % (MODES,))
+        if interleave is not None and int(interleave) < 1:
+            raise ValueError("interleave must be a positive int or None")
+        self.mode, self.gate_k, self.seed = mode, gate, int(seed)
+        self.interleave = int(interleave) if interleave is not None else None
+        self.interleave_level1_only = bool(interleave_level1_only)
+        # XS submit-first (kojimatech, 2026-10-03; ECA-XPAINT2 premise fe71876d, 10 lines in fv_layer._fg_split): while the
+        # gate is open, every board's kept click is moved to the FRONT of its untried actions, so each newly reached
+        # board is tested with one click before its keys are expanded (where every click either dies or completes the
+        # level, the click is a submit, and keys-first expansion never reaches the shallow submit). Default off = FL.
+        self.submit_first = bool(submit_first)
+        self.level_ups = 0
+        self.lethal = self.other = 0
+        self.lethal_active = 0
+        self.due = 0
+        self.arrivals = {}
+        self.gate_open_at = self.gate_closed_at = None
+        self.stats = dict(boards=0, split=0, held=0, released=0, releases=0, dropped=0, drips=0)
+        if self.submit_first:
+            self.stats["submit_first"] = 0
+        self._new_graph(None)
+
+    def _new_graph(self, graph):
+        self.graph = graph
+        self.first = {}          # board key -> its actions at first sight (explorer order)
+        self.kept = {}           # board key -> the click kept (None if the board had no click)
+        self.held = {}           # board key -> clicks taken out of untried, in the recorded order
+        self.unsplit = []        # boards seen but not split yet (seen while the order was inactive)
+        self.pending = set()     # boards seen without untried actions (born terminal): first sight comes later
+        self.n_order = 0         # how much of the explorer's creation order has been read
+
+    @property
+    def active(self) -> bool:
+        if self.mode == "off":
+            return False
+        if self.gate_k is None:
+            return True
+        return self.gate_open_at is not None and self.gate_closed_at is None
