+    def note(self, action, obs, at: int, levelled: bool) -> None:
+        """After every action: a click's outcome feeds the gate (a level-up click counts neither way)."""
+        if levelled:
+            self.level_ups += 1
+            if self.interleave_level1_only:
+                self.due = 0
+        if action[0] != 6 or obs is None or levelled:
+            return
+        if str(obs.state).endswith("GAME_OVER"):
+            self.lethal += 1
+            if self.interleave is not None and self.active and not (self.interleave_level1_only and self.level_ups):
+                self.lethal_active += 1
+                if self.lethal_active % self.interleave == 0:
+                    self.due = 1
+            if (self.gate_open_at is None and self.gate_closed_at is None and self.gate_k is not None
+                    and self.lethal >= self.gate_k and self.other == 0):
+                self.gate_open_at = at
+        else:
+            self.other += 1
+            if self.gate_closed_at is None:
+                self.gate_closed_at = at
+
+    def note_arrival(self, key) -> None:
+        """The play arrived alive at this board (a step's landing or a RESET); counted for the P21 interleave."""
+        self.arrivals[key] = self.arrivals.get(key, 0) + 1
+
+    def _drip(self, graph) -> None:
+        """P21: give one held click back to the most-visited board whose kept click is exhausted."""
+        best = None
+        for i, key in enumerate(self.first):
+            clicks = self.held.get(key)
+            if not clicks or key not in graph:
+                continue
+            if any(a[0] == 6 for a in graph[key]["untried"]):
+                continue
+            rank = (-self.arrivals.get(key, 0), i)
+            if best is None or rank < best[0]:
+                best = (rank, key)
+        if best is None:
+            return
+        key = best[1]
+        graph[key]["untried"].append(self.held[key].pop(0))
+        self.due = 0
+        self.stats["drips"] += 1
+
+    def _choose(self, key, clicks):
+        if not clicks:
+            return None
+        if self.mode == "random":
+            rng = random.Random(zlib.crc32(repr((self.seed, key)).encode("utf-8")))
+            return clicks[rng.randrange(len(clicks))]
+        return clicks[0]
+
+    def _see(self, key, board) -> bool:
+        if not board["untried"]:
+            self.pending.add(key)
+            return False
+        self.pending.discard(key)
+        acts = [tuple(a) for a in board["untried"]]
+        self.first[key] = acts
+        self.kept[key] = self._choose(key, [a for a in acts if a[0] == 6])
+        self.unsplit.append(key)
+        self.stats["boards"] += 1
+        return True
+
+    def _split(self, key, board):
+        """Hold every untried click of the board but the kept one."""
+        keep = self.kept.get(key)
+        untried = board["untried"]
+        hold = [a for a in untried if a[0] == 6 and tuple(a) != keep]
+        if hold:
+            board["untried"] = [a for a in untried if not (a[0] == 6 and tuple(a) != keep)]
+            self.held.setdefault(key, []).extend(hold)
+            self.stats["held"] += len(hold)
+        if self.submit_first and keep is not None:
+            untried = board["untried"]
+            at = next((i for i, a in enumerate(untried) if tuple(a) == keep), None)
+            if at is not None and at > 0:
+                untried.insert(0, untried.pop(at))        # the board is tested with its click first (XS)
+                self.stats["submit_first"] += 1
+        self.stats["split"] += 1
+
+    def _cleared(self, key, board) -> bool:
+        if board["untried"]:
+            return False
+        tried = {tuple(a) for a in board["edges"]}
+        keep = self.kept.get(key)
+        kept_actions = [a for a in self.first.get(key, []) if a[0] != 6 or a == keep]
+        return any(a not in tried for a in kept_actions)
+
+    def _release(self, graph) -> bool:
+        back = 0
+        for key, clicks in self.held.items():
+            if not clicks or key not in graph:
+                continue
+            board = graph[key]
+            if self._cleared(key, board):
+                self.stats["dropped"] += len(clicks)
+                continue
+            board["untried"].extend(clicks)
+            back += len(clicks)
+        self.held = {}
+        if back:
+            self.stats["released"] += back
+            self.stats["releases"] += 1
+        return bool(back)
+
+    def sync(self, graph, order) -> None:
+        if graph is not self.graph:
+            self._new_graph(graph)
+        for key in order[self.n_order:]:
+            if key in graph:
+                self._see(key, graph[key])
+        self.n_order = len(order)
+        for key in [k for k in self.pending if k in graph and graph[k]["untried"]]:
+            self._see(key, graph[key])
+        if self.active:
+            for key in self.unsplit:
+                if key in graph:
+                    self._split(key, graph[key])
+            self.unsplit = []
+            if self.interleave is not None and self.due and not (self.interleave_level1_only and self.level_ups):
+                self._drip(graph)
+        elif self.held:
+            self._release(graph)
+
+    def wrap(self, inner):
+        def pick(graph, depth, order, k, mode):
+            self.sync(graph, order)
+            target = inner(graph, depth, order, k, mode)
+            if target is None and self.held and self._release(graph):
+                target = inner(graph, depth, order, k, mode)
+            return target
+        return pick
