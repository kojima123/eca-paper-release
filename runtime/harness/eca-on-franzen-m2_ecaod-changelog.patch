+            _okb = (_repb["board_checks"] > 0 and _repb["false_deaths"] == 0 and _repb["deaths_missed"] == 0
+                    and _repb["errors"] == 0 and _repb["changing_checks"] >= __MINCH__
+                    and 100 * _repb["mismatched"] <= __MISMATCH_PCT__ * _judgedb)
