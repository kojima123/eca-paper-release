+def _eca_lite_uncertified_continuation_violation(
+    *,
+    prior_full_len: int,
+    continuation_certified: bool,
+    grounded_match: bool | None,
+) -> str:
+    """Only bridge a transient certificate loss for a withheld old suffix."""
+
+    if continuation_certified:
+        return ""
+    if grounded_match is not True or int(prior_full_len) <= 1:
+        return "certificate_lost_after_action"
+    return ""
