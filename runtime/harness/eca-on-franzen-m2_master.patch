+        certificate_reason: str,
+        full_plan_len: int,
+        action_count: int,
+        compute_ms: float,
+    ) -> dict[str, Any]:
+        if self.active and (
+            self.active.get("family") != family
+            or int(self.active.get("level", -1)) != int(level)
+        ):
+            self.close(
+                action_count=action_count,
+                level_transition=False,
+                game_over=False,
+                fallback_reason="family_or_level_replaced",
