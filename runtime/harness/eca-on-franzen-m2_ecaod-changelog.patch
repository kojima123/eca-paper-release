+++ b/ARC3-Inference/inference/utils/board_digest.py
@@ -0,0 +1,1133 @@
+"""Board digest (kojimatech 10-29): what an action sequence did, at the level of objects, computed by the harness so
+the model does not spend an inference turn reading it.
+
+61 % of the model's requests in the win-line canon came right after a snippet that executed nothing, two thirds of
+those snippets only re-derived objects, positions, what an action did, or the HUD band. This module states those
+facts once per executed sequence:
+
+  * the object-level change between the frame before the sequence and the frame after it (moved by (dr, dc),
+    appeared, vanished, changed), with edge-band (HUD) changes reported separately;
+  * a per-level effect ledger: for each action, the displacement of the single object that moved with it, and how
+    often that held, or how often it changed nothing inside the board.
+
+Objects are 4-connected same-colour regions excluding the most frequent colour. Coordinates are (row, col) of the
+top-left of the region's bounding box, as the model's own snippets use them. Facts only, no advice.
+"""
+from __future__ import annotations
+
+import re
+from collections import Counter, defaultdict
+from typing import Iterable, Sequence
+
+LETTERS = "WwgGcBMPRbSYOrNp"
+Grid = Sequence[Sequence[int]]
+MAX_OBJECTS = 6
+MAX_CHARS = 700
+LARGE = 200          # cells: a same-colour region this big that only changes shape is floor, not an object
+
+
+def _letter(v: int) -> str:
+    return LETTERS[v] if 0 <= int(v) < 16 else "?"
+
+
+def components(grid: Grid, *, border: int = 0) -> list[tuple[int, tuple[int, int], frozenset]]:
+    """(colour, top-left, shape) per 4-connected same-colour region, background (most frequent colour) excluded.
+    `shape` is the region's cells relative to its top-left. Cells within `border` of the edge are ignored."""
+    h = len(grid)
+    w = max((len(r) for r in grid), default=0)
+    if not h or not w:
+        return []
+    bg = Counter(v for r in grid for v in r).most_common(1)[0][0]
+    seen = [[False] * w for _ in range(h)]
+    out = []
+    for r0 in range(border, h - border):
+        for c0 in range(border, w - border):
+            v = grid[r0][c0]
+            if seen[r0][c0] or v == bg:
+                continue
+            stack = [(r0, c0)]
+            seen[r0][c0] = True
+            cells = []
+            while stack:
+                r, c = stack.pop()
+                cells.append((r, c))
+                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+                    nr, nc = r + dr, c + dc
+                    if border <= nr < h - border and border <= nc < w - border and not seen[nr][nc] \
+                            and grid[nr][nc] == v:
+                        seen[nr][nc] = True
+                        stack.append((nr, nc))
+            tr, tc = min(r for r, _ in cells), min(c for _, c in cells)
+            out.append((int(v), (tr, tc), frozenset((r - tr, c - tc) for r, c in cells)))
+    return out
+
+
+def _size(shape: frozenset) -> str:
+    rows = 1 + max(r for r, _ in shape)
+    cols = 1 + max(c for _, c in shape)
+    n = len(shape)
+    return "%dx%d" % (rows, cols) if n == rows * cols else "%d cells" % n
+
+
+def _changed(a: Grid, b: Grid) -> list[tuple[int, int]]:
+    return [(r, c) for r, (ra, rb) in enumerate(zip(a, b)) for c, (x, y) in enumerate(zip(ra, rb)) if x != y]
+
+
+def object_changes(before: Grid, after: Grid, *, border: int = 4) -> tuple[list[str], list[tuple]]:
+    """Lines describing the object-level change, plus the list of (colour, shape, dr, dc) moves and
+    ('recolour', from, to) entries."""
+    diff = _changed(before, after)
+    if not diff:
+        return ["no cell changed"], []
+    h = len(before)
+    w = max((len(r) for r in before), default=0)
+    inner = [(r, c) for r, c in diff if border <= r < h - border and border <= c < w - border]
+    edge = len(diff) - len(inner)
+    lines: list[str] = []
+    moves: list[tuple] = []
+    recolours: list[tuple] = []
+    if inner:
+        touched = set(inner)
+        ob, oa = components(before, border=border), components(after, border=border)
+
+        def hits(objs):
+            return [o for o in objs if any((o[1][0] + r, o[1][1] + c) in touched for r, c in o[2])]
+
+        hb, ha = hits(ob), hits(oa)
+        used_b: set[int] = set()
+        used_a: set[int] = set()
+        move_idx: list[tuple[int, int]] = []
+        # 1. the same shape and colour elsewhere: moved
+        for i, (v, (r, c), s) in enumerate(hb):
+            match = None
+            for j, (v2, (r2, c2), s2) in enumerate(ha):
+                if j in used_a or v2 != v or s2 != s:
+                    continue
+                d = abs(r2 - r) + abs(c2 - c)
+                if match is None or d < match[0]:
+                    match = (d, j, r2, c2)
+            if match is not None and match[0] > 0:
+                used_b.add(i); used_a.add(match[1])
+                moves.append((v, s, match[2] - r, match[3] - c))
+                move_idx.append((i, match[1]))
+                lines.append("%s %s at (%d,%d) moved by (%+d,%+d)" % (_letter(v), _size(s), r, c, match[2] - r, match[3] - c))
+        # 1b. covered / uncovered: two "moves" by opposite displacements that swap places are a mover walking over a
+        # tile; the tile is the one whose (colour, shape) repeats more on the board, and it is not reported
+        if len(moves) > 1:
+            common = Counter((v, s) for v, _p, s in ob)
+            drop = set()
+            for k, ((v, s, dr, dc), (i, j)) in enumerate(zip(moves, move_idx)):
+                vr, vc = ha[j][1]
+                own_after = {(vr + x, vc + y) for x, y in s}
+                for k2, ((v2, s2, dr2, dc2), (i2, j2)) in enumerate(zip(moves, move_idx)):
+                    if k2 == k or (dr2, dc2) != (-dr, -dc):
+                        continue
+                    r2, c2 = hb[i2][1]
+                    if own_after & {(r2 + x, c2 + y) for x, y in s2} and common[(v, s)] > common[(v2, s2)]:
+                        drop.add(k)
+            moves = [m for k, m in enumerate(moves) if k not in drop]
+            lines = [l for k, l in enumerate(lines) if k not in drop]
+        # 2. the same shape at the same place in another colour: recoloured
+        for i, (v, (r, c), s) in enumerate(hb):
+            if i in used_b:
+                continue
+            for j, (v2, (r2, c2), s2) in enumerate(ha):
+                if j not in used_a and (r2, c2) == (r, c) and s2 == s and v2 != v:
+                    used_b.add(i); used_a.add(j)
+                    recolours.append((v, v2))
+                    lines.append("%s %s at (%d,%d) turned %s" % (_letter(v), _size(s), r, c, _letter(v2)))
+                    break
+        # 3. the same colour, overlapping: reshaped (a large region is the floor the movers cut into: not reported)
+        for i, (v, (r, c), s) in enumerate(hb):
+            if i in used_b:
+                continue
+            cells = {(r + a, c + b) for a, b in s}
+            for j, (v2, (r2, c2), s2) in enumerate(ha):
+                if j in used_a or v2 != v:
+                    continue
+                if cells & {(r2 + a, c2 + b) for a, b in s2}:
+                    used_b.add(i); used_a.add(j)
+                    if max(len(s), len(s2)) <= LARGE:
+                        lines.append("%s region at (%d,%d) changed shape (%d -> %d cells)" % (_letter(v), r, c, len(s), len(s2)))
+                    break
+        large = set()
+        for i, (v, (r, c), s) in enumerate(hb):
+            if i not in used_b:
+                if len(s) > LARGE:
+                    large.add(v)
+                else:
+                    lines.append("%s %s at (%d,%d) vanished" % (_letter(v), _size(s), r, c))
+        for j, (v, (r, c), s) in enumerate(ha):
+            if j not in used_a:
+                if len(s) > LARGE:
+                    large.add(v)
+                else:
+                    lines.append("%s %s appeared at (%d,%d)" % (_letter(v), _size(s), r, c))
+        if large and not lines:
+            lines.append("large " + "/".join(sorted(_letter(v) for v in large)) + " region(s) changed shape")
+        moves = moves + [("recolour", a, b) for a, b in recolours]
+        if len(lines) > MAX_OBJECTS:
+            lines = lines[:MAX_OBJECTS] + ["%d more object changes" % (len(lines) - MAX_OBJECTS)]
+        if not lines:
+            lines.append("%d cells changed inside the board (no whole object)" % len(inner))
+    else:
+        lines.append("nothing changed inside the board")
+    if edge:
+        rows = sorted({r for r, c in diff if not (border <= r < h - border and border <= c < w - border)})
+        lines.append("edge band (HUD): %d cells changed, rows %d-%d" % (edge, rows[0], rows[-1]))
+    return lines, moves
+
+
+def _norm(cells) -> frozenset:
+    r0 = min(r for r, _ in cells)
+    c0 = min(c for _, c in cells)
+    return frozenset((r - r0, c - c0) for r, c in cells)
+
+
+def _turns(shape: frozenset) -> list[tuple[int, frozenset]]:
+    """The shape turned clockwise by 0, 90, 180 and 270 degrees, each normalised to its top-left."""
+    out, s = [], _norm(shape)
+    for k in range(4):
+        out.append((90 * k, s))
+        s = _norm({(c, -r) for r, c in s})
+    return out
+
+
+def _downscaled(shape: frozenset, k: int) -> frozenset | None:
+    """The shape at 1/k size when it is made of whole k x k blocks aligned to its top-left, else None."""
+    s = _norm(shape)
+    if len(s) % (k * k):
+        return None
+    blocks = {(r // k, c // k) for r, c in s}
+    if len(blocks) * k * k != len(s):
+        return None
+    return frozenset(blocks)
+
+
+def shape_relation(target: frozenset, source: frozenset) -> str | None:
+    """How `target` is `source` turned and/or scaled: '' when equal, a phrase such as ' turned 90 degrees clockwise, at
+    twice the size' otherwise; None when it is neither (sizes 1/4 to 4x, the four quarter turns)."""
+    words = {2: "twice", 3: "three times", 4: "four times"}
+    for k in (1, 2, 3, 4):
+        for a, b, scale in ((_downscaled(target, k), _norm(source), k), (_norm(target), _downscaled(source, k), -k)):
+            if a is None or b is None:
+                continue
+            for deg, turned in _turns(b):
+                if turned == a:
+                    parts = []
+                    if deg:
+                        parts.append("turned %d degrees clockwise" % deg)
+                    if scale > 1:
+                        parts.append("at %s the size" % words[scale])
+                    elif scale < -1:
+                        parts.append("at 1/%d the size" % -scale)
+                    return (" " + ", ".join(parts)) if parts else ""
+    return None
+
+
+def completion_facts(before: Grid, settled: Grid, *, border: int = 4, limit: int = 3) -> tuple[list[str], bool]:
+    """What a level-completing action did to the level's own board (solver end facts, kojimatech 11-02): `settled` is the
+    last board of the level in the action's animation, before the next level's board replaced it - a board `history` never
+    holds. When an object that appeared there is an earlier object of the same colour filled in (the earlier object's cells
+    inside it, the rest newly that colour) and the filled cells have the shape of an object that went from elsewhere
+    (equal up to quarter turns and whole-number scaling), that relation is the fact; otherwise the object-level changes.
+    Only the relation with the largest earlier object is kept (the cells a mover vacates can pair with what it covered).
+    Returns (lines, filled_relation_found). Facts only; never raises."""
+    try:
+        changed = set(_changed(before, settled))
+        if not changed:
+            return [], False
+        ob = components(before, border=border)
+        os_ = components(settled, border=border)
+        cells = lambda o: {(o[1][0] + r, o[1][1] + c) for r, c in o[2]}
+        best = None   # (earlier object's size, line): one relation per completion, the largest earlier object filled in
+        for x in os_:
+            if len(x[2]) > LARGE or not (cells(x) & changed):
+                continue
+            xc = cells(x)
+            for o in ob:
+                oc = cells(o)
+                if o[0] != x[0] or len(o[2]) > LARGE or not oc < xc or oc & changed or (best and best[0] >= len(o[2])):
+                    continue
+                filled = xc - oc
+                for m in ob:
+                    mc = cells(m)
+                    if m is o or len(m[2]) > LARGE or not (mc & changed) or mc <= xc:
+                        continue
+                    rel = shape_relation(frozenset(filled), m[2])
+                    if rel is None:
+                        continue
+                    best = (len(o[2]), "%s appeared: the %s filled in solid; the %d cells it gained have the shape of the %s, "
+                                       "which left its place%s." % (_describe(*x), _describe(*o), len(filled), _describe(*m),
+                                                                    ("," + rel) if rel else ""))
+                    break
+        if best:
+            return [best[1]], True
+        lines, _moves = object_changes(before, settled, border=border)
+        return [l for l in lines if not l.startswith("edge band")][:limit], False
+    except Exception as exc:   # facts must never break a turn
+        return ["(end facts unavailable: %s)" % type(exc).__name__], False
+
+
+_MOUSE_RE = re.compile(r"MOUSE\s*\(\s*row\s*=\s*(-?\d+)\s*,\s*col\s*=\s*(-?\d+)\s*\)", re.I)
+
+
+def sweep_candidates(grid: Grid, clicked_cells, *, border: int = 4, limit: int = 10, large: int = LARGE) -> list[dict]:
+    """Sweep (kojimatech 10-31): the objects on the board that nothing has clicked yet on this level, one click point
+    each (the object's cell nearest its bounding-box centre). The background and regions bigger than `large` cells
+    (floor) are skipped; an object containing a clicked cell is skipped. Ordered so that every colour gets a turn
+    before any colour gets a second (larger objects first within a colour), capped at `limit`.
+    Each: {colour, size, at (top-left), cells, row, col}."""
+    clicked = {(int(r), int(c)) for r, c in (clicked_cells or [])}
+    per_colour: dict[str, list[dict]] = defaultdict(list)
+    for v, (tr, tc), shape in components(grid, border=border):
+        if len(shape) > large:
+            continue
+        cells = {(tr + r, tc + c) for r, c in shape}
+        if cells & clicked:
+            continue
+        rows = [r for r, _ in cells]
+        cols = [c for _, c in cells]
+        cr, cc = (min(rows) + max(rows)) / 2.0, (min(cols) + max(cols)) / 2.0
+        row, col = min(cells, key=lambda p: (abs(p[0] - cr) + abs(p[1] - cc), p))
+        per_colour[_letter(v)].append({"colour": _letter(v), "size": _size(shape), "at": [tr, tc], "cells": len(cells),
+                                       "row": int(row), "col": int(col)})
+    for lst in per_colour.values():
+        lst.sort(key=lambda d: (-d["cells"], d["at"]))
+    colours = sorted(per_colour, key=lambda k: (-len(per_colour[k]), k))
+    ordered: list[dict] = []
+    while any(per_colour.values()):
+        for k in colours:
+            if per_colour[k]:
+                ordered.append(per_colour[k].pop(0))
+    # effects table (kojimatech 10-31): one object of each (colour, size) kind before any kind's second object
+    seen_kinds: set = set()
+    firsts, repeats = [], []
+    for d in ordered:
+        kind = (d["colour"], d["size"])
+        (repeats if kind in seen_kinds else firsts).append(d)
+        seen_kinds.add(kind)
+    return (firsts + repeats)[:limit]
+
+
+def effects_table(ledger: "EffectLedger", *, limit: int = 8) -> list[str]:
+    """Effects table (kojimatech 10-31): one line per action key on a level - clicks keyed by the clicked object kind
+    (the ledger's keys) - with the dominant outcome and its share, most used first."""
+    rows = []
+    for key, cnt in sorted(ledger.seen.items(), key=lambda kv: (-sum(kv[1].values()), kv[0])):
+        n = sum(cnt.values())
+        top, m = cnt.most_common(1)[0]
+        label = key[len("MOUSE on "):] if key.startswith("MOUSE on ") else key
+        extra = ""
+        if len(cnt) > 1:
+            others = [o for o, _c in cnt.most_common() if o != top][:2]
+            extra = "; also " + ", ".join(others)
+        rows.append("%s -> %s (%d of %d)%s" % (label, top, m, n, extra))
+    return rows[:limit]
+
+
+def effects_carry_over(ledgers: dict, current_level: int, *, limit: int = 6) -> list[str]:
+    """The effects seen on earlier levels, merged by key, only keys whose dominant outcome changed the board."""
+    merged: dict[str, Counter] = defaultdict(Counter)
+    levels: dict[str, set] = defaultdict(set)
+    for level, ledger in sorted(ledgers.items()):
+        if int(level) >= int(current_level):
+            continue
+        for key, cnt in ledger.seen.items():
+            merged[key].update(cnt)
+            levels[key].add(int(level))
+    rows = []
+    for key, cnt in sorted(merged.items(), key=lambda kv: (-sum(kv[1].values()), kv[0])):
+        top, m = cnt.most_common(1)[0]
+        if top == "no change inside the board":
+            continue
+        n = sum(cnt.values())
+        label = key[len("MOUSE on "):] if key.startswith("MOUSE on ") else key
+        lv = sorted(levels[key])
+        where = "L%d" % lv[0] if len(lv) == 1 else "L%d-L%d" % (lv[0], lv[-1])
+        rows.append("%s -> %s (%d of %d, %s)" % (label, top, m, n, where))
+    return rows[:limit]
+
+
+def unclicked_kinds(ledger: "EffectLedger", grid: Grid, *, limit: int = 8) -> list[str]:
+    """The object kinds on the board with no click on this level, as 'colour size at (r,c)'."""
+    pairs = []
+    for o in state_objects(grid):
+        key = "MOUSE on %s %s" % (o["colour"], o["size"])
+        if key not in ledger.seen and (o["colour"], o["size"]) not in [p[0] for p in pairs]:
+            pairs.append(((o["colour"], o["size"]), tuple(o["at"])))
+    out = ["%s %s at (%d,%d)" % (c, sz, at[0], at[1]) for (c, sz), at in pairs[:limit]]
+    if len(pairs) > limit:
+        out.append("+%d more kinds" % (len(pairs) - limit))
+    return out
+
+
+def _counts(grid: Grid, border: int) -> Counter:
+    h = len(grid)
+    w = max((len(r) for r in grid), default=0)
+    return Counter(_letter(grid[r][c]) for r in range(border, h - border) for c in range(border, min(len(grid[r]), w) - border))
+
+
+def levelup_facts(entries, *, border: int = 4, limit: int = 8) -> list[str]:
+    """Handoff (kojimatech 10-31): what each completed level looked like at its end and what action completed it,
+    from the history alone. Per completed level: actions on it, the completing action (a click named by what it
+    landed on), the non-background colour counts that changed between the level's first and last board, the
+    object count; then, over >= 2 completed levels, the colours that fell on every one and whether every
+    completing click landed on the same colour. Facts only; never raises."""
+    try:
+        levels, cur, prev = [], None, None
+        for e in entries:
+            fr = getattr(e, "frame", None)
+            if fr is None or getattr(fr, "grid", None) is None:
+                continue
+            if cur is None:
+                cur = {"level": int(fr.level), "start": fr.grid, "end": fr.grid, "actions": 0, "start_step": int(fr.step)}
+            elif int(fr.level) != cur["level"]:
+                cur["completing"] = str(getattr(e, "action", "") or "")
+                cur["end_step"] = int(prev.step)
+                levels.append(cur)
+                cur = {"level": int(fr.level), "start": fr.grid, "end": fr.grid, "actions": 0, "start_step": int(fr.step)}
+            else:
+                cur["actions"] += 1
+                cur["end"] = fr.grid
+            prev = fr
+        if not levels:
+            return []
+        lines, fell_all, click_colours = [], None, []
+        for lv in levels[-limit:]:
+            start, end = lv["start"], lv["end"]
+            bg = Counter(v for r in start for v in r).most_common(1)[0][0]
+            cs, ce = _counts(start, border), _counts(end, border)
+            changed = []
+            for ch in sorted(set(cs) | set(ce), key=lambda k: (-(abs(cs.get(k, 0) - ce.get(k, 0))), k)):
+                if ch == _letter(bg) or cs.get(ch, 0) == ce.get(ch, 0):
+                    continue
+                changed.append("%s %d->%d" % (ch, cs.get(ch, 0), ce.get(ch, 0)))
+            fell = {ch for ch in cs if cs.get(ch, 0) > ce.get(ch, 0) and ch != _letter(bg)}
+            fell_all = fell if fell_all is None else (fell_all & fell)
+            act = lv.get("completing") or "?"
+            m = _MOUSE_RE.search(act)
+            if m:
+                tgt = click_target(end, int(m.group(1)), int(m.group(2)), border=border)
+                act = click_phrase(tgt)
+                click_colours.append(tgt.get("colour") if not tgt.get("background") and not tgt.get("edge") else None)
+            else:
+                click_colours.append(None)
+            lines.append("Level %d (%d actions, steps %d-%d) ended with %s; over the level the colour counts went %s; "
+                         "objects %d -> %d." % (lv["level"], lv["actions"], lv["start_step"], lv.get("end_step", lv["start_step"]),
+                                                act, ", ".join(changed[:5]) if changed else "unchanged",
+                                                len(components(start, border=border)), len(components(end, border=border))))
+        if len(levels) >= 2:
+            if fell_all:
+                lines.append("In every completed level so far the count of %s fell before the completing action."
+                             % ", ".join(sorted(fell_all)))
+            cc = [c for c in click_colours if c]
+            if len(cc) == len(levels) and len(set(cc)) == 1:
+                lines.append("Every completing action was a click on a %s object." % cc[0])
+        return lines[:limit + 2]
+    except Exception as exc:   # facts must never break a turn
+        return ["(level-up facts unavailable: %s)" % type(exc).__name__]
+
+
+def click_target(grid: Grid, row: int, col: int, *, border: int = 4) -> dict:
+    """What a click at (row, col) landed on, read from the frame before the click: the 4-connected same-colour
+    region there as {colour, size, at (top-left)}, or {"background": True} on the most frequent colour, or
+    {"edge": True} in the edge band. Clicks mean the object, not the coordinate (user 10-29)."""
+    h = len(grid)
+    w = max((len(r) for r in grid), default=0)
+    if not (0 <= row < h and 0 <= col < len(grid[row])):
+        return {"outside": True, "at": [int(row), int(col)]}
+    v = grid[row][col]
+    bg = Counter(x for r in grid for x in r).most_common(1)[0][0]
+    out = {"colour": _letter(v), "at": [int(row), int(col)]}
+    if not (border <= row < h - border and border <= col < w - border):
+        out["edge"] = True
+        return out
+    if v == bg:
+        out["background"] = True
+        return out
+    seen = {(row, col)}
+    stack = [(row, col)]
+    while stack:
+        r, c = stack.pop()
+        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            nr, nc = r + dr, c + dc
+            if 0 <= nr < h and 0 <= nc < len(grid[nr]) and (nr, nc) not in seen and grid[nr][nc] == v:
+                seen.add((nr, nc))
+                stack.append((nr, nc))
+    tr, tc = min(r for r, _ in seen), min(c for _, c in seen)
+    shape = frozenset((r - tr, c - tc) for r, c in seen)
+    out.update(size=_size(shape), at=[tr, tc], cells=len(seen))
+    return out
+
+
+def click_phrase(target: dict) -> str:
+    if target.get("outside"):
+        return "clicked outside the board"
+    if target.get("edge"):
+        return "clicked the edge band at (%d,%d)" % tuple(target["at"])
+    if target.get("background"):
+        return "clicked background at (%d,%d)" % tuple(target["at"])
+    return "clicked %s %s at (%d,%d)" % (target["colour"], target["size"], target["at"][0], target["at"][1])
+
+
+def ledger_key(action: str, before: Grid | None = None) -> str:
+    """Ledger key: the action name, and for a click the clicked object (colour and size) instead of the coordinate."""
+    key = str(action).split("(", 1)[0].strip().upper() or "?"
+    if key == "MOUSE" and before is not None:
+        m = _MOUSE_RE.search(str(action))
+        if m:
+            t = click_target(before, int(m.group(1)), int(m.group(2)))
+            if t.get("background"):
+                return "MOUSE on background"
+            if t.get("edge") or t.get("outside"):
+                return "MOUSE on the edge band"
+            return "MOUSE on %s %s" % (t["colour"], t["size"])
+    return key
+
+
+_SIG_RULES = (
+    (re.compile(r"^(\S+ \S+(?: cells)?) at \(\d+,\d+\) moved by (\([+-]\d+,[+-]\d+\))$"), r"\1 moved by \2"),
+    (re.compile(r"^(\S+) \S+(?: cells)? at \(\d+,\d+\) turned (\S+)$"), r"\1 turned \2"),
+    (re.compile(r"^(\S+) region at \(\d+,\d+\) changed shape .*$"), r"\1 changed shape"),
+    (re.compile(r"^(\S+) \S+(?: cells)? at \(\d+,\d+\) vanished$"), r"\1 vanished"),
+    (re.compile(r"^(\S+) \S+(?: cells)? appeared at \(\d+,\d+\)$"), r"\1 appeared"),
+    (re.compile(r"^large .* changed shape$"), "large region changed shape"),
+    (re.compile(r"^\d+ cells changed inside the board.*$"), "cells changed inside the board"),
+)
+
+
+def effect_signature(lines: Sequence[str]) -> str:
+    """What an action did, coarse enough that repeating a known mechanic is not 'new' (focus, 10-29): a mover keeps
+    colour, size and displacement; any other change keeps only colour and kind (appeared / vanished / turned /
+    changed shape); positions, cell counts, the overflow line and the edge band are dropped."""
+    out = set()
+    for l in lines:
+        if l.startswith("edge band") or l.endswith("more object changes"):
+            continue
+        if l in ("no cell changed", "nothing changed inside the board"):
+            continue
+        for rx, rep in _SIG_RULES:
+            if rx.match(l):
+                out.add(rx.sub(rep, l))
+                break
+        else:
+            out.add(l)
+    return "; ".join(sorted(out)) if out else "no change inside the board"
+
+
+class EffectLedger:
+    """Per level: action -> outcomes. An outcome is the displacement of the one object that moved, 'no change inside
+    the board', or 'other' (several objects / appear / vanish). Clicks are keyed by the clicked object."""
+
+    def __init__(self) -> None:
+        self.level = None
+        self.seen: dict[str, Counter] = defaultdict(Counter)
+        self.sigs: dict[str, set] = defaultdict(set)   # focus (10-29): position-free effect signatures per key
+        self.new_in_last: list[tuple[str, str]] = []   # (key, signature) first seen in the last digest_lines call
+        self.sig_counts: dict[str, Counter] = defaultdict(Counter)   # explain (10-29): signature counts per key
+        self.explain_last: list[str] = []              # explain: effect-detail lines from the last digest_lines call
+        self.explain_mode: int = 1                     # 1 = local facts on any new effect; 2 = changed effects only, as a conclusion
+
+    def observe(self, level: int, action: str, before: Grid, after: Grid, border: int = 4) -> None:
+        if level != self.level:
+            self.level, self.seen, self.sigs = level, defaultdict(Counter), defaultdict(set)
+            self.sig_counts = defaultdict(Counter)
+        key = ledger_key(action, before)
+        lines, moves = object_changes(before, after, border=border)
+        sig = effect_signature(lines)
+        if sig not in self.sigs[key]:
+            self.sigs[key].add(sig)
+            self.new_in_last.append((key, sig))
+            if len(self.explain_last) < EXPLAIN_MAX:
+                try:
+                    if self.explain_mode == 2:
+                        line = changed_effect_line(key, sig, self.sig_counts[key])
+                        if line:
+                            self.explain_last.append(line)
+                    else:
+                        self.explain_last.append(explain_effect(key, sig, self.sig_counts[key], before, after, lines,
+                                                                border=border))
+                except Exception as exc:  # an explanation must never break a turn
+                    self.explain_last.append("(effect detail unavailable: %s)" % type(exc).__name__)
+        self.sig_counts[key][sig] += 1
+        inner = [l for l in lines if not l.startswith("edge band")]
+        if not inner or inner[0] in ("no cell changed", "nothing changed inside the board"):
+            self.seen[key]["no change inside the board"] += 1
+            return
+        mv = sorted({"%s %s" % (_letter(m[0]), _size(m[1])) for m in moves if m[0] != "recolour"})
+        ds = sorted({(m[2], m[3]) for m in moves if m[0] != "recolour"})
+        rc = sorted({"%s->%s" % (_letter(m[1]), _letter(m[2])) for m in moves if m[0] == "recolour"})
+        if mv and len(ds) == 1:
+            self.seen[key]["%s moved (%+d,%+d)" % (" + ".join(mv), ds[0][0], ds[0][1])] += 1
+        elif mv:
+            self.seen[key]["several objects moved"] += 1
+        elif rc:
+            self.seen[key]["a cell group turned " + ", ".join(rc)] += 1
+        else:
+            self.seen[key]["other change"] += 1
+
+    def line(self, actions: Iterable[str]) -> str:
+        keys = []
+        for a in actions:
+            k = str(a).split("(", 1)[0].strip().upper()
+            for seen_key in self.seen:
+                if (seen_key == k or seen_key.startswith(k + " on ")) and seen_key not in keys:
+                    keys.append(seen_key)
+        parts = []
+        for k in keys:
+            n = sum(self.seen[k].values())
+            top, m = self.seen[k].most_common(1)[0]
+            parts.append("%s: %s in %d of %d" % (k, top, m, n))
+        return ("This level so far - " + "; ".join(parts) + ".") if parts else ""
+
+
+def digest_lines(frames: Sequence[Grid], actions: Sequence[str], ledger: EffectLedger | None, level: int,
+                 border: int = 4) -> list[str]:
+    """frames = [frame before the sequence, frame after each executed action]; actions = executed actions."""
+    if len(frames) < 2:
+        return []
+    if ledger is not None:
+        ledger.new_in_last = []
+        ledger.explain_last = []
+        for i, a in enumerate(actions[: len(frames) - 1]):
+            ledger.observe(level, a, frames[i], frames[i + 1], border)
+    lines, _ = object_changes(frames[0], frames[-1], border=border)
+    out = "Board change over the sequence (harness, facts not advice): " + "; ".join(lines) + "."
+    led = ledger.line(actions) if ledger is not None else ""
+    text = out + ((" " + led) if led else "")
+    return [text[:MAX_CHARS]]
+
+
+SMALL = 64           # cells: a region at most this big is listed by the default watch
+WATCH_CHARS = 600
+GROUP = 6            # more same-colour, same-shape regions than this are summarised as a group
+
+
+def default_watch_line(grid: Grid, *, border: int = 4) -> str:
+    """The harness's default watch (kojimatech 10-29): the small objects on the current board, by colour, size and
+    top-left, the rarest colours first. The model's own watch() replaces it once defined. Facts only."""
+    objs = [o for o in components(grid, border=border) if len(o[2]) <= SMALL]
+    if not objs:
+        return "Default watch (harness; define watch() to replace it): no small objects inside the board."
+    by_colour: dict[int, list] = defaultdict(list)
+    for v, p, s in objs:
+        by_colour[v].append((p, s))
+    parts = []
+    for v in sorted(by_colour, key=lambda k: (len(by_colour[k]), k)):
+        items = sorted(by_colour[v])
+        shapes = Counter(s for _p, s in items)
+        bits = []
+        for s, n in shapes.most_common():
+            ps = [p for p, s2 in items if s2 == s]
+            if n > GROUP:
+                bits.append("%d x %s in rows %d-%d cols %d-%d" % (n, _size(s), min(r for r, _ in ps), max(r for r, _ in ps),
+                                                                   min(c for _, c in ps), max(c for _, c in ps)))
+            else:
+                bits.append("%s at %s" % (_size(s), " ".join("(%d,%d)" % p for p in ps)))
+        parts.append("%s: %s" % (_letter(v), "; ".join(bits)))
+    text = "Default watch (harness; define watch() to replace it): small objects now - " + " | ".join(parts) + "."
+    return text if len(text) <= WATCH_CHARS else text[:WATCH_CHARS] + " ...(truncated)"
+
+
+# ---- change record (kojimatech 10-29): what every executed action did, kept for the whole game -------------------
+# 32 % of the default-watch canon's inspect-only snippets re-read past frames (transitions / history), most of them
+# looping over every transition to recompute what an action did. The harness already computes the object-level
+# change once per action for the digest; this keeps it, with the frame_diff dict, so the model reads the record
+# in order instead of the frames.
+
+def _nodes(grid: Grid) -> list:
+    from inference.utils.grid_utils import ARC_COLOR_CHARS
+    from inference.utils.segmentation import segment_layer
+    return segment_layer(grid, ARC_COLOR_CHARS).get("nodes", [])
+
+
+def action_record(before: Grid, after: Grid, *, action: str, step: int, level_before: int, level_after: int,
+                  border: int = 4, nodes_cache: dict | None = None) -> dict:
+    """One change_log entry: step, level, action, summary (the object-level change in words) and diff (the
+    frame_diff dict between the frame before and the frame after the action; None across a level change).
+    `nodes_cache` {"step": int, "nodes": list} carries the segmentation of `before` from the previous call
+    (segmentation is the cost, about 65 ms per 64x64 frame) and is updated to `after`."""
+    rec = {"step": int(step), "level": int(level_after), "action": str(action), "summary": "", "diff": None,
+           "state": state_text(state_objects(after, border=border))}
+    if level_after != level_before:
+        rec["summary"] = "level %d completed; this frame is the start of level %d" % (level_before, level_after)
+        if nodes_cache is not None:
+            nodes_cache.clear()
+        return rec
+    lines, _moves = object_changes(before, after, border=border)
+    m = _MOUSE_RE.search(str(action))
+    if m:
+        rec["target"] = click_target(before, int(m.group(1)), int(m.group(2)), border=border)
+        lines = [click_phrase(rec["target"])] + lines
+    rec["summary"] = "; ".join(lines)
+    try:
+        from inference.utils.frame_diff import compute_frame_diff
+        cached = nodes_cache.get("nodes") if nodes_cache else None
+        nb = cached if cached is not None else _nodes(before)
+        na = _nodes(after)
+        rec["diff"] = compute_frame_diff(before, after, nb, na, max_group_match=40)
+        if nodes_cache is not None:
+            nodes_cache.clear()
+            nodes_cache.update(step=int(step), nodes=na)
+    except Exception as exc:  # the record must never break a turn
+        rec["diff"] = {"error": type(exc).__name__}
+        if nodes_cache is not None:
+            nodes_cache.clear()
+    return rec
+
+
+def change_lines(records, *, level=None, last=None, action=None) -> list[str]:
+    """Compact chronological lines for change_log entries, filtered by level / action, the last N only."""
+    out = []
+    for r in records:
+        if level is not None and int(r.get("level", -1)) != int(level):
+            continue
+        if action is not None and str(r.get("action", "")).split("(", 1)[0].strip().upper() != str(action).strip().upper():
+            continue
+        d = r.get("diff") or {}
+        n = d.get("changed_cell_count")
+        out.append("step %d L%d %s: %s%s" % (int(r.get("step", 0)), int(r.get("level", 0)), r.get("action", "?"),
+                                             r.get("summary", ""), (" [%d cells]" % n) if isinstance(n, int) and n >= 0 else ""))
+    if last is not None:
+        out = out[-int(last):] if int(last) > 0 else []
+    return out
+
+
+# ---- states (kojimatech 10-29, user: 「状態とその変化も記録に追加」) ----------------------------------------------
+# The change-record canon's frame re-reads mostly fetched a past STATE (the objects at a level's start or end, at a
+# given step), not a change. Every change_log entry now carries the board state after the action, and the harness
+# keeps the key states (level start, level end, before a game over).
+
+STATE_MAX = 200      # cells: regions up to this size are listed as objects; larger ones are floor / walls
+STATE_CHARS = 700
+
+
+def state_objects(grid: Grid, *, border: int = 4, limit: int = 60) -> list[dict]:
+    """Objects inside the board (4-connected same-colour regions, background excluded, at most STATE_MAX cells):
+    colour, size, top-left, cells; the rarest colours first."""
+    objs = [o for o in components(grid, border=border) if len(o[2]) <= STATE_MAX]
+    count = Counter(v for v, _p, _s in objs)
+    objs.sort(key=lambda o: (count[o[0]], o[0], o[1]))
+    return [{"colour": _letter(v), "size": _size(sh), "at": [p[0], p[1]], "cells": len(sh)} for v, p, sh in objs[:limit]]
+
+
+def state_text(objs: list[dict]) -> str:
+    """Compact text of state_objects: per colour, size and top-left; more than GROUP of one shape summarised."""
+    if not objs:
+        return "no objects inside the board"
+    by_colour: dict[str, list] = defaultdict(list)
+    for o in objs:
+        by_colour[o["colour"]].append(o)
+    parts = []
+    for col, items in by_colour.items():
+        shapes = Counter(o["size"] for o in items)
+        bits = []
+        for size, n in shapes.most_common():
+            ps = [tuple(o["at"]) for o in items if o["size"] == size]
+            if n > GROUP:
+                bits.append("%d x %s in rows %d-%d cols %d-%d" % (n, size, min(r for r, _ in ps), max(r for r, _ in ps),
+                                                                   min(c for _, c in ps), max(c for _, c in ps)))
+            else:
+                bits.append("%s at %s" % (size, " ".join("(%d,%d)" % p for p in ps)))
+        parts.append("%s: %s" % (col, "; ".join(bits)))
+    text = " | ".join(parts)
+    return text if len(text) <= STATE_CHARS else text[:STATE_CHARS] + " ...(truncated)"
+
+
+# ---- effect detail (kojimatech 10-29, ECA Tier 2: local refinement only when an effect is new) --------------------
+# After a new effect the model's inspect-only turns are about what blocked a move, what an object now touches, and
+# what disappeared under a mover (reasoning: block/blocked/wall 2400+, adjacent/touching 420+ mentions over two runs).
+# When an action's effect is new on this level, the harness states those local facts once; nothing otherwise.
+
+EXPLAIN_MAX = 2
+EXPLAIN_CHARS = 480
+_MOVED_RE = re.compile(r"^(\S+) (\S+(?: cells)?) at \((\d+),(\d+)\) moved by \(([+-]\d+),([+-]\d+)\)$")
+_VANISHED_RE = re.compile(r"^(\S+) (\S+(?: cells)?) at \((\d+),(\d+)\) vanished$")
+_SIG_MOVE_RE = re.compile(r"^(\S+) (\S+(?: cells)?) moved by \(([+-]\d+),([+-]\d+)\)$")
+
+
+def _region_at(grid: Grid, r: int, c: int) -> tuple[int, tuple[int, int], frozenset]:
+    v = grid[r][c]
+    seen = {(r, c)}
+    stack = [(r, c)]
+    h = len(grid)
+    while stack and len(seen) <= 4096:
+        y, x = stack.pop()
+        for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            ny, nx = y + dy, x + dx
+            if 0 <= ny < h and 0 <= nx < len(grid[ny]) and (ny, nx) not in seen and grid[ny][nx] == v:
+                seen.add((ny, nx))
+                stack.append((ny, nx))
+    tr, tc = min(y for y, _ in seen), min(x for _, x in seen)
+    return int(v), (tr, tc), frozenset((y - tr, x - tc) for y, x in seen)
+
+
+def _describe(v: int, at: tuple[int, int], shape: frozenset) -> str:
+    return "%s %s at (%d,%d)" % (_letter(v), _size(shape), at[0], at[1])
+
+
+def _object_cells(grid: Grid, colour: str, size: str, border: int) -> list[set]:
+    out = []
+    for v, (r, c), sh in components(grid, border=border):
+        if _letter(v) == colour and _size(sh) == size:
+            out.append({(r + a, c + b) for a, b in sh})
+    return out
+
+
+def _neighbours(grid: Grid, cells: set, *, bg: int, limit: int = 4) -> list[str]:
+    found, names = set(), []
+    for y, x in sorted(cells):
+        for dy, dx in ((1, 0), (-1, 0), (0, 1), (0, -1)):
+            ny, nx = y + dy, x + dx
+            if (ny, nx) in cells or not (0 <= ny < len(grid) and 0 <= nx < len(grid[ny])) or grid[ny][nx] == bg:
+                continue
+            reg = _region_at(grid, ny, nx)
+            key = (reg[0], reg[1])
+            if len(reg[2]) > STATE_MAX:   # floor / large regions: not a contact worth naming
+                found.add(key)
+                continue
+            if key not in found:
+                found.add(key)
+                names.append(_describe(*reg))
+                if len(names) >= limit:
+                    return names
+    return names
+
+
+def explain_effect(key: str, sig: str, prior: Counter, before: Grid, after: Grid, lines: Sequence[str], *,
+                   border: int = 4) -> str:
+    """One line of local facts about an effect that is new for this action key on this level: what the key did
+    before, what blocked an expected move, what a mover now touches, what vanished under a mover."""
+    bg = Counter(v for row in after for v in row).most_common(1)[0][0]
+    h = len(before)
+    w = max((len(r) for r in before), default=0)
+    parts = []
+    if prior:
+        top, n = prior.most_common(1)[0]
+        parts.append("before on this level: %s (%d of %d)" % (top[:90], n, sum(prior.values())))
+    else:
+        parts.append("first time on this level")
+    parts.append("this time: %s" % sig[:110])
+    # an expected single move that did not happen: what the move's destination cells hold
+    missing = None
+    if prior:
+        for term in prior.most_common(1)[0][0].split("; "):
+            m = _SIG_MOVE_RE.match(term)
+            if m and (m.group(1) + " " + m.group(2) + " moved") not in sig:
+                missing = m
+                break
+    if missing is not None:
+        m = missing
+        if True:
+            colour, size, dr, dc = m.group(1), m.group(2), int(m.group(3)), int(m.group(4))
+            objs = _object_cells(before, colour, size, border)
+            if len(objs) == 1:
+                cells = objs[0]
+                dest = {(y + dr, x + dc) for y, x in cells} - cells
+                outside = [p for p in dest if not (border <= p[0] < h - border and border <= p[1] < w - border)]
+                held = []
+                for y, x in sorted(dest):
+                    if 0 <= y < h and 0 <= x < len(before[y]) and before[y][x] != bg:
+                        reg = _region_at(before, y, x)
+                        d = _describe(*reg)
+                        if d not in held:
+                            held.append(d)
+                tl = (min(y for y, _ in cells), min(x for _, x in cells))
+                what = ("leave the board area" if outside and len(outside) == len(dest) else
+                        ("hold " + "; ".join(held[:3])) if held else "were empty")
+                parts.append("the cells %s %s at (%d,%d) would move into %s" % (colour, size, tl[0], tl[1], what))
+    # movers: what they touch now; vanished objects under a mover
+    mover_cells = []
+    for l in lines:
+        mm = _MOVED_RE.match(l)
+        if not mm:
+            continue
+        colour, size = mm.group(1), mm.group(2)
+        nr, nc = int(mm.group(3)) + int(mm.group(5)), int(mm.group(4)) + int(mm.group(6))
+        for cells in _object_cells(after, colour, size, border):
+            if (nr, nc) == (min(y for y, _ in cells), min(x for _, x in cells)):
+                mover_cells.append(cells)
+                nb = _neighbours(after, cells, bg=bg)
+                if nb:
+                    parts.append("%s %s at (%d,%d) now touches %s" % (colour, size, nr, nc, "; ".join(nb)))
+                break
+        if len(mover_cells) >= 2:
+            break
+    for l in lines:
+        mv = _VANISHED_RE.match(l)
+        if not mv:
+            continue
+        r0, c0 = int(mv.group(3)), int(mv.group(4))
+        if any((r0, c0) in cells or (r0 + 1, c0) in cells or (r0, c0 + 1) in cells for cells in mover_cells):
+            parts.append("%s %s at (%d,%d) vanished where a mover now stands" % (mv.group(1), mv.group(2), r0, c0))
+    text = "Effect detail (harness, facts): %s - %s." % (key, "; ".join(parts))
+    return text if len(text) <= EXPLAIN_CHARS else text[:EXPLAIN_CHARS] + " ...(truncated)"
+
+
+# ---- changed effect as a conclusion (kojimatech 10-29, mode 2) ----------------------------------------------------
+# The first effect-detail draw: lines naming board facts (what a mover touches, what holds the blocked cells) made the
+# model go and verify them (inspect turns after a blocked move 1.03 -> 2.20); the before/after comparison was the one
+# part with the sign the other way (1.26 -> 1.10). Mode 2 keeps only that, on changed effects, as a sentence about the
+# action, never about the board.
+
+CHANGED_CHARS = 240
+
+
+def _terms(sig: str) -> list[str]:
+    return [] if sig == "no change inside the board" else [t for t in sig.split("; ") if t]
+
+
+def _join(terms: list[str], limit: int = 3) -> str:
+    return "; ".join(terms[:limit]) + ("; and %d more" % (len(terms) - limit) if len(terms) > limit else "")
+
+
+def changed_effect_line(key: str, sig: str, prior: Counter) -> str:
+    """One sentence about the action, stating only the difference from its usual effect on this level. Nothing on a
+    first-time effect."""
+    if not prior:
+        return ""
+    usual, n = prior.most_common(1)[0]
+    m = sum(prior.values())
+    now, was = _terms(sig), _terms(usual)
+    gone = [t for t in was if t not in now]
+    added = [t for t in now if t not in was]
+    seen = "(seen %d of %d times)" % (n, m)
+    if not now:
+        text = "%s did nothing inside the board this time; until now it did: %s %s." % (key, _join(was), seen)
+    elif not was:
+        text = "%s did something this time: %s; until now it did nothing inside the board %s." % (key, _join(added), seen)
+    else:
+        bits = []
+        if gone:
+            bits.append("not this time: " + _join(gone))
+        if added:
+            bits.append("new this time: " + _join(added))
+        text = "%s differed from its usual effect %s - %s." % (key, seen, "; ".join(bits) if bits else "same parts, different mix")
+    return text if len(text) <= CHANGED_CHARS else text[:CHANGED_CHARS] + " ...(truncated)"
+
+
+# ---- stable-effect break (kojimatech 10-29, surprise stop) ---------------------------------------------------------
+# Replaying two control runs: "any new effect signature" fires on 33 % of actions whose key was already used on the
+# level (effects depend on the state in these games); "the main mover did not make its usual move" on 28 %. Only a
+# break of a STABLE effect (the same effect at least 3 times and in at least 80 % of the key's uses on the level) is
+# rare: 1.8 %. That is the event the harness stops a batch for.
+
+STABLE_MIN = 3
+STABLE_SHARE = 0.8
+
+
+def stall_inventory(ledger: "EffectLedger", grid: Grid, valid_actions: Sequence[str], level_actions: int) -> str:
+    """Stall inventory (kojimatech 10-30; docs/stall_inventory_registration_2026-10-30.md). After `level_actions`
+    actions without a level change, one opener line states this level's full record: every ledger key tried (count and
+    dominant outcome) and what was never tried (valid actions without a ledger entry; on-board objects whose colour and
+    size were never clicked). Descriptive only - nothing is forbidden; built solely from run-time data, so it carries
+    no game knowledge."""
+    tried = []
+    for key, cnt in sorted(ledger.seen.items(), key=lambda kv: -sum(kv[1].values())):
+        n = sum(cnt.values())
+        top, m = cnt.most_common(1)[0]
+        tried.append("%s x%d (%s in %d)" % (key, n, top, m))
+    more = ("; +%d more keys" % (len(tried) - 8)) if len(tried) > 8 else ""
+    names = []
+    for a in valid_actions or []:
+        k = str(a).split("(", 1)[0].strip().upper()
+        if k and k not in names:
+            names.append(k)
+    untried = [k for k in names if k != "MOUSE" and k not in ledger.seen]
+    if "MOUSE" in names:
+        pairs = []
+        for o in state_objects(grid):
+            key = "MOUSE on %s %s" % (o["colour"], o["size"])
+            if key not in ledger.seen and (o["colour"], o["size"]) not in [p[0] for p in pairs]:
+                pairs.append(((o["colour"], o["size"]), tuple(o["at"])))
+        untried += ["click %s %s at (%d,%d)" % (c, sz, at[0], at[1]) for (c, sz), at in pairs[:6]]
+        if len(pairs) > 6:
+            untried.append("+%d more unclicked object kinds" % (len(pairs) - 6))
+    not_tried = ("; ".join(untried) if untried else
+                 "nothing: every valid action and every on-board object kind has been tried on this level")
+    return ("Stall inventory (harness): %d actions on this level without completing it. Tried here - %s%s. "
+            "Never tried on this level - %s. If the repeated keys keep producing their usual effects, the untried "
+            "part of this level is listed above." % (level_actions, "; ".join(tried[:8]) or "nothing", more, not_tried))
+
+
+def _stall_tried_untried(ledger: "EffectLedger", grid: Grid, valid_actions: Sequence[str]):
+    """The stuck level's record, shared by the inventory line and the staged block: tried keys as (key, n_uses,
+    n_distinct_outcomes, dominant outcome, dominant count) sorted by use count, and the never-tried items (valid
+    actions without a ledger entry; unclicked on-board object kinds, 6 shown)."""
+    tried = []
+    for key, cnt in sorted(ledger.seen.items(), key=lambda kv: -sum(kv[1].values())):
+        top, m = cnt.most_common(1)[0]
+        tried.append((key, sum(cnt.values()), len(cnt), top, m))
+    names = []
+    for a in valid_actions or []:
+        k = str(a).split("(", 1)[0].strip().upper()
+        if k and k not in names:
+            names.append(k)
+    untried = [k for k in names if k != "MOUSE" and k not in ledger.seen]
+    if "MOUSE" in names:
+        pairs = []
+        for o in state_objects(grid):
+            key = "MOUSE on %s %s" % (o["colour"], o["size"])
+            if key not in ledger.seen and (o["colour"], o["size"]) not in [p[0] for p in pairs]:
+                pairs.append(((o["colour"], o["size"]), tuple(o["at"])))
+        untried += ["click %s %s at (%d,%d)" % (c, sz, at[0], at[1]) for (c, sz), at in pairs[:6]]
+        if len(pairs) > 6:
+            untried.append("+%d more unclicked object kinds" % (len(pairs) - 6))
+    return tried, untried
+
+
+def stall_inventory_block(ledger: "EffectLedger", grid: Grid, valid_actions: Sequence[str], level_actions: int,
+                          mode: str) -> str:
+    """Staged-grounds stuck-level block (kojimatech 10-30; docs/stinv_grounds_registration_2026-10-30.md). Unlike
+    `stall_inventory` (one line inside the digest), this is the opener's final paragraph. Two stagings of the same
+    run-time record:
+      mode='conclusion' - the record plus the conclusion as an instruction (execute one never-tried item now),
+        with nothing supporting it;
+      mode='grounds'    - the record plus the derivation material only (repetition of a predictable key observes
+        nothing new; any never-tried item observes something new), with no instruction.
+    With nothing untried, both fall back to the descriptive inventory line. Run-time data only, as before."""
+    tried, untried = _stall_tried_untried(ledger, grid, valid_actions)
+    if not untried:
+        return stall_inventory(ledger, grid, valid_actions, level_actions)
+    head = "STUCK-LEVEL CHECK (harness): %d actions on this level without completing it." % level_actions
+    more = ("; +%d more keys" % (len(tried) - 8)) if len(tried) > 8 else ""
+    if mode == "conclusion":
+        tried_s = "; ".join("%s x%d (%s in %d)" % (k, n, top, m) for k, n, _, top, m in tried[:8]) or "nothing"
+        return (head + "\nTried here - %s%s.\nNever tried on this level - %s.\n"
+                "The best move now is one you have never tried: in this reply, execute at least one item from the "
+                "never-tried list and judge it from the result.") % (tried_s, more, "; ".join(untried))
+    rep = []
+    for k, n, distinct, top, m in tried[:8]:
+        rep.append("%s x%d - the same effect every time" % (k, n) if distinct == 1 else
+                   "%s x%d - %d different effects (%s in %d)" % (k, n, distinct, top, m))
+    return (head + "\nWhat repetition has already told you: %s%s.\n"
+            "A key whose effect here you can already predict observes nothing new when pressed again.\n"
+            "Each of these has never been tried on this level, so whatever happens, trying one observes something "
+            "new: %s.\nNothing is forbidden - you keep the judgment.") % ("; ".join(rep) or "nothing", more,
+                                                                          "; ".join(untried))
+
+
+def stall_report(ledger: "EffectLedger", grid: Grid, valid_actions: Sequence[str], level_actions: int) -> dict:
+    """Stall report as data (kojimatech 10-30; docs/stinv_data_registration_2026-10-30.md). The stuck level's record
+    as a plain dict for the python tool's data plane - observed facts only: what was tried (per-key use counts and
+    effect counts from the ledger), what was never tried (valid actions without a ledger entry; unclicked on-board
+    object kinds). No advice, no derivation, no instruction - the same facts the inventory line renders as prose."""
+    tried, untried = _stall_tried_untried(ledger, grid, valid_actions)
+    never_actions = []
+    never_clicks = []
+    for item in untried:
+        m = re.match(r"click (\S+) (\S+) at \((\d+),(\d+)\)", item)
+        if m:
+            never_clicks.append({"colour": m.group(1), "size": m.group(2), "at": [int(m.group(3)), int(m.group(4))]})
+        elif item.startswith("+"):
+            never_clicks.append({"more_unclicked_object_kinds": int(item.split()[0][1:])})
+        else:
+            never_actions.append(item)
+    return {
+        "actions_on_this_level_without_completion": int(level_actions),
+        "tried": {key: {"times": n, "effects": dict(ledger.seen[key])} for key, n, _, _, _ in tried},
+        "never_tried_actions": never_actions,
+        "never_clicked_object_kinds": never_clicks,
+    }
+
+
+def stall_report_text(report: dict) -> str:
+    """The stall report as plain stdout lines (STDOUT mode, kojimatech 10-30; docs/stinv_stdout_registration_
+    2026-10-30.md). Facts only - the same record `stall_report` holds, formatted for a tool result."""
+    tried = report.get("tried") or {}
+    rows = []
+    for key, rec in sorted(tried.items(), key=lambda kv: -int(kv[1].get("times", 0)))[:8]:
+        eff = ", ".join("%s x%d" % (e, n) for e, n in sorted((rec.get("effects") or {}).items(), key=lambda kv: -kv[1])[:4])
+        rows.append("  %s: %d uses [%s]" % (key, int(rec.get("times", 0)), eff))
+    if len(tried) > 8:
+        rows.append("  (+%d more keys)" % (len(tried) - 8))
+    never_a = report.get("never_tried_actions") or []
+    never_c = []
+    for o in report.get("never_clicked_object_kinds") or []:
+        if "more_unclicked_object_kinds" in o:
+            never_c.append("+%d more kinds" % o["more_unclicked_object_kinds"])
+        else:
+            never_c.append("%s %s at (%d,%d)" % (o.get("colour"), o.get("size"), o["at"][0], o["at"][1]))
+    return "\n".join([
+        "[stall report, observed] %d actions on this level without completing it." % int(
+            report.get("actions_on_this_level_without_completion", 0)),
+        "tried on this level (uses, effects):"] + (rows or ["  nothing"]) + [
+        "never tried on this level: %s" % ("; ".join(never_a) if never_a else "no untried action"),
+        "never clicked on this level: %s" % ("; ".join(never_c) if never_c else "no unclicked object kind"),
+    ])
+
+
+SHEET_NAME = "STATUS_SHEET"
+SHEET_KEYS = ("goal", "rules", "failed", "contradictions", "next_test")
+SHEET_SHOW_CHARS = 1400
+
+
+def status_sheet_request(report: dict, update: bool) -> str:
+    """Status sheet request (kojimatech 10-31; docs/status_sheet_registration_2026-10-31.md). The opener's final
+    paragraph every N actions on an unfinished level: the harness's observed record of this level (the stall
+    report's rows, facts only) as the draft, and the fixed form the model fills by binding STATUS_SHEET in its next
+    python call. No advice, no instruction about what to try: the model sorts its own state."""
+    rows = stall_report_text(report).splitlines()[1:]
+    head = ("STATUS SHEET %s (harness): %d actions on this level without completing it." % (
+        "UPDATE" if update else "DUE", int(report.get("actions_on_this_level_without_completion", 0))))
+    return "\n".join([head, "Observed record of this level (harness, facts only):"] + rows + [
+        "In your next python call, bind the dict literal STATUS_SHEET = {\"goal\": ..., \"rules\": [...], "
+        "\"failed\": [...], \"contradictions\": [...], \"next_test\": ...} in your own words (strings and lists of "
+        "strings, under 4000 characters), then continue as usual in the same call. goal: what you now think this level "
+        "asks for and the observation behind it. rules: each control or object rule you currently hold, with how sure "
+        "you are and any counterexample; confirm or contest the record above. failed: approaches already tried here and "
+        "what happened. contradictions: where your rules disagree with each other or with the record. next_test: the "
+        "one thing you will check next. The sheet is kept and shown to you on this level until you rebind it."])
+
+
+def status_sheet_show(source: str, mark: int) -> str:
+    """The kept sheet, rendered compactly in the openers that follow (until the next request on this level)."""
+    import ast as _ast
+    try:
+        value = _ast.literal_eval(source.split(" = ", 1)[1])
+    except Exception:
+        return "Your status sheet (written at the %d-action mark of this level) could not be rendered." % mark
+    parts = []
+    if isinstance(value, dict):
+        for key in SHEET_KEYS:
+            v = value.get(key)
+            if v is None:
+                continue
+            text = "; ".join(str(x) for x in v) if isinstance(v, (list, tuple)) else str(v)
+            parts.append("%s: %s" % (key, text))
+        for key in value:
+            if key not in SHEET_KEYS:
+                parts.append("%s: %s" % (key, str(value[key])))
+    else:
+        parts.append(str(value))
+    body = " | ".join(parts)
+    if len(body) > SHEET_SHOW_CHARS:
+        body = body[:SHEET_SHOW_CHARS] + " ...(truncated)"
+    return "Your status sheet (written at the %d-action mark of this level): %s" % (mark, body)
+
+
+def stable_break(prior: Counter, sig: str) -> str:
+    """'' unless the key's usual effect on this level is stable and this effect breaks it (the usual main mover did
+    not make its usual move, or the key usually did nothing and now moved something). Returns a short description."""
+    if not prior:
+        return ""
+    usual, n = prior.most_common(1)[0]
+    m = sum(prior.values())
+    if n < STABLE_MIN or n < STABLE_SHARE * m or sig == usual:
+        return ""
+    def movers(x):
+        out = {}
+        for t in ([] if x == "no change inside the board" else x.split("; ")):
+            mm = _SIG_MOVE_RE.match(t)
+            if mm:
+                out[mm.group(1) + " " + mm.group(2)] = (int(mm.group(3)), int(mm.group(4)))
+        return out
+    um, nm = movers(usual), movers(sig)
+    if um:
+        name, disp = next(iter(um.items()))
+        if nm.get(name) == disp:
+            return ""
+    elif not nm:
+        return ""
+    return "usually %s (%d of %d times on this level), this time %s" % (usual[:100], n, m, sig[:100])
