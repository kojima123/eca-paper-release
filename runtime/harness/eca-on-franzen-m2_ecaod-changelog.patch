+def _eca_lite_deviation_releases_without_strike(violation: str) -> bool:
+    """Opt-in: an ignored 1-action advice closes the lease, it does not ban the family.
+
+    Measured 2026-09-08 (guard diag): 4 of 15 fallbacks were `llm_deviation`,
+    a lease-contract break, and each one suppressed the family for the whole
+    level exactly like a model refutation. Under this flag the lease is
+    released instead, so the family may re-certify on the next frame.
+    """
+    if violation not in {"llm_deviation", "multi_action_batch"}:
+        return False
+    return str(
+        os.environ.get("ECA_TUFA_DEVIATION_WITHOUT_STRIKE", "0") or "0"
+    ).strip() == "1"
+
+
+def _eca_lite_action_request_violation(
+    *, requested_count: int, actions_since_advice: int, lease_active: bool
+) -> str:
+    """Reject unsafe action calls before the engine observes any action."""
+    if not lease_active:
+        return ""
+    if int(requested_count) != 1:
+        return "eca_lease_requires_single_action"
+    if int(actions_since_advice) > 0:
+        return "eca_lease_requires_reverification"
+    return ""
