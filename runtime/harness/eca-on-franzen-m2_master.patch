+def _toolbox_suppressed_for_level(
+    strikes: dict, level: int, threshold: int = 2
+) -> frozenset:
+    """Graduated kill switch: suppress a family only for the level where it
+    accumulated >= threshold advertised-then-game-over strikes. One strike is
+    forgiven (perception hiccup); a level advance clears the slate."""
+    return frozenset(
+        family
+        for (family, struck_level), count in strikes.items()
+        if struck_level == int(level) and count >= threshold
+    )
