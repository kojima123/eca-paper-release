+def _eca_lite_portfolio_cached_family(
+    policy: dict[str, Any],
+    *,
+    level: int,
+    enabled_families: list[str] | None,
+    family_cache: dict[int, str],
+    suppressed: frozenset[str],
+) -> str:
+    """Select a certified per-level reader cache without game-id routing."""
+
+    if str(policy.get("profile", "")) != "portfolio_lease":
+        return ""
+    cached = str(family_cache.get(int(level), "") or "")
+    if not cached or cached in suppressed:
+        return ""
+    if enabled_families is not None and cached not in enabled_families:
+        return ""
+    return cached
