+        return base
+    assert _EXPECT_DESCRIPTION_ANCHOR in base, "FRZ-EXPECT: tool description anchor moved"
+    return base.replace(_EXPECT_DESCRIPTION_ANCHOR, _EXPECT_DESCRIPTION_NEW, 1)
