+def _model_step_to_action_input(step: Any) -> "arcengine.ActionInput | None":
+    """Convert a toolbox plan step ({action: UP} / {action: MOUSE, row, col})
+    into an engine ActionInput for the prefix executor. Returns None for
+    anything malformed — the caller then hands control back to the LLM."""
+    if not isinstance(step, dict):
+        return None
+    engine_name = to_engine_action(str(step.get("action", "")))
+    if not engine_name:
+        return None
+    try:
+        game_action = getattr(arcengine.GameAction, engine_name)
+    except AttributeError:
+        return None
+    data: dict[str, Any] = {}
+    if engine_name == "ACTION6":
+        data = {"x": int(step.get("col", 0) or 0), "y": int(step.get("row", 0) or 0)}
+    return arcengine.ActionInput(id=game_action, data=data)
+
+
+def _display_action_from_model_step(step: Any) -> str:
+    """Render a toolbox plan step the same way executed actions land in
+    history (`_format_action_display`), so adherence can be measured by
+    string comparison."""
+    if not isinstance(step, dict):
+        return ""
+    name = str(step.get("action", "")).strip().upper()
+    if name == "MOUSE":
+        return f"MOUSE(row={int(step.get('row', 0) or 0)}, col={int(step.get('col', 0) or 0)})"
+    return name
+
