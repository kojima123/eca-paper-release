+    _toolbox_last_eval_grid: Any = field(default=None, init=False, repr=False)
+    _toolbox_last_eca_advice: Any = field(default=None, init=False, repr=False)
+    _toolbox_skips_since_eval: int = field(default=0, init=False, repr=False)
+    _toolbox_ondemand_note: dict = field(default_factory=dict, init=False, repr=False)
+    # FRZ-EXPECT (ECA_FRZ_EXPECT, default off): consecutive refuted expectations on the current level, and that level.
+    _expect_streak: int = field(default=0, init=False, repr=False)
+    _expect_streak_level: int = field(default=-1, init=False, repr=False)
+    # FRZ-SIMPLAN: the level the stall note is counting on, its first action, and the last level already noted
+    _simplan_level: int = field(default=-2, init=False, repr=False)
+    _simplan_level_start_action: int = field(default=0, init=False, repr=False)
+    _simplan_noted_level: int = field(default=-3, init=False, repr=False)
+    _simplan2_second_note_level: int = field(default=-3, init=False, repr=False)  # SIMPLAN-2: repeat once at 3x
+
+    def current_frame(self) -> Frame:
+        return Frame(
+            grid=_grid_from_state(self.game.current_state),
+            step=self.action_count,
+            level=_level_number(self.game),
+        )
+
+    def _eca_telemetry_path(self) -> Path:
+        # Sibling of the runtime-state file; survives the run (the state
+        # file is unlinked on exit) and lands in the pulled kernel output.
+        return self.state_path.with_name(
+            self.state_path.name.replace("tool_runtime_state.json", "eca_telemetry.jsonl")
+        )
+
+    def _expect_telemetry_path(self) -> Path:
+        """FRZ-EXPECT: one row per executed action() call (expectation or not), beside the ECA telemetry."""
+        return self.state_path.with_name(self.state_path.name.replace("tool_runtime_state.json", "expect.jsonl"))
+
+    def _expect_record(self, expect, grids: list, payloads: list, final_payload: dict) -> None:
+        """FRZ-EXPECT: compare the model's expectation with the executed transition, put the verdict into the result
+        and the echo, keep it on the last executed action's history entry, log one telemetry row per call, and raise the
+        streak note after ECA_FRZ_EXPECT_STREAK consecutive refutations on one level."""
+        level = int(final_payload.get("level") or _level_number(self.game))
+        row: dict = {
+            "action_num": int(self.action_count), "level": level,
+            "executed_actions": list(final_payload.get("executed_actions") or []),
+            "has_expect": expect is not None, "stop_reason": final_payload.get("stop_reason"),
+        }
+        if expect is not None:
+            verdict = _expectation_verdict(expect, grids, payloads)
+            line = _expectation_line(verdict)
+            final_payload["expectation"] = {"held": verdict.get("held"), "line": line, "scope": verdict.get("scope")}
+            echo = str(final_payload.get("action_echo") or "")
+            final_payload["action_echo"] = (echo + "\n" + line) if echo else line
+            if self.history_entries:
+                try:
+                    self.history_entries[-1].result["expectation"] = dict(final_payload["expectation"])
+                except Exception:
+                    pass
+            row.update({"expect": expect, "held": verdict.get("held"), "line": line})
+            n = _expect_streak_n()
+            if verdict.get("held") is False:
+                if self._expect_streak_level != level:
+                    self._expect_streak = 0
+                    self._expect_streak_level = level
+                self._expect_streak += 1
+                if n > 0 and self._expect_streak % n == 0:
+                    note = (
+                        f"Harness note: your last {n} expectations on level {level} were all refuted (the latest: "
+                        f"{line.replace('EXPECTATION REFUTED: ', '', 1)}). The rule you are using for those actions is "
+                        "wrong somewhere. Before acting again, write down what you observed instead and change the "
+                        "hypothesis; then test the changed rule with one action and an expectation."
+                    )
+                    note_fn = getattr(self.analyzer, "note_expectation_streak", None)
+                    if callable(note_fn):
+                        note_fn(note)
+                    row["streak_note"] = True
+            elif verdict.get("held") is True:
+                self._expect_streak = 0
+                self._expect_streak_level = level
+        _append_jsonl(self._expect_telemetry_path(), row)
+
+    def _family_ledger(self) -> Any:
+        if self._toolbox_outcome_ledger is None:
+            from inference.agent.eca_solver_toolbox import FamilyOutcomeLedger
+
+            game_id = str(
+                getattr(self.game, "game_id", "")
+                or getattr(getattr(self.game, "game_spec", None), "game_id", "")
+                or self.game_index
+            )
+            self._toolbox_outcome_ledger = FamilyOutcomeLedger(game=game_id)
+        return self._toolbox_outcome_ledger
+
+    def _episode_mechanic_memory(self, *, max_items: int = 4) -> Any:
+        if self._episode_mechanic_memory_state is None:
+            from arcgym.eca.episode_mechanic_memory import EpisodeMechanicMemory
+
+            self._episode_mechanic_memory_state = EpisodeMechanicMemory(
+                game_key=str(self._family_ledger().game),
+                max_advisory_schemas=max_items,
+            )
+        return self._episode_mechanic_memory_state
+
+    def _mechanic_context_payload(
+        self,
+        current: Frame,
+        mechanic_memory: Any | None,
+    ) -> dict[str, Any]:
+        epoch_entries = _eca_lite_history_epoch(
+            self.history_entries, int(current.level)
+        )
+        history = [
+            {
+                "frame": entry.frame.grid,
+                "action": str(getattr(entry, "action", "") or ""),
+                "level": int(entry.frame.level),
+            }
+            for entry in epoch_entries[-64:]
+        ]
+        previous_frame = (
+            epoch_entries[-2].frame.grid
+            if len(epoch_entries) >= 2
+            else None
+        )
+        memory = {}
+        if mechanic_memory is not None:
+            try:
+                memory = mechanic_memory.runtime_context(level=int(current.level))
+            except Exception:
+                memory = {}
+        return {
+            "frame": current.grid,
+            "level": int(current.level),
+            "score": int(self.game.current_state.levels_completed),
+            "history": history,
+            "previous_action": (
+                str(getattr(epoch_entries[-1], "action", "") or "")
+                if epoch_entries
+                else ""
+            ),
+            "previous_frame": previous_frame,
+            "memory": memory,
+        }
+
+    def _close_family_lease(
+        self,
+        *,
+        level_transition: bool,
+        game_over: bool = False,
+        fallback_reason: str = "",
+    ) -> dict[str, Any] | None:
+        try:
+            return self._family_ledger().close(
+                action_count=self.action_count,
+                level_transition=level_transition,
+                game_over=game_over,
+                fallback_reason=fallback_reason,
+            )
+        except Exception:
+            return None
+
+    def _toolbox_auto_exec_ready(self) -> bool:
+        """Prefix executor (default OFF): execute one leased action per loop.
+
+        A fresh host-side recomputation must preserve the certificate and
+        shrink the private full plan before another action becomes eligible.
+        Any mismatch, plan loss, game over, or lease cap returns to pure Tufa.
+        """
+        if not _eca_port_enabled():
+            return False
+        try:
+            from inference.agent.eca_solver_toolbox import resolve_toolbox_policy
+
+            policy = resolve_toolbox_policy()
+        except Exception:
+            return False
+        if not (
+            policy.get("toolbox_enabled")
+            and policy.get("prefix_executor")
+            and policy.get("auto_execute")
+        ):
+            return False
+        if not self._toolbox_exec_plan:
+            return False
+        if (
+            self._toolbox_auto_exec_count > 0
+            and self._toolbox_exec_full_len >= self._toolbox_auto_exec_last_plan_len
+            and not self._toolbox_progress_verified
+        ):
+            return False  # no progress since the last auto step
+        cap = int(
+            self._toolbox_current_lease_cap
+            or policy.get("lease_max_actions", 2)
+            or 2
+        )
+        if self._toolbox_auto_exec_count >= cap:
+            for family in self._toolbox_last_certified_families:
+                self._toolbox_lease_exhausted.add((family, _level_number(self.game)))
+            self._close_family_lease(
+                level_transition=False, fallback_reason="lease_cap_reached"
+            )
+            self._toolbox_last_certified_families = []
+            self._toolbox_exec_plan = []
+            return False
+        if self._toolbox_last_certified_families:
+            family = self._toolbox_last_certified_families[0]
+            if not _eca_lite_has_exact_prediction(
+                self._toolbox_expected_change,
+                family,
+            ):
+                return False
+        return True
+
+    def _toolbox_action_lease_active(self) -> bool:
+        if not _eca_port_enabled():
+            return False
+        try:
+            from inference.agent.eca_solver_toolbox import resolve_toolbox_policy
+
+            policy = resolve_toolbox_policy()
+        except Exception:
+            return False
+        return bool(
+            policy.get("toolbox_enabled")
+            and policy.get("expose_to_agent")
+            and policy.get("immediate_fallback")
+            and self._toolbox_last_certified_families
+            and self._toolbox_last_certified_level == _level_number(self.game)
+            and self._toolbox_plan_snapshot
+        )
+
+    def _deliver_host_note(self) -> None:
+        """Report the host-executed actions since the model's last turn, as facts, then clear the buffer."""
+        buf, self._host_note_buffer = list(self._host_note_buffer), []
+        if not buf:
+            return
+        n = len(buf)
+        acts = [str(b["action"]) for b in buf]
+        shown = ", ".join(acts[:30]) + (f", ... ({n - 30} more)" if n > 30 else "")
+        lv0, lv1 = int(buf[0]["level_before"]), int(buf[-1]["level_after"])
+        families = sorted({str(b["family"]) for b in buf if b.get("family")})
+        first_num = int(buf[0]["action_num"])
+        lines = [
+            f"Since your last turn the harness played {n} action{'s' if n != 1 else ''} itself, without the model "
+            f"(a plan from its built-in solver{' ' + '/'.join(families) if families else ''}): {shown}.",
+            f"They are in `history` as ordinary steps (step {first_num} to step {self.action_count}), with their "
+            "before/after frames, so you can inspect what each one changed.",
+        ]
+        new_level_actions = 0
+        if lv1 > lv0:
+            done = ", ".join(str(x) for x in range(lv0, lv1))
+            lines.append(f"These actions completed level{'s' if lv1 - lv0 > 1 else ''} {done}; you are now on level {lv1}.")
+            if _hostnote_level_fix_enabled():
+                on_new = [b for b in buf if int(b.get("level_before", -1)) == lv1]
+                completing = [b for b in buf if int(b.get("level_after", -1)) == lv1 and int(b.get("level_before", -1)) < lv1]
+                if on_new and completing:
+                    new_level_actions = len(on_new)
+                    k = int(completing[-1]["action_num"])
+                    lines.append(
+                        f"After completing level {lv1 - 1} it went on to play {len(on_new)} action{'s' if len(on_new) != 1 else ''} on level "
+                        f"{lv1} (steps {k + 1} to {self.action_count}): `current_frame` is level {lv1} after them, not its starting board; "
+                        f"level {lv1}'s starting board is the frame after step {k}."
+                    )
+        else:
+            lines.append(f"You are still on level {lv1}.")
+        if "library" in families:
+            lib_levels = sorted({int(b["level_before"]) for b in buf if b.get("family") == "library"})
+            lines.append("The library actions replay solutions of level%s %s that were found in earlier runs of this game, "
+                         "checked against the board after every action." % ("s" if len(lib_levels) > 1 else "",
+                                                                             ", ".join(str(x) for x in lib_levels)))
+            for lv, done, total, outcome in list(getattr(self, "_library_stops", []) or []):
+                lines.append(f"The stored solution of level {lv} stopped after {done} of its {total} actions "
+                             f"({'the board differed from the stored one' if outcome == 'diverged' else outcome}); "
+                             "the level is yours from here.")
+            self._library_stops = []
+        if any(b.get("game_over") for b in buf):
+            lines.append("One of these actions ended in GAME OVER; the level was reset.")
+        note = dict(self._solver_failnote_pending or {})
+        self._solver_failnote_pending = {}
+        failnote_leveltext = False
+        if note and _solver_failnote_enabled() and int(note.get("level", -1)) == lv1:
+            try:
+                from inference.framework import solver_failnote as _fn
+
+                lines.extend(_fn.note_lines_v5(note) if _fn.v5_enabled() else _fn.note_lines(note))
+                failnote_leveltext = _fn.leveltext_enabled()
+                print(f"eca failnote: {self.game.game_run.game_id} L{lv1} {note.get('family')} {note.get('violation')} steps={note.get('steps')}", flush=True)
+            except Exception as exc:
+                log.warning("%s: solver failnote lines: %s", self.game.game_run.game_id, exc)
+        endfacts_delivered = False
+        if lv1 > lv0 and _solver_endfacts_enabled():
+            try:
+                from inference.framework import solver_failnote as _fn
+
+                ended = {lv: self._solver_endfacts.pop(lv) for lv in range(lv0, lv1) if lv in self._solver_endfacts}
+                if ended:
+                    lines.extend(_fn.endfacts_lines(ended))
+                    endfacts_delivered = True
+                    print(f"eca endfacts: {self.game.game_run.game_id} levels {sorted(ended)} filled "
+                          f"{sum(1 for e in ended.values() if e.get('filled'))}", flush=True)
+            except Exception as exc:
+                log.warning("%s: solver end facts lines: %s", self.game.game_run.game_id, exc)
+        try:
+            run_complete = _is_run_complete(self.game)
+        except Exception:
+            run_complete = False
+        # the agent resets its last-step record when it first opens this game's session (inside analyze), which
+        # would wipe a note delivered before the model's FIRST turn; open the session now (a no-op later)
+        ensure = getattr(self.analyzer, "_ensure_session", None)
+        if callable(ensure):
+            try:
+                ensure(self.state_path)
+            except Exception as exc:
+                log.warning("%s: host note session: %s", self.game.game_run.game_id, exc)
+        note = getattr(self.analyzer, "note_host_actions", None)
+        if callable(note):
+            try:
+                extra = {"new_level_actions": new_level_actions} if new_level_actions else {}
+                if failnote_leveltext and new_level_actions:
+                    extra["solver_failnote"] = True
+                    try:
+                        from inference.framework import solver_failnote as _fn
+
+                        if endfacts_delivered and _fn.endfacts_text_enabled():
+                            extra["solver_endfacts"] = True
+                    except Exception as exc:
+                        log.warning("%s: solver end facts text: %s", self.game.game_run.game_id, exc)
+                note(lines, executed_count=n, end_action_num=self.action_count, level=lv1,
+                     level_transition=lv1 > lv0, run_complete=bool(run_complete), **extra)
+                print(f"eca host note: {self.game.game_run.game_id} actions={n} levels {lv0}->{lv1}", flush=True)
+            except Exception as exc:
+                log.warning("%s: host note delivery: %s", self.game.game_run.game_id, exc)
+
+    def _solver_failnote_capture(self, family: str, level: int, violation: str, diagnostic: dict | None, current: "Frame",
+                                 executed_display: str | None = None) -> None:
+        """Keep what the next host note needs about a family's rejected lease (ECA_FRZ_SOLVER_FAILNOTE): the family's model
+        (stashed at lease begin), how many of its actions this level saw, the last one, its signed prediction, the verifier's
+        reason and the object-level change the action made. Only when the family played at least the minimum number of
+        actions on the level - a one-action misfire of a wrong family carries nothing worth telling."""
+        from inference.framework import solver_failnote as _fn
+
+        if str(violation or "") not in _fn.REJECTIONS:
+            return
+        steps = [b for b in self._host_note_buffer
+                 if str(b.get("family") or "") == str(family) and int(b.get("level_before", -1)) == int(level)]
+        # v2 (11-01): this evaluation runs before _toolbox_auto_exec_one appends the action it just executed to the host-note
+        # buffer, so the rejected action is the one in `executed`, not the buffer's last entry; count it too
+        count = len(steps) + (1 if executed_display else 0)
+        last_action = str(executed_display) if executed_display else (str(steps[-1].get("action", "")) if steps else "")
+        if count < _fn.min_steps():
+            return
+        lease = dict(self._solver_failnote_lease) if str(self._solver_failnote_lease.get("family", "")) == str(family) else {}
+        exact = (self._toolbox_expected_change or {}).get("runtime_mechanic_exact")
+        prediction = exact.get("prediction") if isinstance(exact, dict) else None
+        changes: list[str] = []
+        if len(self.history_entries) >= 2:
+            try:
+                from inference.utils import board_digest as _bd
+
+                changes = [str(x) for x in _bd.object_changes(self.history_entries[-2].frame.grid, current.grid, border=4)[0]][:6]
+            except Exception as exc:
+                log.warning("%s: solver failnote changes: %s", self.game.game_run.game_id, exc)
+        self._solver_failnote_pending = {
+            **{k: v for k, v in lease.items() if k != "level"},
+            "family": str(family), "level": int(level), "steps": count, "last_action": last_action,
+            "violation": str(violation or ""),
+            "verifier": str((diagnostic or {}).get("reason") or (diagnostic or {}).get("classification") or ""),
+            "prediction": _fn.prediction_text(prediction, self._toolbox_expected_change), "changes": changes,
+        }
+        if _fn.v5_enabled():
+            # v5 (11-02): the plan of the evaluation before this action, stashed at its end; its first action is the one just
+            # executed, so the rest is what the solver still meant to play
+            plan = [str(x) for x in (getattr(self, "_solver_failnote_plan", None) or [])]
+            if plan and plan[0] == last_action:
+                self._solver_failnote_pending["remaining_plan"] = plan[1:]
+
+    def _proven_family_kwargs(self) -> dict[str, Any]:
+        """The proven-family kwargs for compute_solver_plans (ECA_FRZ_PROVEN_FAMILY): per-family timeouts for the families with a
+        success on this game, and the successes for the arbitration tie-break; empty when the flag is off."""
+        if not _proven_family_enabled():
+            return {}
+        try:
+            successes = {str(k): int(v or 0) for k, v in dict(getattr(self._family_ledger(), "successes", {}) or {}).items()}
+        except Exception:
+            return {}
+        timeout = _proven_family_timeout_ms()
+        return {
+            "priority_timeouts": {fam: timeout for fam, n in successes.items() if n > 0},
+            "family_successes": successes,
+        }
+
+    def _toolbox_auto_exec_one(self) -> bool:
+        action = _model_step_to_action_input(self._toolbox_exec_plan[0])
+        if action is None:
+            return False
+        self._toolbox_auto_exec_last_plan_len = self._toolbox_exec_full_len
+        self._toolbox_auto_exec_count += 1
+        self._toolbox_progress_verified = False
+        try:
+            self._family_ledger().record_execution(llm_turn_skipped=True)
+        except Exception:
+            pass
+        self._mechanic_action_source_family = (
+            self._toolbox_last_certified_families[0]
+            if self._toolbox_last_certified_families
+            else ""
+        )
+        level_before = _level_number(self.game) if _host_note_enabled() else 0
+        family_for_note = self._mechanic_action_source_family
+        try:
+            self._execute_action(
+                action, batch_index=1, batch_size=1, generated_tokens=0
+            )
+        finally:
+            self._mechanic_action_source_family = ""
+        if _host_note_enabled():
+            try:
+                self._host_note_buffer.append({
+                    "action": _format_action_display(action.id.name, dict(action.data)),
+                    "level_before": int(level_before), "level_after": int(_level_number(self.game)),
+                    "game_over": bool(_is_engine_game_over(self.game)), "family": str(family_for_note or ""),
+                    "action_num": int(self.action_count),
+                })
+            except Exception as exc:
+                log.warning("%s: host note buffer: %s", self.game.game_run.game_id, exc)
+        return True
+
+    def _eca_lite_toolbox_advice(
+        self, current: Frame, eca_advice: dict[str, Any] | None
+    ) -> dict[str, Any] | None:
+        """Compute private ECA telemetry and a least-privilege agent view.
+
+        A plan is revoked for the current level after any LLM deviation,
+        multi-action batch, game over, lost certificate, or failure of the
+        family progress proof or remaining plan to shrink after the one
+        permitted action.
+        """
+        try:
+            from inference.agent.eca_solver_toolbox import (
+                compute_solver_plans,
+                grounded_progress_matches,
+                grounded_transition_diagnostic,
+                grounded_transition_matches,
+                project_solver_plans,
+                resolve_toolbox_policy,
+                shadow_sample_due,
+            )
+        except Exception as exc:
+            _append_jsonl(
+                self._eca_telemetry_path(),
+                {"step": int(self.analysis_step), "mode": "unavailable", "error": str(exc)},
+            )
+            return eca_advice
+
+        policy = resolve_toolbox_policy()
+        if policy.get("mode") == "legacy":
+            return eca_advice
+        level = int(current.level)
+        action_count = int(self.action_count)
+        transition = self._toolbox_last_transition
+        if transition and not transition.get("ledger_consumed"):
+            level_changed = int(transition.get("level_before", level)) != int(
+                transition.get("level_after", level)
+            )
+            active = self._family_ledger().active
+            owned_score = _eca_lite_transition_score_owned(transition, active)
+            if owned_score:
+                owned_family = str(transition.get("source_family", "") or "")
+                if owned_family in self._toolbox_last_inherited_families:
+                    try:
+                        self._episode_mechanic_memory().record_inheritance_outcome(
+                            family=owned_family,
+                            level=int(transition.get("level_before", level)),
+                            evidence_key=f"score:{action_count}",
+                            accepted=True,
+                            reason="score_owned",
+                        )
+                    except Exception:
+                        pass
+                self._close_family_lease(level_transition=True)
+                # The scoring transition has already closed the old lease
+                # under explicit source/action ownership. Do not run the old
+                # prefix through a second post-score certificate check (WIN
+                # may keep the same numeric level).
+                self._toolbox_last_certified_families = []
+                self._toolbox_plan_snapshot = []
+                self._toolbox_exec_plan = []
+                self._toolbox_expected_change = {}
+                self._toolbox_last_inherited_families = []
+            elif level_changed and active:
+                self._close_family_lease(
+                    level_transition=False,
+                    fallback_reason="unowned_level_transition",
+                )
+            transition["score_owned"] = owned_score
+            transition["ledger_consumed"] = True
+        shadow_followup = bool(
+            policy.get("mode") == "shadow"
+            and self._toolbox_shadow_pending
+            and action_count > int(self._toolbox_shadow_pending.get("action_count", -1))
+        )
+        if not shadow_followup and not shadow_sample_due(
+            policy,
+            level=level,
+            action_count=action_count,
+            last_level=self._toolbox_shadow_sample_level,
+            last_action_count=self._toolbox_shadow_sample_action_count,
+        ):
