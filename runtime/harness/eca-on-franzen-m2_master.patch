+def _expect_cells(raw) -> tuple[list[tuple[int, int]], str | None]:
+    cells: list[tuple[int, int]] = []
+    if isinstance(raw, dict) or not isinstance(raw, (list, tuple)):
+        return [], "cells must be a list of [row, col]"
+    for item in raw:
+        try:
+            r, c = int(item[0]), int(item[1])
+        except (TypeError, ValueError, IndexError, KeyError):
+            return [], "cells must be a list of [row, col]"
+        cells.append((r, c))
+    return cells, None
+
