+            else:
+                n["deaths_missed"] += 1
+                if len(examples) < show:
+                    examples.append({"transition": index, "action": action,
+                                     "issue": "this action ended the attempt (GAME OVER); step() predicted a board"})
+            continue
+        n["board_checks"] += 1
+        if predicted is None:
+            n["abstained"] += 1
+            continue
+        if predicted == MC_GAME_OVER:
+            n["false_deaths"] += 1
+            if len(examples) < show:
+                examples.append({"transition": index, "action": action,
+                                 "issue": "step() predicted GAME OVER, the attempt went on"})
+            continue
+        # a transition that changed the board (outside the border) is the evidence that tests a rule; a step that
+        # predicts "nothing changes" is exact on every no-op, so the report also counts the changing ones it got right
+        changing = bool(mc_diff_cells(before, after, border))
+        if changing:
+            n["changing_checks"] += 1
+        cells = mc_diff_cells(predicted, after, border)
+        if cells == []:
+            n["exact"] += 1
+            if changing:
+                n["exact_changing"] += 1
+            continue
+        n["mismatched"] += 1
+        if len(examples) >= show:
+            continue
+        if cells is None:
+            examples.append({"transition": index, "action": action,
+                             "issue": "predicted board is %dx%d, actual %dx%d" % (
+                                 len(predicted), len(predicted[0]) if predicted else 0,
+                                 len(after), len(after[0]) if after else 0)})
+            continue
+        example = {"transition": index, "action": action, "differing_cells": len(cells),
+                   "cells_row_col_predicted_actual": [list(c) for c in cells[:_MC_CELL_LIMIT]]}
+        if _mc_only_outer(cells, len(after), len(after[0]) if after else 0):
+            example["note"] = "every differing cell is in the outer 4 rows/columns (a HUD bar?); border=4 ignores them"
+        examples.append(example)
+    rep = {"transitions": len(records), **n}
+    if stopped:
+        rep["stopped"] = stopped
+    if examples:
+        rep["first_mismatches"] = examples
+    if first_error:
+        rep["first_error"] = first_error
+    if goal is not None:
+        if goal_examples:
+            g["first_goal_issues"] = goal_examples
+        rep["goal"] = g
+    wrong = n["mismatched"] + n["false_deaths"] + n["deaths_missed"] + n["errors"]
+    judged = n["exact"] + n["mismatched"] + n["false_deaths"] + n["deaths_predicted"] + n["deaths_missed"]
+    if not records:
+        rep["verdict"] = "no transition recorded on this level yet"
+    elif wrong == 0 and judged == 0:
+        rep["verdict"] = "step() abstained on every recorded transition"
+    elif wrong == 0:
+        rep["verdict"] = "consistent with all %d judged transitions (%d of them changed the board; %d abstained)" % (
+            judged, n["exact_changing"], n["abstained"] + n["deaths_abstained"])
+    else:
+        rep["verdict"] = ("contradicted: %d board mismatches, %d false deaths, %d missed deaths, %d errors"
+                          % (n["mismatched"], n["false_deaths"], n["deaths_missed"], n["errors"]))
+    return rep
+
+
+def mc_plan(step, goal, start, actions, heuristic=None, astar=False, key=None, max_nodes=100000, deadline=None,
+            max_depth=None):
+    """Search the model from `start` (see find_plan in mc_install for the result's fields)."""
+    t0 = _mc_time.monotonic()
+    key = key or (lambda board: board)
+    res = {"found": False, "actions": [], "length": 0, "expanded": 0, "states": 1, "stopped": None,
+           "step_errors": 0, "goal_errors": 0, "abstained": 0, "deaths_pruned": 0}
+    if not actions:
+        res.update(stopped="no actions to search: pass actions=[...] (clicks as 'MOUSE(row=r, col=c)')", seconds=0.0)
+        return res
+    hit, err = _mc_call(goal, start)
+    if err is None and hit:
+        res.update(found=True, stopped="goal already true on the start board", seconds=0.0)
+        return res
+    start_key = key(start)
+    parents = {start_key: None}
+    counter = 0
+    best = None
+    if heuristic is not None:
+        h0, herr = _mc_call(heuristic, start)
+        h0 = float(h0) if herr is None and h0 is not None else 0.0
+        best = (h0, start_key)
+        frontier = [(h0, counter, 0, start, start_key)]
+    else:
+        frontier = _mc_deque([(0, start, start_key)])
+    first_error = None
+
+    def _path(k):
+        out = []
+        while parents[k] is not None:
+            k, a = parents[k]
+            out.append(a)
+        out.reverse()
+        return out
+
+    while frontier:
+        if heuristic is not None:
+            _f, _c, depth, board, bkey = _mc_heapq.heappop(frontier)
+        else:
+            depth, board, bkey = frontier.popleft()
+        if max_depth is not None and depth >= max_depth:
+            res["stopped"] = res["stopped"] or "depth_limit"
+            continue
+        res["expanded"] += 1
+        for action in actions:
+            raw, err = _mc_call(step, board, action)
+            if err is None:
+                try:
+                    nxt = mc_normalize_board(raw)
+                except TypeError as exc:
+                    err = str(exc)
+            if err is not None:
+                res["step_errors"] += 1
+                first_error = first_error or "step(board, %r): %s" % (action, err)
+                continue
+            if nxt is None:
+                res["abstained"] += 1
+                continue
+            if nxt == MC_GAME_OVER:
+                res["deaths_pruned"] += 1
+                continue
+            nkey = key(nxt)
+            if nkey in parents:
+                continue
+            parents[nkey] = (bkey, action)
+            hit, gerr = _mc_call(goal, nxt)
+            if gerr is not None:
+                res["goal_errors"] += 1
+                first_error = first_error or "goal(board): %s" % gerr
+            elif hit:
+                path = _path(nkey)
+                res.update(found=True, actions=path, length=len(path), stopped="goal",
+                           states=len(parents), seconds=round(_mc_time.monotonic() - t0, 2))
+                if first_error:
+                    res["first_error"] = first_error
+                return res
+            if heuristic is not None:
+                h, herr = _mc_call(heuristic, nxt)
+                h = float(h) if herr is None and h is not None else float("inf")
+                if best is None or h < best[0]:
+                    best = (h, nkey)
+                counter += 1
+                _mc_heapq.heappush(frontier, (h + (depth + 1 if astar else 0), counter, depth + 1, nxt, nkey))
+            else:
+                frontier.append((depth + 1, nxt, nkey))
+        if len(parents) >= max_nodes:
+            res["stopped"] = "node_limit"
+            break
+        if deadline is not None and _mc_time.monotonic() > deadline:
+            res["stopped"] = "time_limit"
+            break
+    res["states"] = len(parents)
+    res["stopped"] = res["stopped"] or "exhausted: no state reachable under this model satisfies goal"
+    res["seconds"] = round(_mc_time.monotonic() - t0, 2)
+    if best is not None and best[1] != start_key:
+        path = _path(best[1])
+        res["closest_by_heuristic"] = {"heuristic": best[0], "actions": path[:60], "length": len(path)}
+    if first_error:
+        res["first_error"] = first_error
+    return res
+
+
+def mc_install(runtime_globals, action_fn, stale_state, terminal_state, log, timeout_seconds):
+    """Install board_of / verify_model / find_plan / run_plan into a snippet's globals. `log` collects one compact
+    record per call for the host's telemetry; `stale_state` / `terminal_state` are the snippet's own guard lists."""
+    started = _mc_time.monotonic()
+
+    def _deadline(seconds, reserve):
+        left = timeout_seconds - (_mc_time.monotonic() - started) - reserve
+        cap = left if seconds is None else min(float(seconds), left)
+        return _mc_time.monotonic() + max(0.5, cap)
+
+    def _current_level():
+        return getattr(runtime_globals.get("current_frame"), "level", None)
+
+    def board_of(frame=None):
+        """board_of(frame=current_frame) -> the board as a tuple of `.ascii` row strings (row r, column c is
+        board[r][c]); step(board, action) receives and returns boards in this form."""
+        return mc_board_of(runtime_globals.get("current_frame") if frame is None else frame)
+
+    def verify_model(step, goal=None, border=0, levels=None, show=3):
+        """Replay step(board, action) over every transition recorded on the current level (levels=[...] or 'all'
+        for others) and compare each prediction with what happened. step returns the next board, None to abstain,
+        or 'GAME_OVER' to predict that the action ends the attempt. Returns counts (exact / mismatched / abstained /
+        errors / deaths) and the first mismatches cell by cell as [row, col, predicted, actual]; border=k ignores k
+        cells at every edge (e.g. a HUD bar). With goal(board), also checks that goal is false on every recorded
+        board that did not complete the level and true on step(before, action) for the actions that did."""
+        if levels is None:
+            wanted = {_current_level()}
+        elif levels == "all":
+            wanted = None
+        else:
+            wanted = set(levels) if isinstance(levels, (list, tuple, set)) else {levels}
+        records = mc_records(runtime_globals.get("transitions"), wanted)
+        rep = mc_verify(step, records, goal=goal, border=int(border), show=int(show), deadline=_deadline(None, 4.0))
+        log.append({"fn": "verify_model", "level": _current_level(), "transitions": rep["transitions"],
+                    "board_checks": rep["board_checks"], "exact": rep["exact"], "mismatched": rep["mismatched"],
+                    "abstained": rep["abstained"], "errors": rep["errors"], "deaths_recorded": rep["deaths_recorded"],
+                    "deaths_predicted": rep["deaths_predicted"], "changing_checks": rep["changing_checks"],
+                    "exact_changing": rep["exact_changing"], "goal": goal is not None, "border": int(border)})
+        return rep
+
+    def find_plan(step, goal, actions=None, start=None, heuristic=None, astar=False, border=0, max_nodes=100000,
+                  seconds=None, max_depth=None):
+        """Search your model for actions that make goal(board) true: BFS (shortest plan) by default, best-first on
+        heuristic(board) (lower is better; astar=True adds the path length). actions defaults to the keyboard
+        actions in valid_actions; give clicks explicitly, e.g. ['UP', 'MOUSE(row=3, col=5)']. border=k treats two
+        boards that differ only in the outer k cells as one state. Stops at max_nodes states or the time left in
+        this snippet (seconds caps it). Returns found, actions, length, states, seconds, stopped and error counts;
+        with a heuristic and no solution, closest_by_heuristic."""
+        if actions is None:
+            actions = [a for a in (runtime_globals.get("valid_actions") or [])
+                       if str(a).upper() not in _MC_UNPLANNABLE and str(a).upper() != "MOUSE"]
+        acts = []
+        for a in actions:
+            text = mc_action_text(a)
+            if text and text not in acts and text not in _MC_UNPLANNABLE:
+                acts.append(text)
+        board = mc_board_of(runtime_globals.get("current_frame") if start is None else start)
+        width = int(border)
+        key = (lambda b, w=width: tuple(row[w:len(row) - w] for row in b[w:len(b) - w])) if width > 0 else None
+        res = mc_plan(step, goal, board, acts, heuristic=heuristic, astar=bool(astar), key=key,
+                      max_nodes=int(max_nodes), deadline=_deadline(seconds, 5.0), max_depth=max_depth)
+        log.append({"fn": "find_plan", "level": _current_level(), "found": res["found"], "length": res["length"],
+                    "states": res["states"], "stopped": str(res["stopped"])[:40], "seconds": res.get("seconds"),
+                    "n_actions": len(acts), "heuristic": heuristic is not None})
+        return res
+
+    def run_plan(actions, step=None, border=0):
+        """Execute actions one at a time with the real action(). With step, each result is compared with what
+        step(board, action) predicted and the run stops at the first difference (outside border cells); it also
+        stops at a GAME OVER and at a level completion. Returns executed, outcome ('plan_done', 'level_completed',
+        'game_over', 'mismatch', 'refused', 'step_error') and, for a mismatch, the differing cells."""
+        requested = list(actions or [])
+        executed = []
+        outcome = "plan_done"
+        detail = {}
+        width = int(border)
+        try:
+            for raw in requested:
+                if terminal_state:
+                    outcome = "stopped_terminal"
+                    break
+                text = mc_action_text(raw)
+                predicted = None
+                if step is not None:
+                    value, err = _mc_call(step, mc_board_of(runtime_globals.get("current_frame")), text)
+                    if err is None:
+                        try:
+                            predicted = mc_normalize_board(value)
+                        except TypeError as exc:
+                            err = str(exc)
+                    if err is not None:
+                        outcome, detail = "step_error", {"action": text, "error": err}
+                        break
+                result = action_fn([mc_action_payload(text)]) or {}
+                if not result.get("executed", True) and not result.get("executed_count"):
+                    outcome, detail = "refused", {"action": text, "stop_reason": result.get("stop_reason"),
+                                                  "detail": str(result.get("stop_detail") or "")[:300]}
+                    break
+                executed.append(text)
+                if result.get("level_completed") or result.get("run_complete") or result.get("done"):
+                    outcome = "level_completed"
+                    break
+                if result.get("game_over"):
+                    outcome, detail = "game_over", {"action": text, "death_predicted": predicted == MC_GAME_OVER}
+                    break
+                if predicted is None:
+                    continue
+                if predicted == MC_GAME_OVER:
+                    outcome, detail = "mismatch", {"at": len(executed), "action": text,
+                                                   "issue": "step() predicted GAME OVER, the attempt went on"}
+                    break
+                cells = mc_diff_cells(predicted, mc_board_of(runtime_globals.get("current_frame")), width)
+                if cells is None:
+                    outcome, detail = "mismatch", {"at": len(executed), "action": text,
+                                                   "issue": "the predicted board has a different shape"}
+                    break
+                if cells:
+                    outcome, detail = "mismatch", {"at": len(executed), "action": text, "differing_cells": len(cells),
+                                                   "cells_row_col_predicted_actual": [list(c) for c in
+                                                                                      cells[:_MC_CELL_LIMIT]]}
+                    break
+                # the prediction held exactly: whatever this action did or did not change, the snippet's picture of
+                # the board is current, which is all the stale-state guard protects
+                del stale_state[:]
+        finally:
+            log.append({"fn": "run_plan", "level": _current_level(), "requested": len(requested),
+                        "executed": len(executed), "outcome": outcome, "checked": step is not None})
+        out = {"executed": executed, "outcome": outcome}
+        out.update(detail)
+        return out
+
+    runtime_globals["board_of"] = board_of
+    runtime_globals["verify_model"] = verify_model
+    runtime_globals["find_plan"] = find_plan
+    runtime_globals["run_plan"] = run_plan
+    return runtime_globals
