+def _status_sheet_actions() -> int:
+    """Status sheet (kojimatech 10-31; docs/status_sheet_registration_2026-10-31.md). ECA_FRZ_STATUS_SHEET=N > 0:
+    after every N actions on a level without completing it, the opener closes with the harness's observed record of
+    the level and a fixed form; the model fills it by binding STATUS_SHEET = {...} in its next python call. The sheet
+    is retained through the constants channel (this one name only), shown compactly in the level's later openers,
+    and dropped at the level change. Needs ECA_FRZ_DIGEST and ARC3_PERSISTENT_FUNCTIONS. 0 (default) = off."""
+    return max(0, _get_env_int("ECA_FRZ_STATUS_SHEET", 0)) if _persistent_functions() else 0
