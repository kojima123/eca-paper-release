+def _solve_stride_maze(
+    arr: np.ndarray,
+    engine_valid: set[str],
+    *,
+    level: int = 0,
+    mechanic_context: Mapping[str, Any] | None = None,
+) -> tuple[dict[str, Any], dict[str, Any] | None]:
