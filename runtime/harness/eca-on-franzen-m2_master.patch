+def _eca_lite_history_epoch(
+    entries: list[HistoryEntry], current_level: int
+) -> list[HistoryEntry]:
+    """Return the current epoch with its boundary frame as an actionless seed."""
+
+    start = 0
+    sanitize_boundary = False
+    previous_level: int | None = None
+    for index, entry in enumerate(entries):
+        entry_level = int(entry.frame.level)
+        action = str(getattr(entry, "action", "") or "").strip().upper()
+        if entry_level != int(current_level):
+            start = index + 1
+            sanitize_boundary = False
+        elif action == "RESET":
+            start = index
+            sanitize_boundary = True
+        elif previous_level is not None and previous_level != entry_level:
+            # The first frame of a new level belongs to the scoring action
+            # taken in the old level. Keep the new initial frame but erase the
+            # old-level action so temporal readers get a clean anchor.
+            start = index
+            sanitize_boundary = True
+        previous_level = entry_level
+    epoch = list(entries[start:])
