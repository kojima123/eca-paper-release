+    def _modeler_gate_update(self, current_frame) -> None:
+        """Free first: per level, the regime opens once the level has seen N actions and M minutes (counted from
+        the first python call on the level); sticky until the level changes."""
+        try:
+            m = self._modeler
+            step_now = int(getattr(current_frame, "step", -1))
+            if step_now < 0:
+                return
+            if m.get("level_start_step") is None:
+                m["level_start_step"] = step_now
+                m["level_start_time"] = time.monotonic()
+            m["level_actions"] = step_now - int(m["level_start_step"])
+            m["level_minutes"] = (time.monotonic() - float(m["level_start_time"])) / 60.0
+            if not m.get("gate_open") and m["level_actions"] >= _modeler_gate_actions() \
+                    and m["level_minutes"] >= _modeler_gate_minutes():
+                m["gate_open"] = True
+                m["gate_just_opened"] = True   # verify whatever step was written during free play
+                self._modeler_stats["gate_opened"] = self._modeler_stats.get("gate_opened", 0) + 1
+        except Exception:
+            pass
