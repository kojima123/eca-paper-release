+def _simplan2_budget_step(budget: dict[str, Any], entries: list[dict[str, Any]], now: float,
+                         verify_cap: int, seconds_cap: float) -> str:
+    """SIMPLAN-2b: fold one snippet's model_check entries (may be []) into this level's budget; returns the reason
+    when the budget locks now, else ''. budget = {level, started, verify, found, locked} (level None = no task yet)."""
+    if budget.get("level") is None or budget.get("locked"):
+        return ""
+    for e in entries:
+        if e.get("fn") == "verify_model" and not e.get("refused"):
+            budget["verify"] = int(budget.get("verify") or 0) + 1
+        elif e.get("fn") == "find_plan" and e.get("found"):
+            budget["found"] = True
+    if budget.get("found"):
+        return ""
+    why = ""
+    if verify_cap and int(budget.get("verify") or 0) >= verify_cap:
+        why = f"{int(budget['verify'])} verify_model calls"
+    elif seconds_cap and now - float(budget.get("started") or now) >= seconds_cap:
+        why = f"{int((now - float(budget['started'])) // 60)} minutes of your turns since the task"
+    if why:
