+            g["level_ups"] += 1
+            hit, gerr = (None, "step() gave no board") if predicted in (None, MC_GAME_OVER) else _mc_call(goal, predicted)
+            if gerr is None and hit:
+                g["goal_true_at_level_up"] += 1
+            else:
+                g["goal_false_at_level_up"] += 1
+                if len(goal_examples) < show:
+                    goal_examples.append({"transition": index, "action": action,
+                                          "issue": "this action completed the level, but goal(step(before, action)) "
