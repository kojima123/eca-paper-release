+def _think_budget_tokens() -> int:
+    """Per-request thinking budget in generated tokens (ECA_FRZ_THINK_BUDGET_TOKENS). 0 (default) = off: the turn
+    loop's requests are untouched. N > 0: a step's request is capped at N tokens, and a reply that stopped inside
+    its think block (finish_reason=length, reasoning only: no content, no tool call) is continued once with
+    `continue_final_message` - the truncated reasoning, Qwen's early-stop sentence and a closed think block go back
+    as the final assistant message's content, so the server renders them as the prefix of the reply and the model
+    answers from its thinking instead of thinking on (or being nudged to start over)."""
+    return max(0, _get_env_int("ECA_FRZ_THINK_BUDGET_TOKENS", 0))
+
+
+def _think_adaptive_budgets() -> tuple[int, int] | None:
+    """Adaptive thinking budget (kojimatech 10-29; docs/think_adaptive_registration_2026-10-29.md). ECA_FRZ_THINK_NOVEL_TOKENS
+    and ECA_FRZ_THINK_ROUTINE_TOKENS both > 0 switch it on (with ECA_FRZ_DIGEST, whose per-level effect ledger says
+    what is new): a turn that follows an executed sequence with an effect new on its level, a level change or a game
+    over gets the novel budget; a turn after a sequence of known effects gets the routine budget. The FRZ-THINK
+    continuation applies at either cap. Returns (novel, routine) or None."""
+    novel = max(0, _get_env_int("ECA_FRZ_THINK_NOVEL_TOKENS", 0))
+    routine = max(0, _get_env_int("ECA_FRZ_THINK_ROUTINE_TOKENS", 0))
+    return (novel, routine) if novel and routine and _digest_enabled() else None
+
+
+def _think_stall_actions() -> int:
+    """Stall-aware adaptive budget (kojimatech 10-30; docs/think_stall_registration_2026-10-30.md). With the adaptive
+    budgets on, ECA_FRZ_THINK_STALL_ACTIONS=N > 0 also gives the novel budget to every turn on a level that has taken
+    N or more actions without a level change (the model is lost on the level: reasoning there is goal hunting, and
+    long thinking on such levels pays off as often as elsewhere), so the routine budget applies only while the level
+    is progressing on known effects. 0 (default) = the plain adaptive rule."""
+    return max(0, _get_env_int("ECA_FRZ_THINK_STALL_ACTIONS", 0))
+
+
+def _stall_inventory_actions() -> int:
+    """Stall inventory (kojimatech 10-30; docs/stall_inventory_registration_2026-10-30.md). ECA_FRZ_STALL_INVENTORY=N
+    > 0: after an executed sequence on a level that has taken N or more actions without a level change, the opener
+    carries one line with this level's full try record (ledger keys with counts) and what was never tried (valid
+    actions and on-board object kinds without a ledger entry). Needs ECA_FRZ_DIGEST. 0 (default) = off."""
+    return max(0, _get_env_int("ECA_FRZ_STALL_INVENTORY", 0))
+
+
+def _stinv_mode() -> str:
+    """Staged grounds (kojimatech 10-30; docs/stinv_grounds_registration_2026-10-30.md). ECA_FRZ_STINV_MODE =
+    'conclusion' (the record plus the instruction to execute one never-tried item, nothing supporting it) or
+    'grounds' (the record plus the derivation material only, no instruction). Either renders the stuck-level block
+    as the opener's final paragraph instead of a digest line. Needs ECA_FRZ_STALL_INVENTORY > 0. '' (default) =
+    the plain inventory line."""
+    v = str(os.environ.get("ECA_FRZ_STINV_MODE", "")).strip().lower()
+    return v if v in ("grounds", "conclusion") else ""
