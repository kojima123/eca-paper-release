+class Level1Explorer:
+    """FL on one play. See the module docstring for `step` / `reset` and the stop rules."""
+
+    def __init__(self, step: Callable[[int, int | None, int | None], Any], reset: Callable[[], Any], *,
+                 budget: int = 4000, time_cap: float = 1800.0, should_stop: Callable[[], bool] | None = None,
+                 stop_at_level_up: bool = True, on_action: Callable[[tuple, Any], None] | None = None,
+                 submit_first: bool = False):
+        self._step_fn, self._reset_fn = step, reset
+        self.budget, self.time_cap = int(budget), float(time_cap)
+        self._should_stop = should_stop
+        self.stop_at_level_up = bool(stop_at_level_up)
+        self._on_action = on_action
+        self.spent = 0
+        self.observation = None
+        self.hud: frozenset = frozenset()
+        self.dead: dict = {}
+        self.level_ups: list = []
