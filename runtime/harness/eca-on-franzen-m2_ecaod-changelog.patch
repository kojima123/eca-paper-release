+"""Solver failure note (kojimatech 2026-11-01, docs/failnote_registration_2026-11-01.md; ECA_FRZ_SOLVER_FAILNOTE=1, default off).
+
+When a certified family's lease ends on a verifier rejection after it played several actions on the level, the next host
+note also tells the model what the family's model of the level was (its transition rule, goal and invariants), the action at
+which it broke, what it had predicted, why the harness rejected the frame and what the action changed, and asks the model to
+work out what that model missed before continuing. Facts the harness already holds, in the harness's words; no advice on the
+goal. Pure helpers here; the solver keeps the hooks (lease begin, the rejection, the host note).
+"""
+from __future__ import annotations
+
+import os
+import re
+from typing import Any
+
+REJECTIONS = ("grounded_transition_mismatch", "mechanic_progress_mismatch", "plan_did_not_shrink", "certificate_lost_after_action")
+
+
+def enabled() -> bool:
+    return str(os.environ.get("ECA_FRZ_SOLVER_FAILNOTE", "0") or "0").strip() == "1"
+
+
+def v5_enabled() -> bool:
+    """v5 (kojimatech 11-02, ECA_FRZ_SOLVER_FAILNOTE_V5=1 on top of ECA_FRZ_SOLVER_FAILNOTE=1, default off;
+    docs/failnote_behaviour_analysis_2026-11-02.md): the note says what the last action did and that it took effect, tells an
+    unsupported prediction ("no exact prediction") apart from a wrong one instead of calling both a break, gives the solver's
+    remaining plan, and drops the solver-internal wording the models could not use (the goal relation, the falsifiers, the
+    progress measure, the verifier's labels)."""
+    return enabled() and str(os.environ.get("ECA_FRZ_SOLVER_FAILNOTE_V5", "0") or "0").strip() == "1"
+
+
+def leveltext_enabled() -> bool:
+    """Level-start text after a note (kojimatech 11-02, ECA_FRZ_SOLVER_FAILNOTE_LEVELTEXT=1 on top of ECA_FRZ_SOLVER_FAILNOTE=1,
+    default off; docs/failnote_behaviour_analysis_2026-11-02.md, "When the model sets the note aside"): when the note comes at a
+    level start, the level-start text that follows it no longer tells the model to build a new plan and reassess the goal - the
+    opposite of the note's "keep the part that held" - but to start the level from the solver's model in the note."""
+    return enabled() and str(os.environ.get("ECA_FRZ_SOLVER_FAILNOTE_LEVELTEXT", "0") or "0").strip() == "1"
+
+
+def min_steps() -> int:
+    try:
+        return max(1, int(str(os.environ.get("ECA_FRZ_SOLVER_FAILNOTE_MIN_STEPS", "3") or "3").strip()))
+    except ValueError:
+        return 3
+
+
+def lease_record(plan: dict | None, level: int) -> dict[str, Any]:
+    """What a certified plan entry says about the family's model: the schema's operator / goal / invariants / falsifiers."""
+    plan = plan if isinstance(plan, dict) else {}
+    runtime = plan.get("runtime_mechanic") if isinstance(plan.get("runtime_mechanic"), dict) else {}
+    schema = runtime.get("schema") if isinstance(runtime.get("schema"), dict) else {}
+    grounding = plan.get("grounded_observation") if isinstance(plan.get("grounded_observation"), dict) else {}
+    expected = grounding.get("expected_change") if isinstance(grounding.get("expected_change"), dict) else {}
+    operator = schema.get("operator") if isinstance(schema.get("operator"), dict) else {}
+    transition = operator.get("transition") or expected.get("rule") or operator.get("kind") or ""
+    return {
+        "family": str(plan.get("family", "") or ""),
+        "level": int(level),
+        "transition": str(transition),
+        "goal": str(schema.get("goal_relation") or ""),
+        "invariants": [str(x) for x in (schema.get("invariants") or grounding.get("invariants") or [])][:3],
+        "falsifiers": [str(x) for x in (schema.get("falsifiers") or grounding.get("falsifiers") or [])][:3],
+    }
+
+
+def prediction_text(prediction: Any, expected_change: Any) -> str:
+    """A short statement of what the family predicted for its last action, from the prediction it signed."""
+    parts: list[str] = []
+    if isinstance(prediction, dict):
+        kind = prediction.get("kind") or prediction.get("operation")
+        if kind:
+            parts.append(str(kind).replace("_", " "))
+        if prediction.get("supported") is False or prediction.get("accepted") is False:
+            parts.append("no exact prediction (%s)" % str(prediction.get("reason") or "unsupported").replace("_", " "))
+        for key in ("expected_endpoint", "trace_certainty", "selected_sprite_after", "anchor_deficit_before", "anchor_deficit_after"):
+            value = prediction.get(key)
+            if value not in (None, "", [], {}):
+                parts.append("%s %s" % (key.replace("_", " "), value))
+        trace = prediction.get("trace")
+        if isinstance(trace, list) and trace:
+            parts.append("a trace of %d steps" % len(trace))
+    measure = expected_change.get("progress_measure") if isinstance(expected_change, dict) else None
+    if isinstance(measure, dict) and measure.get("metric"):
+        parts.append("progress measure %s %s -> %s" % (str(measure.get("metric")).replace("_", " "), measure.get("before"), measure.get("expected_after")))
+    return "; ".join(parts) if parts else "no exact prediction"
+
+
+def note_lines(note: dict[str, Any]) -> list[str]:
+    family = str(note.get("family") or "a built-in solver")
+    steps = int(note.get("steps") or 0)
+    held = max(0, steps - 1)
+    model = str(note.get("transition") or "its own model of the level").replace("_", " ")
+    goal = str(note.get("goal") or "").replace("_", " ")
+    last = str(note.get("last_action") or "its last action")
+    violation = str(note.get("violation") or "")
+    verifier = str(note.get("verifier") or "").replace("_", " ")
+    lines = [
+        "The solver stopped there. The harness's built-in solver %s had modelled this level as: %s%s." % (family, model, (" (goal: %s)" % goal) if goal else ""),
+    ]
+    if note.get("invariants"):
+        lines.append("It assumed: " + "; ".join(str(x) for x in note["invariants"]) + ".")
+    if note.get("falsifiers"):
+        lines.append("It counts itself falsified when: " + "; ".join(str(x) for x in note["falsifiers"]) + ".")
+    if violation == "mechanic_progress_mismatch":
+        why = "the frame that followed matched its prediction, but its own progress measure did not advance as it claimed"
+    elif violation in ("plan_did_not_shrink", "certificate_lost_after_action"):
+        why = "it could not re-plan from the frame that followed (%s)" % violation.replace("_", " ")
+    else:
+        why = "the harness's verifier rejected the frame that followed (%s)" % (verifier or violation.replace("_", " ") or "mismatch")
+    lines.append("That model held for %d verified action%s and broke at the last one, %s: it expected %s, and %s." % (
+        held, "" if held == 1 else "s", last, str(note.get("prediction") or "no exact prediction"), why))
+    changes = [str(x) for x in (note.get("changes") or []) if str(x).strip()]
+    if changes:
+        lines.append("What %s changed: %s." % (last, "; ".join(changes)))
+    lines.append("Treat the solver's model as a hypothesis that held for those steps and failed at this action: before continuing, "
+                 "work out what it missed - what this action did that it did not predict - and keep the part that held.")
+    return lines
+
+
+PLAN_SHOWN = 12
+
+
+def note_lines_v5(note: dict[str, Any]) -> list[str]:
+    """v5 wording. The first sentence stays "The solver stopped there." (the judge counts openers by it)."""
+    family = str(note.get("family") or "a built-in solver")
+    steps = int(note.get("steps") or 0)
+    held = max(0, steps - 1)
+    model = str(note.get("transition") or "its own model of the level").replace("_", " ")
+    last = str(note.get("last_action") or "its last action")
+    violation = str(note.get("violation") or "")
+    verifier = str(note.get("verifier") or "")
+    prediction = [p for p in str(note.get("prediction") or "").split("; ")
+                  if p and not p.startswith("progress measure") and not p.startswith("no exact prediction")]
+    unsupported = "unsupported" in verifier or "no exact prediction" in str(note.get("prediction") or "")
+    reason = re.search(r"no exact prediction \(([^)]*)\)", str(note.get("prediction") or ""))
+    lines = ["The solver stopped there. The harness's built-in solver %s had modelled this level as: %s." % (family, model)]
+    if note.get("invariants"):
+        lines.append("It assumed: " + "; ".join(str(x) for x in note["invariants"]) + ".")
+    lines.append("That model held for %d verified action%s before %s." % (held, "" if held == 1 else "s", last))
+    if violation == "mechanic_progress_mismatch":
+        lines.append("%s produced the frame the solver predicted, but its own progress measure did not advance as it claimed, "
+                     "so the harness stopped it." % last)
+    elif violation in ("plan_did_not_shrink", "certificate_lost_after_action"):
+        lines.append("After %s the solver could not re-plan from the frame that followed, so the harness stopped it." % last)
+    elif unsupported:
+        lines.append("For %s the solver had no exact prediction%s, so the harness could not check the frame that followed and "
+                     "stopped it there. That is not evidence that %s failed." % (last, (" (%s)" % reason.group(1)) if reason else "", last))
+    else:
+        lines.append("%s produced a frame that differed from the solver's prediction%s, so the harness stopped it there." % (
+            last, (" (it expected %s)" % "; ".join(prediction)) if prediction else ""))
+    changes = [str(x) for x in (note.get("changes") or []) if str(x).strip()]
+    if changes:
+        lines.append("%s took effect; what it changed: %s. The level is not complete." % (last, "; ".join(changes)))
+    else:
+        lines.append("%s changed nothing visible. The level is not complete." % last)
+    plan = [str(x) for x in (note.get("remaining_plan") or []) if str(x).strip()]
+    if plan:
+        shown = ", ".join(plan[:PLAN_SHOWN]) + (", ... (%d in all)" % len(plan) if len(plan) > PLAN_SHOWN else "")
+        lines.append("Before %s, the solver's plan had %d more action%s: %s. That plan follows the model above and is unverified "
+                     "past %s." % (last, len(plan), "" if len(plan) == 1 else "s", shown, last))
+    if repair_enabled():
+        lines.extend(repair_lines(last))
+    else:
+        lines.append("Use what %s did as evidence about the game: keep the part of the solver's model that held and correct the part "
+                     "this action contradicts." % last)
+    return lines
+
+
+def endfacts_enabled() -> bool:
+    """Solver end facts (kojimatech 11-02, ECA_FRZ_SOLVER_ENDFACTS=1, default off): the host note states how each level the
+    solver completed ended (solver._solver_endfacts_enabled). Independent of the failure note."""
+    return str(os.environ.get("ECA_FRZ_SOLVER_ENDFACTS", "0") or "0").strip() == "1"
+
+
+def endfacts_lines(ended: dict) -> list[str]:
+    """The host-note lines for the levels the solver completed: per level the completing action and what its last board showed
+    (board_digest.completion_facts), then, over two or more levels that all ended with an object filled in by a shape that left
+    its place, that fact once."""
+    if not ended:
+        return []
+    out = [
+        "How each level the solver completed ended - the level's last board, which exists only inside the completing action's "
+        "animation (`history` keeps the board before that action and the next level's first board):"
+    ]
+    for lv in sorted(ended):
+        e = ended[lv]
+        out.append(f"Level {lv}, {e.get('action')}: " + "; ".join(str(x) for x in e.get("lines") or []))
+    if len(ended) >= 2 and all(e.get("filled") for e in ended.values()):
+        out.append(
+            f"All {len(ended)} ended the same way: an object filled in solid, the cells it gained having the shape of an object "
+            "that left its place (equal up to quarter turns and size)."
+        )
+    return out
+
+
+def endfacts_text_enabled() -> bool:
+    """Level-start text after a note with end facts (kojimatech 11-02, ECA_FRZ_SOLVER_ENDFACTS_TEXT=1 on top of
+    ECA_FRZ_SOLVER_ENDFACTS=1 and ECA_FRZ_SOLVER_FAILNOTE_LEVELTEXT=1, default off): the text after the note says that what
+    completed the earlier levels is in the note, from their last boards, and that `history` holds no such board, instead of
+    sending the model to the earlier levels' history for what completes a level (v6: up to 20 turns there, f11 ar25 L4)."""
+    return endfacts_enabled() and leveltext_enabled() and str(os.environ.get("ECA_FRZ_SOLVER_ENDFACTS_TEXT", "0") or "0").strip() == "1"
+
+
+def repair_enabled() -> bool:
+    """Solver repair (kojimatech 11-02, ECA_FRZ_SOLVER_REPAIR=1 on top of ECA_FRZ_SOLVER_FAILNOTE=1, default off; user 11-02
+    「v8の変形で止まったときにLLMが肩代わりするのではなく、LLMにソルバーを修整させたときの動きもみたい」): where the note asked the model
+    to keep the part of the solver's model that held and correct the rest, it asks it to repair the solver's model as code -
+    step(board, action) and goal(board), checked by verify_model against everything recorded on the level - and to let
+    find_plan / run_plan play the repaired model instead of playing the level by hand. The helpers are the FRZ-SIMPLAN ones,
+    installed in the sandbox by the same flag (tool_agent._model_check_enabled) without SIMPLAN's prompt lines."""
+    return enabled() and str(os.environ.get("ECA_FRZ_SOLVER_REPAIR", "0") or "0").strip() == "1"
+
+
+def repair_lines(last: str) -> list[str]:
+    """The note's closing request when the solver repair is on."""
+    return [
+        "Repair the solver's model rather than playing this level by hand. Write it in Python as `step(board, action) -> board` "
+        "(board is `board_of(frame)`, a tuple of the frame's `.ascii` rows; action is spelled as in `history`, e.g. "
+        "'MOUSE(row=3, col=5)'; return None where you cannot predict) that keeps what held for the solver's actions on this level "
+        "and also predicts what %s actually did, and `goal(board) -> bool` for what completes a level." % last,
+        "`rep = verify_model(step, goal, border=4)` replays step over every transition recorded on this level and returns the "
+        "first wrong cells; correct step until there are none. Then `plan = find_plan(step, goal, actions=[...], border=4)` (list "
+        "the clicks or keys to search) finds actions that make goal true in your model, and `run_plan(plan['actions'], step)` plays "
+        "them, stopping at the first frame your step did not predict; repair step from there.",
+    ]
diff --git a/ARC3-Inference/inference/framework/solver_library.py b/ARC3-Inference/inference/framework/solver_library.py
