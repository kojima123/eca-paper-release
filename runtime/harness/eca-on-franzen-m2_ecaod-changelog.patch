+class _ServerReadyProbe:
+    """Process-wide: the moment the model server first answered. One daemon thread polls GET /health beside the
+    analyzer's base URL (<host>/v1 -> <host>/health; <base_url>/models if it does not end in /v1) and takes any status
+    below 500: the notebook's server cell calls the server READY on /health 200, and on Kaggle SGLang opens its port
+    only after the weights load and answers /health 503 for the ~6-7 s until its own warmup request completes (serve.log
+    of A, the ECA demo and B). A session whose analyzer gets a response marks it too, in case the probe cannot reach the
+    endpoint. Started only under ECA_FRZ_CLOCK_AFTER_SERVER_READY or ECA_FRZ_NO_GIVEUP_BEFORE_READY."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._ready_at: float | None = None
+        self._started = False
+        self._listeners: list[Callable[[float], None]] = []
+
+    def ready_at(self) -> float | None:
+        return self._ready_at
+
+    def mark(self, source: str) -> None:
+        with self._lock:
+            if self._ready_at is not None:
+                return
+            self._ready_at = time.monotonic()
+            ready, listeners = self._ready_at, list(self._listeners)
+            self._listeners.clear()
+        # warning, not info: the notebook has no handler and logging's lastResort only prints WARNING and above
+        log.warning("clock-after-server-ready: model server ready (%s)", source)
+        for fn in listeners:
+            try:
+                fn(ready)
+            except Exception:  # noqa: BLE001
+                log.exception("clock-after-server-ready: a ready listener failed")
+
+    def on_ready(self, fn: Callable[[float], None]) -> None:
+        with self._lock:
+            if self._ready_at is None:
+                self._listeners.append(fn)
+                return
+            ready = self._ready_at
+        fn(ready)
+
+    def start(self, base_url: str, headers: dict) -> None:
+        if not base_url:
+            return
+        with self._lock:
+            if self._started or self._ready_at is not None:
+                return
+            self._started = True
+        base = str(base_url).rstrip("/")
+        url = f"{base[:-3]}/health" if base.endswith("/v1") else f"{base}/models"
+        interval = max(0.2, _env_float("ECA_FRZ_SERVER_PROBE_INTERVAL_S", 2.0))
+        started = time.monotonic()
+
+        def _poll() -> None:
+            import requests
+
+            while self._ready_at is None:
+                try:
+                    status = requests.get(url, headers=headers, timeout=(2.0, 5.0)).status_code
+                except Exception:  # noqa: BLE001  (refused while the weights load)
+                    status = None
+                if status is not None and status < 500:
+                    self.mark(f"GET {url} -> {status} after {time.monotonic() - started:.0f}s of probing")
+                    return
+                time.sleep(interval)
+
+        threading.Thread(target=_poll, name="server-ready-probe", daemon=True).start()
+
+
+_SERVER_READY = _ServerReadyProbe()
+
