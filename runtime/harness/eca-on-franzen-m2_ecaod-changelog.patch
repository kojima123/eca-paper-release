+def _persistent_constants_enabled() -> bool:
+    """Retained variables (kojimatech 10-31; same registration). ARC3_PERSISTENT_CONSTANTS=1 with
+    ARC3_PERSISTENT_FUNCTIONS=1: a snippet variable first bound by a top-level `name = <literal>` assignment is
+    carried to later calls (its value at the end of each call, while it stays a plain literal under 4000 chars),
+    with the functions' scope and clearing. Default off."""
+    return _get_env_bool("ARC3_PERSISTENT_CONSTANTS", False) and _persistent_functions()
