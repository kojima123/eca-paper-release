+def _eca_lite_pre_action_violation(
+    executed: list[str], planned_prefix: list[str]
+) -> str:
+    """Return the immediate fallback reason before recomputing a plan."""
+    if not executed:
+        return ""
+    if len(executed) != 1:
+        return "multi_action_batch"
+    if not planned_prefix or executed[0] != planned_prefix[0]:
+        return "llm_deviation"
+    return ""
