+    def actions_for(self, obs):
+        """The habit wrapper explore_within_budget(habit=True) installs."""
+        return _habit_order(self._actions_for_raw(obs), self.play["last"])
+
+    # -- the hooks the FL composition installs (heldout Context + explore_within_budget + _explore_fv) ---------------
+    def _charge_check(self) -> None:
+        if self.spent >= self.budget:
+            raise StopExplorer("budget")
+        if self._should_stop is not None and self._should_stop():
+            raise StopExplorer("stopped")
