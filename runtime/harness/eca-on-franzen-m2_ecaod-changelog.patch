+def _eca_lite_post_action_violation(
+    prior_full_len: int, continuation_full_len: int | None
+) -> str:
+    """Validate the freshly recomputed continuation after one matched step."""
+    if continuation_full_len is None:
+        return "certificate_lost_after_action"
+    if int(continuation_full_len) >= int(prior_full_len):
+        return "plan_did_not_shrink"
+    return ""
