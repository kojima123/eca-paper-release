+"""Owner-starvation guard for the certified-lease post-action check.
+
+Measured 2026-09-04 (Flash-Next + ECA, three Kaggle runs): every
+`certificate_lost_after_action` kill happened on a frame where the OWNING
+family was never evaluated -- the all-family rescan exhausted the toolbox
+budget on slower families first (`budget_exceeded`), or the owner's join
+timed out (`family_timeout`), or no worker slot was free. The solver then read
+"no continuation" as "certificate refuted" and revoked the family for the
+whole level, handing the game to the LLM for good (tr87 1 vs 6, cd82 6->3,
+sb26 8->1 depending on which frame rolled the dice).
+
+"Not evaluated" is not "refuted". When armed, the solver re-evaluates the
+owner ALONE once (a one-family call, ~0.3-1.3 s) before judging the
+continuation. A genuine refutation (owner evaluated, no plan / grounded
+mismatch) still revokes exactly as before.
+
+Gate: TUFA_OWNER_RETRY_ON_STARVATION=1. Default OFF -> the shipped path is
+byte-identical.
+"""
+from __future__ import annotations
+
+import os
+from typing import Any, Mapping
+
+STARVATION_REASONS = frozenset(
+    {"budget_exceeded", "family_timeout", "round_robin_deferred"}
+)
+
+
+def owner_retry_enabled(environ: Mapping[str, str] | None = None) -> bool:
+    env = os.environ if environ is None else environ
+    return str(env.get("TUFA_OWNER_RETRY_ON_STARVATION", "0")).strip() == "1"
+
+
+def owner_skip_reason(raw_plans: Mapping[str, Any] | None, family: str) -> str:
+    """Return the starvation reason the toolbox recorded for `family`, or ''.
+
+    Only time/capacity skips count. `suppressed_after_game_over` and
+    `not_allowlisted` are deliberate exclusions, never retried.
+    """
+    if not isinstance(raw_plans, Mapping):
+        return ""
+    for entry in raw_plans.get("skipped", []) or []:
+        if not isinstance(entry, Mapping):
+            continue
+        if str(entry.get("family", "")) != str(family):
+            continue
+        reason = str(entry.get("reason", "") or "")
+        if reason in STARVATION_REASONS:
+            return reason
+    return ""
+
+
+def pick_family_plan(plans_result: Mapping[str, Any] | None, family: str) -> dict | None:
+    if not isinstance(plans_result, Mapping):
+        return None
+    for plan in plans_result.get("plans", []) or []:
+        if isinstance(plan, dict) and str(plan.get("family")) == str(family):
+            return plan
+    return None
+
+
+def retry_starved_owner(
+    raw_plans: dict[str, Any],
+    family: str,
+    compute_for,
+) -> dict | None:
+    """If the owner was starved on this frame, evaluate it alone once.
+
+    `compute_for(families)` is the solver's existing one-family toolbox call.
+    Records the attempt under raw_plans["owner_retry"] for telemetry and
+    returns the owner's plan (or None when it genuinely has none).
+    """
+    reason = owner_skip_reason(raw_plans, family)
+    if not reason:
+        return None
+    retry = compute_for([family])
+    plan = pick_family_plan(retry, family)
+    raw_plans["owner_retry"] = {
+        "family": str(family),
+        "skip_reason": reason,
+        "recovered": plan is not None,
+        "certified": bool(plan.get("certified")) if isinstance(plan, dict) else False,
+        "retry_elapsed_ms": (retry or {}).get("elapsed_ms") if isinstance(retry, Mapping) else None,
+        "retry_skipped": [
+            e.get("reason") for e in ((retry or {}).get("skipped", []) if isinstance(retry, Mapping) else [])
+            if isinstance(e, Mapping) and str(e.get("family")) == str(family)
+        ],
+    }
+    if plan is not None:
+        # merge so downstream readers (telemetry, arbitration views) see the owner
+        raw_plans.setdefault("plans", []).append(plan)
+        elapsed = (retry or {}).get("family_elapsed_ms") if isinstance(retry, Mapping) else None
+        if isinstance(elapsed, Mapping) and family in elapsed:
+            raw_plans.setdefault("family_elapsed_ms", {})[family] = elapsed[family]
+    return plan
