+            hit, gerr = _mc_call(goal, after)
+            if gerr is None and hit:
+                g["goal_true_without_level_up"] += 1
+                if len(goal_examples) < show:
+                    goal_examples.append({"transition": index, "action": action,
+                                          "issue": "goal() is true on the recorded board after this action, but the "
+                                                   "level did not complete"})
