+        out.append(LEVELUP_FACTS_HEADER)
+        out.extend(facts)
+    if stats is not None:
+        stats["handoff_openers"] = stats.get("handoff_openers", 0) + 1
+        stats["facts_lines"] = stats.get("facts_lines", 0) + len(facts)
